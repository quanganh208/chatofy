{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Relative extends (not "@chatofy/config/...") on purpose: vitest's vite:oxc
  // transform cannot resolve package-name extends and fails with TSCONFIG_ERROR.
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Built by tsup, consumed via dist; not referenced as a TS project.
    "composite": false,
    "incremental": false,
    // DOM gives fetch/AbortController types for COMPILATION only — the public
    // API surface exposes local types (ApiRequestOptions), never DOM RequestInit,
    // so the emitted .d.ts stays resolvable from React Native's bundler.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
