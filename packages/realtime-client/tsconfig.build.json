{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // tsup's .d.ts build cannot run under composite/incremental
    // project-reference mode. tsconfig.json stays composite so consumers can
    // reference this project; tsup uses this variant.
    "composite": false,
    "incremental": false
  },
  // Specs and test doubles are typechecked (tsconfig.json includes all of src)
  // but must not reach `dist`: `fake-audio-context.ts` would otherwise ship a
  // second `TranslateSocket` implementation to every consumer.
  "exclude": ["src/**/*.spec.ts", "src/conversation/fake-audio-context.ts"]
}
