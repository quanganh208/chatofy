{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // tsup's declaration build cannot run under composite/incremental
    // project-reference mode; `tsconfig.json` stays composite so consumers can
    // reference this project. Same split as `packages/types`.
    "composite": false,
    "incremental": false
  },
  "include": ["src"]
}
