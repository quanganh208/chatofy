{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Relative extends (not "@chatofy/config/...") on purpose: vitest's vite:oxc
  // transform cannot resolve package-name extends and fails with TSCONFIG_ERROR.
  // Same reason and same fix as @chatofy/api-client.
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Built by tsup, consumed via dist; not referenced as a TS project (mirrors
    // @chatofy/api-client). Plain `tsc --noEmit` typechecks against the built
    // @chatofy/types .d.ts, so no project reference / build-mode emit is needed.
    "composite": false,
    "incremental": false
  },
  "include": ["src"]
}
