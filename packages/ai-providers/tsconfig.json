{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Extended by relative path, not as `@chatofy/config/tsconfig/library.json`,
  // for the reason already written down in `packages/realtime-client` and
  // `apps/web`: that preset's own `extends` is relative, and a resolver that
  // maps the package export first computes the link from the consumer's
  // directory and misses the repo root. `tsc` copes either way; Vitest's
  // transform does not, and fails every spec with "Tsconfig not found". This
  // package now has specs, so it now follows the relative form like the rest.
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Built by tsup, consumed via dist; not referenced as a TS project (mirrors
    // @chatofy/api-client). Plain `tsc --noEmit` typechecks against the built
    // @chatofy/types .d.ts, so no project reference / build-mode emit is needed.
    "composite": false,
    "incremental": false
  },
  "include": ["src"]
}
