{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // tsup's .d.ts build cannot run under composite/incremental project-reference
    // mode. tsconfig.json stays composite; tsup uses this variant.
    "composite": false,
    "incremental": false,
    "noEmit": false
  },
  "include": ["src"]
}
