{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "lint-staged": {
        "config": [".lintstagedrc.json"]
      }
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/**/*.spec.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["swagger-ui-express", "@chatofy/config"]
    },
    "apps/web": {
      "paths": { "@/*": ["src/*"] },
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.{ts,mjs,cjs}"],
      "entry": ["src/**/*.spec.ts"],
      "ignoreDependencies": ["@chatofy/config"]
    },
    "apps/extension": {
      // WXT discovers entrypoints by directory convention, which knip does not know
      // about: every file under `entrypoints/` is loaded by the browser, never
      // imported by anything in the source tree.
      // `wxt.config.ts` is left out: knip's own wxt plugin already finds it, and
      // naming it here is reported as redundant.
      "entry": ["entrypoints/**/*.{ts,html}", "scripts/*.mjs"],
      "project": ["entrypoints/**/*.ts", "src/**/*.ts", "*.{ts,mjs}", "scripts/*.mjs"]
    },
    "apps/mobile": {
      "entry": ["babel.config.js"],
      "paths": { "@/*": ["src/*"] },
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.{ts,tsx,js,cjs}"],
      "ignore": ["src/audio/audio-player.interface.ts", "src/audio/audio-recorder.interface.ts"],
      "ignoreDependencies": ["expo-updates"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"],
      // `@chatofy/config` is used, but through a relative `extends` in
      // `tsconfig.json` rather than by package name — see the note there for why
      // the specifier form had to go. knip reads specifiers, so the edge is
      // invisible to it. `packages/api-client` carries the same entry for the
      // same reason.
      "ignoreDependencies": ["@chatofy/config"]
    },
    "packages/realtime-client": {
      // Specs only. `src/index.ts` is already inferred from the package's
      // `exports` map, and naming it here is reported as a redundant pattern.
      // The specs are not inferable and are entry points in their own right, as
      // in apps/api: the doubles in `conversation/fake-audio-context.ts` are
      // reachable only from `conversation-session.spec.ts`, so without this both
      // read as dead files.
      "entry": ["src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@chatofy/config"]
    },
    "packages/ai-providers": {
      "project": ["src/**/*.ts"],
      // Used through a relative `extends` in `tsconfig.json` rather than by
      // package name, exactly as `packages/types` records — knip reads
      // specifiers, so the edge is invisible to it.
      "ignoreDependencies": ["@chatofy/config"]
    },
    "packages/config": {
      "entry": ["eslint/*.cjs"],
      "project": ["**/*.cjs"],
      "ignoreDependencies": ["next", "eslint-config-expo", "eslint-config-next"]
    },
    "packages/i18n": {
      // `@chatofy/config` reaches this package through a relative `extends` in
      // `tsconfig.json`, the same invisible edge `packages/types` records.
      "ignoreDependencies": ["@chatofy/config"]
    },
    "packages/ui": {
      // Specs are entry points in their own right; `src/index.ts` and
      // `src/react/index.ts` are already inferred from the `exports` map.
      "entry": ["src/**/*.spec.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
