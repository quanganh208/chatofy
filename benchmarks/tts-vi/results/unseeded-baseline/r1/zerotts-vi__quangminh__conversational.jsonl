{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.3671, "rtf": 0.743, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.1519, "ttfa_whole_s": 1.3671, "ttfa_clause_split_s": 1.4159, "stream_ttfa_s": 0.1267, "stream_total_s": 1.6244, "stream_chunks": 5, "stream_underrun_margin_s": 0.4014, "stream_audio_s": 1.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.9311, "rtf": 0.8046, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1609, "ttfa_whole_s": 1.9311, "ttfa_clause_split_s": 1.7895, "stream_ttfa_s": 0.1303, "stream_total_s": 2.2038, "stream_chunks": 5, "stream_underrun_margin_s": 0.8726, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.7656, "rtf": 0.7357, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1471, "ttfa_whole_s": 1.7656, "ttfa_clause_split_s": 0.5222, "stream_ttfa_s": 0.1566, "stream_total_s": 2.0975, "stream_chunks": 5, "stream_underrun_margin_s": 0.74, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.07, "rtf": 0.7841, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1592, "ttfa_whole_s": 2.07, "ttfa_clause_split_s": 0.7567, "stream_ttfa_s": 0.1438, "stream_total_s": 2.2862, "stream_chunks": 6, "stream_underrun_margin_s": 0.7659, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.9422, "rtf": 0.8093, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1766, "ttfa_whole_s": 1.9422, "ttfa_clause_split_s": 0.8299, "stream_ttfa_s": 0.1381, "stream_total_s": 2.1927, "stream_chunks": 5, "stream_underrun_margin_s": 0.8536, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.1456, "rtf": 0.7663, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1533, "ttfa_whole_s": 2.1456, "ttfa_clause_split_s": 1.1274, "stream_ttfa_s": 0.1215, "stream_total_s": 2.5021, "stream_chunks": 6, "stream_underrun_margin_s": 0.8244, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 1.847, "rtf": 0.8245, "audio_s_per_word": 0.224, "latency_s_per_word": 0.1847, "ttfa_whole_s": 1.847, "ttfa_clause_split_s": 1.0265, "stream_ttfa_s": 0.1614, "stream_total_s": 2.0065, "stream_chunks": 5, "stream_underrun_margin_s": 0.6443, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.9281, "rtf": 0.8034, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1753, "ttfa_whole_s": 1.9281, "ttfa_clause_split_s": 0.7608, "stream_ttfa_s": 0.137, "stream_total_s": 2.1579, "stream_chunks": 5, "stream_underrun_margin_s": 0.8201, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.357, "rtf": 0.7963, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1684, "ttfa_whole_s": 2.357, "ttfa_clause_split_s": 0.9475, "stream_ttfa_s": 0.1395, "stream_total_s": 2.5533, "stream_chunks": 6, "stream_underrun_margin_s": 0.7967, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.1198, "rtf": 0.7793, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1631, "ttfa_whole_s": 2.1198, "ttfa_clause_split_s": 2.092, "stream_ttfa_s": 0.1335, "stream_total_s": 2.4446, "stream_chunks": 6, "stream_underrun_margin_s": 0.9048, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.0543, "rtf": 0.7781, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.158, "ttfa_whole_s": 2.0543, "ttfa_clause_split_s": 1.0477, "stream_ttfa_s": 0.1273, "stream_total_s": 2.3822, "stream_chunks": 6, "stream_underrun_margin_s": 0.8829, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.0865, "rtf": 0.7452, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1605, "ttfa_whole_s": 2.0865, "ttfa_clause_split_s": 2.1616, "stream_ttfa_s": 0.1507, "stream_total_s": 2.3578, "stream_chunks": 6, "stream_underrun_margin_s": 0.7218, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.1202, "rtf": 0.7795, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1514, "ttfa_whole_s": 2.1202, "ttfa_clause_split_s": 1.4833, "stream_ttfa_s": 0.1313, "stream_total_s": 2.3568, "stream_chunks": 6, "stream_underrun_margin_s": 0.8172, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.7008, "rtf": 0.7874, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.1546, "ttfa_whole_s": 1.7008, "ttfa_clause_split_s": 1.6839, "stream_ttfa_s": 0.1396, "stream_total_s": 1.9084, "stream_chunks": 5, "stream_underrun_margin_s": 0.568, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.104, "rtf": 0.797, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1753, "ttfa_whole_s": 2.104, "ttfa_clause_split_s": 0.8586, "stream_ttfa_s": 0.1388, "stream_total_s": 2.2829, "stream_chunks": 6, "stream_underrun_margin_s": 0.7681, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.3537, "rtf": 0.7952, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.1811, "ttfa_whole_s": 2.3537, "ttfa_clause_split_s": 0.7775, "stream_ttfa_s": 0.1522, "stream_total_s": 2.6082, "stream_chunks": 6, "stream_underrun_margin_s": 0.8531, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 3.0544, "rtf": 0.7954, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.1454, "ttfa_whole_s": 3.0544, "ttfa_clause_split_s": 0.9573, "stream_ttfa_s": 0.1458, "stream_total_s": 3.3294, "stream_chunks": 7, "stream_underrun_margin_s": 0.8149, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 3.1795, "rtf": 0.7793, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1514, "ttfa_whole_s": 3.1795, "ttfa_clause_split_s": 0.7564, "stream_ttfa_s": 0.1499, "stream_total_s": 3.6441, "stream_chunks": 7, "stream_underrun_margin_s": 0.983, "stream_audio_s": 4.08}
