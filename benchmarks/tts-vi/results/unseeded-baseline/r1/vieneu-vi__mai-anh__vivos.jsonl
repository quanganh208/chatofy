{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 1.3973, "rtf": 0.4062, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.0998, "ttfa_whole_s": 1.3973, "ttfa_clause_split_s": 1.8211}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.5362, "rtf": 0.6194, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.1397, "ttfa_whole_s": 1.5362, "ttfa_clause_split_s": 1.3663}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.5806, "rtf": 0.4704, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1129, "ttfa_whole_s": 1.5806, "ttfa_clause_split_s": 1.7541}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.4037, "rtf": 0.5013, "audio_s_per_word": 0.2545, "latency_s_per_word": 0.1276, "ttfa_whole_s": 1.4037, "ttfa_clause_split_s": 1.295}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.5133, "rtf": 0.5732, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1376, "ttfa_whole_s": 1.5133, "ttfa_clause_split_s": 1.4954}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.2464, "rtf": 0.4869, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1133, "ttfa_whole_s": 1.2464, "ttfa_clause_split_s": 1.0518}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_099", "text": "Chị tìm nhà cho em ở trọ ngay cổng trường chị học", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.88, "proc_s": 1.8881, "rtf": 0.6556, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1573, "ttfa_whole_s": 1.8881, "ttfa_clause_split_s": 1.5554}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 3.2, "proc_s": 1.3939, "rtf": 0.4356, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1162, "ttfa_whole_s": 1.3939, "ttfa_clause_split_s": 1.8102}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.76, "proc_s": 2.1655, "rtf": 0.5759, "audio_s_per_word": 0.2686, "latency_s_per_word": 0.1547, "ttfa_whole_s": 2.1655, "ttfa_clause_split_s": 1.7856}
