{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.12, "proc_s": 1.3864, "rtf": 0.4443, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.099, "ttfa_whole_s": 1.3864, "ttfa_clause_split_s": 1.8274}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.352, "rtf": 0.5121, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1229, "ttfa_whole_s": 1.352, "ttfa_clause_split_s": 1.4754}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.12, "proc_s": 1.3765, "rtf": 0.4412, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.0983, "ttfa_whole_s": 1.3765, "ttfa_clause_split_s": 1.6774}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.1956, "rtf": 0.4821, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.1087, "ttfa_whole_s": 1.1956, "ttfa_clause_split_s": 1.1288}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.1951, "rtf": 0.498, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1086, "ttfa_whole_s": 1.1951, "ttfa_clause_split_s": 1.2711}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.1, "rtf": 0.4911, "audio_s_per_word": 0.2036, "latency_s_per_word": 0.1, "ttfa_whole_s": 1.1, "ttfa_clause_split_s": 1.3887}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_099", "text": "Chị tìm nhà cho em ở trọ ngay cổng trường chị học", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 3.28, "proc_s": 1.381, "rtf": 0.421, "audio_s_per_word": 0.2733, "latency_s_per_word": 0.1151, "ttfa_whole_s": 1.381, "ttfa_clause_split_s": 1.6083}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.232, "rtf": 0.4813, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.1027, "ttfa_whole_s": 1.232, "ttfa_clause_split_s": 1.4333}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 1.6626, "rtf": 0.5196, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1188, "ttfa_whole_s": 1.6626, "ttfa_clause_split_s": 1.7105}
