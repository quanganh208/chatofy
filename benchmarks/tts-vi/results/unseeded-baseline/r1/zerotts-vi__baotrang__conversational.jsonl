{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.1272, "rtf": 0.8863, "audio_s_per_word": 0.24, "latency_s_per_word": 0.2127, "ttfa_whole_s": 2.1272, "ttfa_clause_split_s": 1.064, "stream_ttfa_s": 0.1404, "stream_total_s": 2.0423, "stream_chunks": 5, "stream_underrun_margin_s": 0.7012, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.2087, "rtf": 0.812, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.2008, "ttfa_whole_s": 2.2087, "ttfa_clause_split_s": 0.6924, "stream_ttfa_s": 0.1437, "stream_total_s": 2.3454, "stream_chunks": 6, "stream_underrun_margin_s": 0.7882, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.5324, "rtf": 0.8117, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1809, "ttfa_whole_s": 2.5324, "ttfa_clause_split_s": 0.9434, "stream_ttfa_s": 0.1378, "stream_total_s": 2.6695, "stream_chunks": 6, "stream_underrun_margin_s": 0.7249, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 2.1062, "rtf": 0.8228, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.162, "ttfa_whole_s": 2.1062, "ttfa_clause_split_s": 1.9848, "stream_ttfa_s": 0.1267, "stream_total_s": 2.3175, "stream_chunks": 6, "stream_underrun_margin_s": 0.8638, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.1513, "rtf": 0.747, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1655, "ttfa_whole_s": 2.1513, "ttfa_clause_split_s": 1.1439, "stream_ttfa_s": 0.1409, "stream_total_s": 2.5995, "stream_chunks": 6, "stream_underrun_margin_s": 0.909, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.1053, "rtf": 0.7519, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1619, "ttfa_whole_s": 2.1053, "ttfa_clause_split_s": 2.1598, "stream_ttfa_s": 0.1413, "stream_total_s": 2.3675, "stream_chunks": 6, "stream_underrun_margin_s": 0.7665, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.957, "rtf": 0.6989, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1398, "ttfa_whole_s": 1.957, "ttfa_clause_split_s": 1.5258, "stream_ttfa_s": 0.1293, "stream_total_s": 2.3063, "stream_chunks": 6, "stream_underrun_margin_s": 0.7075, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.7967, "rtf": 0.7745, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1633, "ttfa_whole_s": 1.7967, "ttfa_clause_split_s": 1.8625, "stream_ttfa_s": 0.1326, "stream_total_s": 2.0154, "stream_chunks": 5, "stream_underrun_margin_s": 0.6818, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.183, "rtf": 0.7796, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1819, "ttfa_whole_s": 2.183, "ttfa_clause_split_s": 0.9279, "stream_ttfa_s": 0.1471, "stream_total_s": 2.4652, "stream_chunks": 6, "stream_underrun_margin_s": 0.8, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.3109, "rtf": 0.8024, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1778, "ttfa_whole_s": 2.3109, "ttfa_clause_split_s": 0.804, "stream_ttfa_s": 0.1459, "stream_total_s": 2.4492, "stream_chunks": 6, "stream_underrun_margin_s": 0.7545, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.92, "proc_s": 3.2569, "rtf": 0.8308, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1551, "ttfa_whole_s": 3.2569, "ttfa_clause_split_s": 0.9026, "stream_ttfa_s": 0.1584, "stream_total_s": 3.3654, "stream_chunks": 7, "stream_underrun_margin_s": 0.7958, "stream_audio_s": 3.92}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.4, "proc_s": 3.3327, "rtf": 0.7574, "audio_s_per_word": 0.2095, "latency_s_per_word": 0.1587, "ttfa_whole_s": 3.3327, "ttfa_clause_split_s": 0.876, "stream_ttfa_s": 0.1687, "stream_total_s": 3.7764, "stream_chunks": 7, "stream_underrun_margin_s": 0.8344, "stream_audio_s": 4.4}
