{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.0652, "rtf": 0.7592, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1721, "ttfa_whole_s": 2.0652, "ttfa_clause_split_s": 0.7003, "stream_ttfa_s": 0.1511, "stream_total_s": 2.4805, "stream_chunks": 6, "stream_underrun_margin_s": 0.9249, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.205, "rtf": 0.7875, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1696, "ttfa_whole_s": 2.205, "ttfa_clause_split_s": 0.812, "stream_ttfa_s": 0.14, "stream_total_s": 2.5663, "stream_chunks": 6, "stream_underrun_margin_s": 0.9389, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.9322, "rtf": 0.7319, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1757, "ttfa_whole_s": 1.9322, "ttfa_clause_split_s": 0.9687, "stream_ttfa_s": 0.1383, "stream_total_s": 2.3659, "stream_chunks": 6, "stream_underrun_margin_s": 0.8609, "stream_audio_s": 2.64}
