{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 1.4743, "rtf": 0.6825, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1638, "ttfa_whole_s": 1.4743, "ttfa_clause_split_s": 0.6485}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.6, "proc_s": 1.0892, "rtf": 0.6807, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1361, "ttfa_whole_s": 1.0892, "ttfa_clause_split_s": 1.7157}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.44, "proc_s": 0.8375, "rtf": 0.5816, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1396, "ttfa_whole_s": 0.8375, "ttfa_clause_split_s": 1.2462}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.9922, "rtf": 0.5906, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1654, "ttfa_whole_s": 0.9922, "ttfa_clause_split_s": 0.7529}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 1.4688, "rtf": 0.8743, "audio_s_per_word": 0.28, "latency_s_per_word": 0.2448, "ttfa_whole_s": 1.4688, "ttfa_clause_split_s": 1.1086}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.3434, "rtf": 0.7301, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.1493, "ttfa_whole_s": 1.3434, "ttfa_clause_split_s": 1.6984}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.6127, "rtf": 0.5929, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1344, "ttfa_whole_s": 1.6127, "ttfa_clause_split_s": 1.6399}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.9788, "rtf": 0.6871, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1649, "ttfa_whole_s": 1.9788, "ttfa_clause_split_s": 0.5876}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.6524, "rtf": 0.5737, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1271, "ttfa_whole_s": 1.6524, "ttfa_clause_split_s": 0.6963}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.5935, "rtf": 0.6425, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.1449, "ttfa_whole_s": 1.5935, "ttfa_clause_split_s": 1.1735}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.5379, "rtf": 0.5196, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1099, "ttfa_whole_s": 1.5379, "ttfa_clause_split_s": 0.6644}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.32, "proc_s": 1.2019, "rtf": 0.5181, "audio_s_per_word": 0.232, "latency_s_per_word": 0.1202, "ttfa_whole_s": 1.2019, "ttfa_clause_split_s": 0.8639}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.4646, "rtf": 0.5385, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1331, "ttfa_whole_s": 1.4646, "ttfa_clause_split_s": 0.3642}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.6755, "rtf": 0.5818, "audio_s_per_word": 0.2057, "latency_s_per_word": 0.1197, "ttfa_whole_s": 1.6755, "ttfa_clause_split_s": 0.6738}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.8472, "rtf": 0.5498, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1421, "ttfa_whole_s": 1.8472, "ttfa_clause_split_s": 1.3626}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.8765, "rtf": 0.6339, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.1443, "ttfa_whole_s": 1.8765, "ttfa_clause_split_s": 0.8624}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.4705, "rtf": 0.5252, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1131, "ttfa_whole_s": 1.4705, "ttfa_clause_split_s": 1.3798}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.6162, "rtf": 0.546, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1154, "ttfa_whole_s": 1.6162, "ttfa_clause_split_s": 1.5371}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.0764, "rtf": 0.4485, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.0979, "ttfa_whole_s": 1.0764, "ttfa_clause_split_s": 1.1434}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.66, "rtf": 0.5929, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1383, "ttfa_whole_s": 1.66, "ttfa_clause_split_s": 0.6172}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.4659, "rtf": 0.5389, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1128, "ttfa_whole_s": 1.4659, "ttfa_clause_split_s": 0.3955}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 2.73, "rtf": 0.7109, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.13, "ttfa_whole_s": 2.73, "ttfa_clause_split_s": 0.667}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.56, "proc_s": 3.0097, "rtf": 0.66, "audio_s_per_word": 0.2171, "latency_s_per_word": 0.1433, "ttfa_whole_s": 3.0097, "ttfa_clause_split_s": 0.9087}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.24, "proc_s": 2.6963, "rtf": 0.6359, "audio_s_per_word": 0.2232, "latency_s_per_word": 0.1419, "ttfa_whole_s": 2.6963, "ttfa_clause_split_s": 1.3417}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 3.012, "rtf": 0.7382, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1434, "ttfa_whole_s": 3.012, "ttfa_clause_split_s": 0.9473}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-031", "text": "Xin lỗi đã làm phiền anh vào giờ này, nhưng điều hòa trong phòng tôi đã hỏng từ chiều.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.08, "proc_s": 2.5927, "rtf": 0.6355, "audio_s_per_word": 0.2147, "latency_s_per_word": 0.1365, "ttfa_whole_s": 2.5927, "ttfa_clause_split_s": 1.6697}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-032", "text": "Chúng tôi có bốn người lớn và hai trẻ nhỏ, nên xin một bàn ở khu vực yên tĩnh hơn.", "tags": ["long"], "n_words": 20, "n_clauses": 2, "audio_s": 4.48, "proc_s": 2.0988, "rtf": 0.4685, "audio_s_per_word": 0.224, "latency_s_per_word": 0.1049, "ttfa_whole_s": 2.0988, "ttfa_clause_split_s": 1.5397}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-033", "text": "Cho tôi hỏi mật khẩu wifi ở đây là gì ạ?", "tags": ["short", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 3.04, "proc_s": 2.0346, "rtf": 0.6693, "audio_s_per_word": 0.2764, "latency_s_per_word": 0.185, "ttfa_whole_s": 2.0346, "ttfa_clause_split_s": 1.4842}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-034", "text": "Tôi muốn check-in sớm, có được không ạ?", "tags": ["short", "code-switch"], "n_words": 8, "n_clauses": 2, "audio_s": 2.24, "proc_s": 1.4629, "rtf": 0.6531, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1829, "ttfa_whole_s": 1.4629, "ttfa_clause_split_s": 1.071}
