{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 1.4325, "rtf": 0.9424, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.2388, "ttfa_whole_s": 1.4325, "ttfa_clause_split_s": 1.0275}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.6, "proc_s": 1.137, "rtf": 0.7106, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1895, "ttfa_whole_s": 1.137, "ttfa_clause_split_s": 0.9217}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.6766, "rtf": 0.7485, "audio_s_per_word": 0.2489, "latency_s_per_word": 0.1863, "ttfa_whole_s": 1.6766, "ttfa_clause_split_s": 1.9872}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 3.04, "proc_s": 8.4585, "rtf": 2.7824, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.7049, "ttfa_whole_s": 8.4585, "ttfa_clause_split_s": 3.8558}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.0894, "rtf": 0.7914, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1741, "ttfa_whole_s": 2.0894, "ttfa_clause_split_s": 0.6051}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.8446, "rtf": 0.5764, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1419, "ttfa_whole_s": 1.8446, "ttfa_clause_split_s": 0.6223}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.8188, "rtf": 0.6315, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1653, "ttfa_whole_s": 1.8188, "ttfa_clause_split_s": 0.94}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.28, "proc_s": 1.8278, "rtf": 0.5573, "audio_s_per_word": 0.2343, "latency_s_per_word": 0.1306, "ttfa_whole_s": 1.8278, "ttfa_clause_split_s": 1.17}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.8386, "rtf": 0.676, "audio_s_per_word": 0.272, "latency_s_per_word": 0.1839, "ttfa_whole_s": 1.8386, "ttfa_clause_split_s": 0.9303}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.9415, "rtf": 0.6559, "audio_s_per_word": 0.2691, "latency_s_per_word": 0.1765, "ttfa_whole_s": 1.9415, "ttfa_clause_split_s": 0.3863}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.52, "proc_s": 2.6502, "rtf": 0.7529, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.1893, "ttfa_whole_s": 2.6502, "ttfa_clause_split_s": 0.8277}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.28, "proc_s": 1.7736, "rtf": 0.5407, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.1364, "ttfa_whole_s": 1.7736, "ttfa_clause_split_s": 2.211}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.7193, "rtf": 0.5373, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1323, "ttfa_whole_s": 1.7193, "ttfa_clause_split_s": 0.9634}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.8962, "rtf": 0.6772, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1459, "ttfa_whole_s": 1.8962, "ttfa_clause_split_s": 2.0447}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.44, "proc_s": 1.8741, "rtf": 0.5448, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.1339, "ttfa_whole_s": 1.8741, "ttfa_clause_split_s": 1.7208}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.568, "rtf": 0.5158, "audio_s_per_word": 0.2764, "latency_s_per_word": 0.1425, "ttfa_whole_s": 1.568, "ttfa_clause_split_s": 1.8634}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.1141, "rtf": 0.7142, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.1762, "ttfa_whole_s": 2.1141, "ttfa_clause_split_s": 1.0159}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.7953, "rtf": 0.561, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1381, "ttfa_whole_s": 1.7953, "ttfa_clause_split_s": 0.9273}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.04, "proc_s": 3.4969, "rtf": 0.6938, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1665, "ttfa_whole_s": 3.4969, "ttfa_clause_split_s": 0.7668}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.52, "proc_s": 3.838, "rtf": 0.6953, "audio_s_per_word": 0.2629, "latency_s_per_word": 0.1828, "ttfa_whole_s": 3.838, "ttfa_clause_split_s": 0.9654}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.72, "proc_s": 3.4344, "rtf": 0.7276, "audio_s_per_word": 0.2484, "latency_s_per_word": 0.1808, "ttfa_whole_s": 3.4344, "ttfa_clause_split_s": 1.2561}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.12, "proc_s": 3.4193, "rtf": 0.6678, "audio_s_per_word": 0.2438, "latency_s_per_word": 0.1628, "ttfa_whole_s": 3.4193, "ttfa_clause_split_s": 1.5642}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-031", "text": "Xin lỗi đã làm phiền anh vào giờ này, nhưng điều hòa trong phòng tôi đã hỏng từ chiều.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.32, "proc_s": 2.8429, "rtf": 0.6581, "audio_s_per_word": 0.2274, "latency_s_per_word": 0.1496, "ttfa_whole_s": 2.8429, "ttfa_clause_split_s": 1.4048}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-032", "text": "Chúng tôi có bốn người lớn và hai trẻ nhỏ, nên xin một bàn ở khu vực yên tĩnh hơn.", "tags": ["long"], "n_words": 20, "n_clauses": 2, "audio_s": 4.88, "proc_s": 3.0584, "rtf": 0.6267, "audio_s_per_word": 0.244, "latency_s_per_word": 0.1529, "ttfa_whole_s": 3.0584, "ttfa_clause_split_s": 1.6039}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-033", "text": "Cho tôi hỏi mật khẩu wifi ở đây là gì ạ?", "tags": ["short", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.4163, "rtf": 0.5207, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1288, "ttfa_whole_s": 1.4163, "ttfa_clause_split_s": 1.8852}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-034", "text": "Tôi muốn check-in sớm, có được không ạ?", "tags": ["short", "code-switch"], "n_words": 8, "n_clauses": 2, "audio_s": 2.24, "proc_s": 1.2463, "rtf": 0.5564, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1558, "ttfa_whole_s": 1.2463, "ttfa_clause_split_s": 0.7339}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-035", "text": "Khách sạn Metropole cách đây bao xa?", "tags": ["short", "code-switch"], "n_words": 7, "n_clauses": 1, "audio_s": 2.32, "proc_s": 0.9973, "rtf": 0.4299, "audio_s_per_word": 0.3314, "latency_s_per_word": 0.1425, "ttfa_whole_s": 0.9973, "ttfa_clause_split_s": 1.8135}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-036", "text": "Anh gọi giúp tôi một chiếc taxi ra sân bay nhé.", "tags": ["medium", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.1875, "rtf": 0.7813, "audio_s_per_word": 0.2545, "latency_s_per_word": 0.1989, "ttfa_whole_s": 2.1875, "ttfa_clause_split_s": 1.9036}
