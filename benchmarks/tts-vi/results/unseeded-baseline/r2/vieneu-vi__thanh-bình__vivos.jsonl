{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.96, "proc_s": 1.2761, "rtf": 0.4311, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.0912, "ttfa_whole_s": 1.2761, "ttfa_clause_split_s": 1.751}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.1208, "rtf": 0.4245, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1019, "ttfa_whole_s": 1.1208, "ttfa_clause_split_s": 1.1184}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.12, "proc_s": 1.5363, "rtf": 0.4924, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1097, "ttfa_whole_s": 1.5363, "ttfa_clause_split_s": 1.5381}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.0092, "rtf": 0.4069, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.0917, "ttfa_whole_s": 1.0092, "ttfa_clause_split_s": 1.3443}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.1726, "rtf": 0.5054, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1066, "ttfa_whole_s": 1.1726, "ttfa_clause_split_s": 1.4444}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.2514, "rtf": 0.4888, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1138, "ttfa_whole_s": 1.2514, "ttfa_clause_split_s": 1.5734}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_099", "text": "Chị tìm nhà cho em ở trọ ngay cổng trường chị học", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.1375, "rtf": 0.4587, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.0948, "ttfa_whole_s": 1.1375, "ttfa_clause_split_s": 1.9217}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.1628, "rtf": 0.4405, "audio_s_per_word": 0.22, "latency_s_per_word": 0.0969, "ttfa_whole_s": 1.1628, "ttfa_clause_split_s": 1.1358}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.12, "proc_s": 1.7973, "rtf": 0.576, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1284, "ttfa_whole_s": 1.7973, "ttfa_clause_split_s": 1.7602}
