{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 1.1896, "rtf": 0.5507, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1322, "ttfa_whole_s": 1.1896, "ttfa_clause_split_s": 0.2762}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.3064, "rtf": 0.71, "audio_s_per_word": 0.23, "latency_s_per_word": 0.1633, "ttfa_whole_s": 1.3064, "ttfa_clause_split_s": 0.9882}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.76, "proc_s": 0.972, "rtf": 0.5523, "audio_s_per_word": 0.2933, "latency_s_per_word": 0.162, "ttfa_whole_s": 0.972, "ttfa_clause_split_s": 0.5867}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.6316, "rtf": 0.4644, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1053, "ttfa_whole_s": 0.6316, "ttfa_clause_split_s": 0.6082}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.8596, "rtf": 0.5117, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1433, "ttfa_whole_s": 0.8596, "ttfa_clause_split_s": 0.6024}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.76, "proc_s": 1.0693, "rtf": 0.6075, "audio_s_per_word": 0.1956, "latency_s_per_word": 0.1188, "ttfa_whole_s": 1.0693, "ttfa_clause_split_s": 0.9303}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.1725, "rtf": 0.4728, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.0977, "ttfa_whole_s": 1.1725, "ttfa_clause_split_s": 1.0883}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.3276, "rtf": 0.5353, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.1106, "ttfa_whole_s": 1.3276, "ttfa_clause_split_s": 0.4255}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.4562, "rtf": 0.492, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.112, "ttfa_whole_s": 1.4562, "ttfa_clause_split_s": 0.3976}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.7704, "rtf": 0.6916, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1609, "ttfa_whole_s": 1.7704, "ttfa_clause_split_s": 0.9495}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.6156, "rtf": 0.5458, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1154, "ttfa_whole_s": 1.6156, "ttfa_clause_split_s": 0.6713}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.0745, "rtf": 0.4477, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1074, "ttfa_whole_s": 1.0745, "ttfa_clause_split_s": 0.6277}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.3173, "rtf": 0.5146, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1198, "ttfa_whole_s": 1.3173, "ttfa_clause_split_s": 1.2194}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.203, "rtf": 0.4297, "audio_s_per_word": 0.2, "latency_s_per_word": 0.0859, "ttfa_whole_s": 1.203, "ttfa_clause_split_s": 0.7653}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.2, "proc_s": 1.5065, "rtf": 0.4708, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1159, "ttfa_whole_s": 1.5065, "ttfa_clause_split_s": 1.8471}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.04, "proc_s": 1.4858, "rtf": 0.4888, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1143, "ttfa_whole_s": 1.4858, "ttfa_clause_split_s": 1.2621}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.6886, "rtf": 0.6596, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1299, "ttfa_whole_s": 1.6886, "ttfa_clause_split_s": 1.7856}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.5598, "rtf": 0.5269, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1114, "ttfa_whole_s": 1.5598, "ttfa_clause_split_s": 1.5874}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.356, "rtf": 0.5845, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1233, "ttfa_whole_s": 1.356, "ttfa_clause_split_s": 0.9802}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.4409, "rtf": 0.5003, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1201, "ttfa_whole_s": 1.4409, "ttfa_clause_split_s": 0.471}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.4473, "rtf": 0.5482, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1113, "ttfa_whole_s": 1.4473, "ttfa_clause_split_s": 1.2097}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.16, "proc_s": 2.0306, "rtf": 0.4881, "audio_s_per_word": 0.1981, "latency_s_per_word": 0.0967, "ttfa_whole_s": 2.0306, "ttfa_clause_split_s": 0.4554}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.64, "proc_s": 2.3191, "rtf": 0.4998, "audio_s_per_word": 0.221, "latency_s_per_word": 0.1104, "ttfa_whole_s": 2.3191, "ttfa_clause_split_s": 0.3604}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.08, "proc_s": 2.1265, "rtf": 0.5212, "audio_s_per_word": 0.2147, "latency_s_per_word": 0.1119, "ttfa_whole_s": 2.1265, "ttfa_clause_split_s": 0.9091}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.8, "proc_s": 2.3665, "rtf": 0.493, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1127, "ttfa_whole_s": 2.3665, "ttfa_clause_split_s": 0.9068}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-031", "text": "Xin lỗi đã làm phiền anh vào giờ này, nhưng điều hòa trong phòng tôi đã hỏng từ chiều.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.08, "proc_s": 2.0041, "rtf": 0.4912, "audio_s_per_word": 0.2147, "latency_s_per_word": 0.1055, "ttfa_whole_s": 2.0041, "ttfa_clause_split_s": 1.1217}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-032", "text": "Chúng tôi có bốn người lớn và hai trẻ nhỏ, nên xin một bàn ở khu vực yên tĩnh hơn.", "tags": ["long"], "n_words": 20, "n_clauses": 2, "audio_s": 4.32, "proc_s": 2.1158, "rtf": 0.4898, "audio_s_per_word": 0.216, "latency_s_per_word": 0.1058, "ttfa_whole_s": 2.1158, "ttfa_clause_split_s": 1.2282}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-033", "text": "Cho tôi hỏi mật khẩu wifi ở đây là gì ạ?", "tags": ["short", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 2.88, "proc_s": 1.4537, "rtf": 0.5048, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1322, "ttfa_whole_s": 1.4537, "ttfa_clause_split_s": 1.2517}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-034", "text": "Tôi muốn check-in sớm, có được không ạ?", "tags": ["short", "code-switch"], "n_words": 8, "n_clauses": 2, "audio_s": 2.16, "proc_s": 1.0685, "rtf": 0.4947, "audio_s_per_word": 0.27, "latency_s_per_word": 0.1336, "ttfa_whole_s": 1.0685, "ttfa_clause_split_s": 1.0012}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-035", "text": "Khách sạn Metropole cách đây bao xa?", "tags": ["short", "code-switch"], "n_words": 7, "n_clauses": 1, "audio_s": 1.76, "proc_s": 1.1252, "rtf": 0.6393, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.1607, "ttfa_whole_s": 1.1252, "ttfa_clause_split_s": 1.2904}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-036", "text": "Anh gọi giúp tôi một chiếc taxi ra sân bay nhé.", "tags": ["medium", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 2.88, "proc_s": 1.3871, "rtf": 0.4816, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1261, "ttfa_whole_s": 1.3871, "ttfa_clause_split_s": 1.1549}
