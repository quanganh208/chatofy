{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.4103, "rtf": 0.7665, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.1567, "ttfa_whole_s": 1.4103, "ttfa_clause_split_s": 1.3988, "stream_ttfa_s": 0.1365, "stream_total_s": 1.6953, "stream_chunks": 5, "stream_underrun_margin_s": 0.4129, "stream_audio_s": 1.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.8017, "rtf": 0.7507, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1501, "ttfa_whole_s": 1.8017, "ttfa_clause_split_s": 1.858, "stream_ttfa_s": 0.1255, "stream_total_s": 2.1533, "stream_chunks": 5, "stream_underrun_margin_s": 0.8268, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.75, "rtf": 0.7292, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1458, "ttfa_whole_s": 1.75, "ttfa_clause_split_s": 0.5172, "stream_ttfa_s": 0.1407, "stream_total_s": 2.105, "stream_chunks": 5, "stream_underrun_margin_s": 0.7635, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.0604, "rtf": 0.7804, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1585, "ttfa_whole_s": 2.0604, "ttfa_clause_split_s": 0.8144, "stream_ttfa_s": 0.1436, "stream_total_s": 2.3977, "stream_chunks": 6, "stream_underrun_margin_s": 0.8734, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.8868, "rtf": 0.7862, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1715, "ttfa_whole_s": 1.8868, "ttfa_clause_split_s": 0.8262, "stream_ttfa_s": 0.1609, "stream_total_s": 2.5968, "stream_chunks": 5, "stream_underrun_margin_s": 1.2351, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.5569, "rtf": 0.9132, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1826, "ttfa_whole_s": 2.5569, "ttfa_clause_split_s": 1.6915, "stream_ttfa_s": 0.1484, "stream_total_s": 2.5674, "stream_chunks": 6, "stream_underrun_margin_s": 0.9555, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 2.0752, "rtf": 0.9264, "audio_s_per_word": 0.224, "latency_s_per_word": 0.2075, "ttfa_whole_s": 2.0752, "ttfa_clause_split_s": 1.2955, "stream_ttfa_s": 0.1853, "stream_total_s": 2.063, "stream_chunks": 5, "stream_underrun_margin_s": 0.6768, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.0787, "rtf": 0.8661, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.189, "ttfa_whole_s": 2.0787, "ttfa_clause_split_s": 0.7869, "stream_ttfa_s": 0.1387, "stream_total_s": 2.2581, "stream_chunks": 5, "stream_underrun_margin_s": 0.9181, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.3279, "rtf": 0.7864, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1663, "ttfa_whole_s": 2.3279, "ttfa_clause_split_s": 1.0768, "stream_ttfa_s": 0.1541, "stream_total_s": 2.6375, "stream_chunks": 6, "stream_underrun_margin_s": 0.8632, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.121, "rtf": 0.7798, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1632, "ttfa_whole_s": 2.121, "ttfa_clause_split_s": 2.1016, "stream_ttfa_s": 0.1328, "stream_total_s": 2.4242, "stream_chunks": 6, "stream_underrun_margin_s": 0.8748, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.0808, "rtf": 0.7882, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1601, "ttfa_whole_s": 2.0808, "ttfa_clause_split_s": 1.0127, "stream_ttfa_s": 0.1483, "stream_total_s": 2.3041, "stream_chunks": 6, "stream_underrun_margin_s": 0.8022, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.1945, "rtf": 0.7837, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1688, "ttfa_whole_s": 2.1945, "ttfa_clause_split_s": 2.1619, "stream_ttfa_s": 0.1274, "stream_total_s": 2.4463, "stream_chunks": 6, "stream_underrun_margin_s": 0.8376, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.0692, "rtf": 0.7608, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1478, "ttfa_whole_s": 2.0692, "ttfa_clause_split_s": 1.4492, "stream_ttfa_s": 0.1507, "stream_total_s": 2.3642, "stream_chunks": 6, "stream_underrun_margin_s": 0.7988, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.727, "rtf": 0.7995, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.157, "ttfa_whole_s": 1.727, "ttfa_clause_split_s": 1.6923, "stream_ttfa_s": 0.1305, "stream_total_s": 1.9725, "stream_chunks": 5, "stream_underrun_margin_s": 0.6412, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.964, "rtf": 0.7439, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1637, "ttfa_whole_s": 1.964, "ttfa_clause_split_s": 0.8876, "stream_ttfa_s": 0.1377, "stream_total_s": 2.3213, "stream_chunks": 6, "stream_underrun_margin_s": 0.8166, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.3716, "rtf": 0.8012, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.1824, "ttfa_whole_s": 2.3716, "ttfa_clause_split_s": 0.7479, "stream_ttfa_s": 0.1485, "stream_total_s": 2.6575, "stream_chunks": 6, "stream_underrun_margin_s": 0.9282, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 3.0627, "rtf": 0.7976, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.1458, "ttfa_whole_s": 3.0627, "ttfa_clause_split_s": 0.9379, "stream_ttfa_s": 0.1532, "stream_total_s": 3.2894, "stream_chunks": 7, "stream_underrun_margin_s": 0.8271, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 3.3396, "rtf": 0.8185, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.159, "ttfa_whole_s": 3.3396, "ttfa_clause_split_s": 0.7492, "stream_ttfa_s": 0.1638, "stream_total_s": 3.5519, "stream_chunks": 7, "stream_underrun_margin_s": 0.7955, "stream_audio_s": 4.08}
