{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-036", "text": "Anh gọi giúp tôi một chiếc taxi ra sân bay nhé.", "tags": ["medium", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.5057, "rtf": 0.4953, "audio_s_per_word": 0.2764, "latency_s_per_word": 0.1369, "ttfa_whole_s": 1.5057, "ttfa_clause_split_s": 1.4816}
