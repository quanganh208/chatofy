{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.1321, "rtf": 0.4717, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1258, "ttfa_whole_s": 1.1321, "ttfa_clause_split_s": 0.5632}
