{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.6144, "rtf": 0.4518, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1024, "ttfa_whole_s": 0.6144, "ttfa_clause_split_s": 0.7949}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.44, "proc_s": 0.7922, "rtf": 0.5501, "audio_s_per_word": 0.24, "latency_s_per_word": 0.132, "ttfa_whole_s": 0.7922, "ttfa_clause_split_s": 0.6823}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.0, "proc_s": 0.9817, "rtf": 0.4909, "audio_s_per_word": 0.2222, "latency_s_per_word": 0.1091, "ttfa_whole_s": 0.9817, "ttfa_clause_split_s": 1.1932}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.291, "rtf": 0.4746, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1076, "ttfa_whole_s": 1.291, "ttfa_clause_split_s": 1.4952}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.3785, "rtf": 0.4787, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1149, "ttfa_whole_s": 1.3785, "ttfa_clause_split_s": 0.2679}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.28, "proc_s": 1.7015, "rtf": 0.5188, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.1309, "ttfa_whole_s": 1.7015, "ttfa_clause_split_s": 0.5973}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 3.04, "proc_s": 1.6877, "rtf": 0.5552, "audio_s_per_word": 0.2764, "latency_s_per_word": 0.1534, "ttfa_whole_s": 1.6877, "ttfa_clause_split_s": 0.6958}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.36, "proc_s": 1.5627, "rtf": 0.4651, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1116, "ttfa_whole_s": 1.5627, "ttfa_clause_split_s": 1.1127}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.4178, "rtf": 0.5213, "audio_s_per_word": 0.272, "latency_s_per_word": 0.1418, "ttfa_whole_s": 1.4178, "ttfa_clause_split_s": 0.7099}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.3657, "rtf": 0.4742, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1242, "ttfa_whole_s": 1.3657, "ttfa_clause_split_s": 0.4205}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.36, "proc_s": 1.8978, "rtf": 0.5648, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1356, "ttfa_whole_s": 1.8978, "ttfa_clause_split_s": 0.8422}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.8988, "rtf": 0.6246, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1461, "ttfa_whole_s": 1.8988, "ttfa_clause_split_s": 1.5474}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.28, "proc_s": 1.6764, "rtf": 0.5111, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.129, "ttfa_whole_s": 1.6764, "ttfa_clause_split_s": 0.8779}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.5921, "rtf": 0.4738, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1225, "ttfa_whole_s": 1.5921, "ttfa_clause_split_s": 1.9207}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.44, "proc_s": 1.8269, "rtf": 0.5311, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.1305, "ttfa_whole_s": 1.8269, "ttfa_clause_split_s": 1.1728}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.484, "rtf": 0.5456, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1349, "ttfa_whole_s": 1.484, "ttfa_clause_split_s": 1.6247}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.5611, "rtf": 0.5274, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.1301, "ttfa_whole_s": 1.5611, "ttfa_clause_split_s": 0.5858}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.12, "proc_s": 1.6554, "rtf": 0.5306, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1273, "ttfa_whole_s": 1.6554, "ttfa_clause_split_s": 0.4819}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.72, "proc_s": 2.5119, "rtf": 0.5322, "audio_s_per_word": 0.2248, "latency_s_per_word": 0.1196, "ttfa_whole_s": 2.5119, "ttfa_clause_split_s": 0.5443}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.68, "proc_s": 2.7249, "rtf": 0.4797, "audio_s_per_word": 0.2705, "latency_s_per_word": 0.1298, "ttfa_whole_s": 2.7249, "ttfa_clause_split_s": 0.6623}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.56, "proc_s": 2.1383, "rtf": 0.4689, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1125, "ttfa_whole_s": 2.1383, "ttfa_clause_split_s": 1.2754}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.2, "proc_s": 2.4414, "rtf": 0.4695, "audio_s_per_word": 0.2476, "latency_s_per_word": 0.1163, "ttfa_whole_s": 2.4414, "ttfa_clause_split_s": 1.1296}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-031", "text": "Xin lỗi đã làm phiền anh vào giờ này, nhưng điều hòa trong phòng tôi đã hỏng từ chiều.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.48, "proc_s": 2.0217, "rtf": 0.4513, "audio_s_per_word": 0.2358, "latency_s_per_word": 0.1064, "ttfa_whole_s": 2.0217, "ttfa_clause_split_s": 1.3427}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-032", "text": "Chúng tôi có bốn người lớn và hai trẻ nhỏ, nên xin một bàn ở khu vực yên tĩnh hơn.", "tags": ["long"], "n_words": 20, "n_clauses": 2, "audio_s": 4.96, "proc_s": 2.4476, "rtf": 0.4935, "audio_s_per_word": 0.248, "latency_s_per_word": 0.1224, "ttfa_whole_s": 2.4476, "ttfa_clause_split_s": 1.1495}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-033", "text": "Cho tôi hỏi mật khẩu wifi ở đây là gì ạ?", "tags": ["short", "code-switch"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.4007, "rtf": 0.515, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1273, "ttfa_whole_s": 1.4007, "ttfa_clause_split_s": 1.396}
