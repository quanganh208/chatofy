{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.9168, "rtf": 0.7729, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.1597, "ttfa_whole_s": 1.9168, "ttfa_clause_split_s": 1.8975, "stream_ttfa_s": 0.1275, "stream_total_s": 2.1944, "stream_chunks": 5, "stream_underrun_margin_s": 0.8661, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.0271, "rtf": 0.7452, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1689, "ttfa_whole_s": 2.0271, "ttfa_clause_split_s": 0.6615, "stream_ttfa_s": 0.128, "stream_total_s": 2.423, "stream_chunks": 6, "stream_underrun_margin_s": 0.8847, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.092, "rtf": 0.7471, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1609, "ttfa_whole_s": 2.092, "ttfa_clause_split_s": 0.8822, "stream_ttfa_s": 0.1425, "stream_total_s": 2.4503, "stream_chunks": 6, "stream_underrun_margin_s": 0.832, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.9687, "rtf": 0.7457, "audio_s_per_word": 0.24, "latency_s_per_word": 0.179, "ttfa_whole_s": 1.9687, "ttfa_clause_split_s": 1.0203, "stream_ttfa_s": 0.1464, "stream_total_s": 2.3737, "stream_chunks": 6, "stream_underrun_margin_s": 0.873, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.4484, "rtf": 0.7847, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1749, "ttfa_whole_s": 2.4484, "ttfa_clause_split_s": 1.3665, "stream_ttfa_s": 0.1344, "stream_total_s": 2.6745, "stream_chunks": 6, "stream_underrun_margin_s": 0.8413, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.8902, "rtf": 0.7876, "audio_s_per_word": 0.24, "latency_s_per_word": 0.189, "ttfa_whole_s": 1.8902, "ttfa_clause_split_s": 1.1984, "stream_ttfa_s": 0.1294, "stream_total_s": 2.141, "stream_chunks": 5, "stream_underrun_margin_s": 0.8107, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.1235, "rtf": 0.7807, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.193, "ttfa_whole_s": 2.1235, "ttfa_clause_split_s": 0.6145, "stream_ttfa_s": 0.1695, "stream_total_s": 2.5143, "stream_chunks": 6, "stream_underrun_margin_s": 0.9242, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.3827, "rtf": 0.7637, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1702, "ttfa_whole_s": 2.3827, "ttfa_clause_split_s": 1.0085, "stream_ttfa_s": 0.1428, "stream_total_s": 2.7113, "stream_chunks": 6, "stream_underrun_margin_s": 0.8506, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.9727, "rtf": 0.7706, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1517, "ttfa_whole_s": 1.9727, "ttfa_clause_split_s": 1.9577, "stream_ttfa_s": 0.1347, "stream_total_s": 2.2378, "stream_chunks": 6, "stream_underrun_margin_s": 0.7983, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.296, "rtf": 0.7972, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1766, "ttfa_whole_s": 2.296, "ttfa_clause_split_s": 1.188, "stream_ttfa_s": 0.1364, "stream_total_s": 2.5271, "stream_chunks": 6, "stream_underrun_margin_s": 0.8429, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.1503, "rtf": 0.768, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1654, "ttfa_whole_s": 2.1503, "ttfa_clause_split_s": 2.1365, "stream_ttfa_s": 0.1378, "stream_total_s": 2.4775, "stream_chunks": 6, "stream_underrun_margin_s": 0.8445, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.1878, "rtf": 0.7814, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1563, "ttfa_whole_s": 2.1878, "ttfa_clause_split_s": 1.4982, "stream_ttfa_s": 0.1339, "stream_total_s": 2.4838, "stream_chunks": 6, "stream_underrun_margin_s": 0.873, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.7363, "rtf": 0.7484, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1578, "ttfa_whole_s": 1.7363, "ttfa_clause_split_s": 1.8055, "stream_ttfa_s": 0.133, "stream_total_s": 2.0778, "stream_chunks": 5, "stream_underrun_margin_s": 0.744, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.122, "rtf": 0.7579, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1768, "ttfa_whole_s": 2.122, "ttfa_clause_split_s": 0.9902, "stream_ttfa_s": 0.1291, "stream_total_s": 2.4676, "stream_chunks": 6, "stream_underrun_margin_s": 0.8693, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.2482, "rtf": 0.7806, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1729, "ttfa_whole_s": 2.2482, "ttfa_clause_split_s": 0.8893, "stream_ttfa_s": 0.1439, "stream_total_s": 2.4348, "stream_chunks": 6, "stream_underrun_margin_s": 0.7535, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.92, "proc_s": 3.1172, "rtf": 0.7952, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1484, "ttfa_whole_s": 3.1172, "ttfa_clause_split_s": 0.8522, "stream_ttfa_s": 0.1499, "stream_total_s": 3.4325, "stream_chunks": 7, "stream_underrun_margin_s": 0.8093, "stream_audio_s": 3.92}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.4, "proc_s": 3.4635, "rtf": 0.7872, "audio_s_per_word": 0.2095, "latency_s_per_word": 0.1649, "ttfa_whole_s": 3.4635, "ttfa_clause_split_s": 0.8967, "stream_ttfa_s": 0.1443, "stream_total_s": 3.8067, "stream_chunks": 7, "stream_underrun_margin_s": 0.8776, "stream_audio_s": 4.4}
