{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.5505, "rtf": 0.51, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.1292, "ttfa_whole_s": 1.5505, "ttfa_clause_split_s": 1.8047}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.84, "proc_s": 1.9581, "rtf": 0.5099, "audio_s_per_word": 0.2743, "latency_s_per_word": 0.1399, "ttfa_whole_s": 1.9581, "ttfa_clause_split_s": 2.3284}
