{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 1.5973, "rtf": 0.4991, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1141, "ttfa_whole_s": 1.5973, "ttfa_clause_split_s": 1.7011}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.1082, "rtf": 0.4617, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1007, "ttfa_whole_s": 1.1082, "ttfa_clause_split_s": 1.43}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.96, "proc_s": 1.6825, "rtf": 0.5684, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1202, "ttfa_whole_s": 1.6825, "ttfa_clause_split_s": 1.7089}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.96, "proc_s": 1.4923, "rtf": 0.5042, "audio_s_per_word": 0.2691, "latency_s_per_word": 0.1357, "ttfa_whole_s": 1.4923, "ttfa_clause_split_s": 1.802}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.2309, "rtf": 0.4663, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1119, "ttfa_whole_s": 1.2309, "ttfa_clause_split_s": 1.3063}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.4981, "rtf": 0.5675, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1362, "ttfa_whole_s": 1.4981, "ttfa_clause_split_s": 1.636}
