{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.6059, "rtf": 0.3986, "audio_s_per_word": 0.304, "latency_s_per_word": 0.1212, "ttfa_whole_s": 0.6059, "ttfa_clause_split_s": 0.4383, "stream_ttfa_s": 0.1481, "stream_total_s": 0.5939, "stream_chunks": 4, "stream_underrun_margin_s": -0.1439, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.76, "proc_s": 0.5944, "rtf": 0.3377, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.0849, "ttfa_whole_s": 0.5944, "ttfa_clause_split_s": 0.5124, "stream_ttfa_s": 0.2028, "stream_total_s": 0.826, "stream_chunks": 4, "stream_underrun_margin_s": -0.1276, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.48, "proc_s": 0.833, "rtf": 0.3359, "audio_s_per_word": 0.2756, "latency_s_per_word": 0.0926, "ttfa_whole_s": 0.833, "ttfa_clause_split_s": 0.3426, "stream_ttfa_s": 0.1543, "stream_total_s": 0.9868, "stream_chunks": 5, "stream_underrun_margin_s": -0.1385, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.92, "proc_s": 0.6305, "rtf": 0.3284, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0788, "ttfa_whole_s": 0.6305, "ttfa_clause_split_s": 0.6048, "stream_ttfa_s": 0.1296, "stream_total_s": 0.6986, "stream_chunks": 4, "stream_underrun_margin_s": -0.1525, "stream_audio_s": 1.92}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.76, "proc_s": 0.6869, "rtf": 0.3903, "audio_s_per_word": 0.2933, "latency_s_per_word": 0.1145, "ttfa_whole_s": 0.6869, "ttfa_clause_split_s": 0.4505, "stream_ttfa_s": 0.1435, "stream_total_s": 0.7748, "stream_chunks": 4, "stream_underrun_margin_s": -0.1583, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.5808, "rtf": 0.3821, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.0968, "ttfa_whole_s": 0.5808, "ttfa_clause_split_s": 0.4974, "stream_ttfa_s": 0.1419, "stream_total_s": 0.6463, "stream_chunks": 4, "stream_underrun_margin_s": -0.1095, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.4327, "rtf": 0.2847, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.0721, "ttfa_whole_s": 0.4327, "ttfa_clause_split_s": 0.4867, "stream_ttfa_s": 0.1317, "stream_total_s": 0.5609, "stream_chunks": 4, "stream_underrun_margin_s": -0.1449, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.16, "proc_s": 0.7704, "rtf": 0.3567, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0856, "ttfa_whole_s": 0.7704, "ttfa_clause_split_s": 0.5493, "stream_ttfa_s": 0.1374, "stream_total_s": 0.971, "stream_chunks": 5, "stream_underrun_margin_s": -0.1495, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.8, "proc_s": 0.8258, "rtf": 0.2949, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.0688, "ttfa_whole_s": 0.8258, "ttfa_clause_split_s": 0.9198, "stream_ttfa_s": 0.1842, "stream_total_s": 1.1111, "stream_chunks": 6, "stream_underrun_margin_s": -0.1456, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.0833, "rtf": 0.366, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.0903, "ttfa_whole_s": 1.0833, "ttfa_clause_split_s": 0.2234, "stream_ttfa_s": 0.1583, "stream_total_s": 1.2769, "stream_chunks": 6, "stream_underrun_margin_s": -0.1175, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 0.9638, "rtf": 0.2868, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.0741, "ttfa_whole_s": 0.9638, "ttfa_clause_split_s": 0.3365, "stream_ttfa_s": 0.1404, "stream_total_s": 1.4159, "stream_chunks": 6, "stream_underrun_margin_s": -0.1336, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.0645, "rtf": 0.3696, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.0968, "ttfa_whole_s": 1.0645, "ttfa_clause_split_s": 0.4396, "stream_ttfa_s": 0.1816, "stream_total_s": 1.2378, "stream_chunks": 6, "stream_underrun_margin_s": -0.0856, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.44, "proc_s": 0.9682, "rtf": 0.2814, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.0692, "ttfa_whole_s": 0.9682, "ttfa_clause_split_s": 0.6695, "stream_ttfa_s": 0.2098, "stream_total_s": 1.6779, "stream_chunks": 7, "stream_underrun_margin_s": -0.1264, "stream_audio_s": 3.44}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.64, "proc_s": 0.8574, "rtf": 0.3248, "audio_s_per_word": 0.264, "latency_s_per_word": 0.0857, "ttfa_whole_s": 0.8574, "ttfa_clause_split_s": 0.4528, "stream_ttfa_s": 0.1932, "stream_total_s": 1.0531, "stream_chunks": 5, "stream_underrun_margin_s": -0.1343, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 3.04, "proc_s": 0.8883, "rtf": 0.2922, "audio_s_per_word": 0.2764, "latency_s_per_word": 0.0808, "ttfa_whole_s": 0.8883, "ttfa_clause_split_s": 0.2828, "stream_ttfa_s": 0.167, "stream_total_s": 1.4087, "stream_chunks": 6, "stream_underrun_margin_s": -0.1171, "stream_audio_s": 3.04}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.6, "proc_s": 1.3464, "rtf": 0.374, "audio_s_per_word": 0.2571, "latency_s_per_word": 0.0962, "ttfa_whole_s": 1.3464, "ttfa_clause_split_s": 0.4306, "stream_ttfa_s": 0.1381, "stream_total_s": 1.4342, "stream_chunks": 6, "stream_underrun_margin_s": -0.1431, "stream_audio_s": 3.6}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.88, "proc_s": 0.8136, "rtf": 0.2825, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.0626, "ttfa_whole_s": 0.8136, "ttfa_clause_split_s": 0.7797, "stream_ttfa_s": 0.3463, "stream_total_s": 1.4377, "stream_chunks": 6, "stream_underrun_margin_s": -0.1431, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 1.3012, "rtf": 0.3873, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1001, "ttfa_whole_s": 1.3012, "ttfa_clause_split_s": 0.5101, "stream_ttfa_s": 0.1437, "stream_total_s": 1.3095, "stream_chunks": 6, "stream_underrun_margin_s": -0.151, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.88, "proc_s": 0.9772, "rtf": 0.3393, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.0752, "ttfa_whole_s": 0.9772, "ttfa_clause_split_s": 0.8528, "stream_ttfa_s": 0.1352, "stream_total_s": 1.014, "stream_chunks": 5, "stream_underrun_margin_s": -0.1562, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.44, "proc_s": 1.0961, "rtf": 0.3186, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.0783, "ttfa_whole_s": 1.0961, "ttfa_clause_split_s": 0.8352, "stream_ttfa_s": 0.1451, "stream_total_s": 1.3971, "stream_chunks": 6, "stream_underrun_margin_s": -0.1562, "stream_audio_s": 3.44}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 0.7706, "rtf": 0.2833, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.0701, "ttfa_whole_s": 0.7706, "ttfa_clause_split_s": 0.7093, "stream_ttfa_s": 0.2298, "stream_total_s": 1.1692, "stream_chunks": 6, "stream_underrun_margin_s": -0.1151, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 3.2, "proc_s": 0.8833, "rtf": 0.276, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.0736, "ttfa_whole_s": 0.8833, "ttfa_clause_split_s": 0.3796, "stream_ttfa_s": 0.1466, "stream_total_s": 1.2734, "stream_chunks": 6, "stream_underrun_margin_s": -0.1614, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.52, "proc_s": 1.06, "rtf": 0.3011, "audio_s_per_word": 0.2708, "latency_s_per_word": 0.0815, "ttfa_whole_s": 1.06, "ttfa_clause_split_s": 0.2894, "stream_ttfa_s": 0.1559, "stream_total_s": 1.3622, "stream_chunks": 6, "stream_underrun_margin_s": -0.1466, "stream_audio_s": 3.52}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.96, "proc_s": 1.4716, "rtf": 0.2967, "audio_s_per_word": 0.2362, "latency_s_per_word": 0.0701, "ttfa_whole_s": 1.4716, "ttfa_clause_split_s": 0.3591, "stream_ttfa_s": 0.156, "stream_total_s": 1.9843, "stream_chunks": 7, "stream_underrun_margin_s": -0.1526, "stream_audio_s": 4.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.44, "proc_s": 1.5528, "rtf": 0.2854, "audio_s_per_word": 0.259, "latency_s_per_word": 0.0739, "ttfa_whole_s": 1.5528, "ttfa_clause_split_s": 0.4724, "stream_ttfa_s": 0.1827, "stream_total_s": 2.1183, "stream_chunks": 7, "stream_underrun_margin_s": -0.1498, "stream_audio_s": 5.44}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.96, "proc_s": 1.4565, "rtf": 0.2937, "audio_s_per_word": 0.2611, "latency_s_per_word": 0.0767, "ttfa_whole_s": 1.4565, "ttfa_clause_split_s": 0.8928, "stream_ttfa_s": 0.1395, "stream_total_s": 1.5414, "stream_chunks": 6, "stream_underrun_margin_s": -0.1584, "stream_audio_s": 4.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.12, "proc_s": 1.7796, "rtf": 0.3476, "audio_s_per_word": 0.2438, "latency_s_per_word": 0.0847, "ttfa_whole_s": 1.7796, "ttfa_clause_split_s": 0.5712, "stream_ttfa_s": 0.1621, "stream_total_s": 1.8413, "stream_chunks": 7, "stream_underrun_margin_s": -0.1495, "stream_audio_s": 5.12}
