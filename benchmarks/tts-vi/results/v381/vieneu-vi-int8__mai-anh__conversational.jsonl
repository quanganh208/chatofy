{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-002", "text": "Cho tôi một ly cà phê sữa đá.", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 2.0, "proc_s": 0.6828, "rtf": 0.3414, "audio_s_per_word": 0.25, "latency_s_per_word": 0.0854, "ttfa_whole_s": 0.6828, "ttfa_clause_split_s": 0.5713, "stream_ttfa_s": 0.2559, "stream_total_s": 0.865, "stream_chunks": 5, "stream_underrun_margin_s": -0.1441, "stream_audio_s": 2.0}
