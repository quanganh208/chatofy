{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.28, "proc_s": 2.3757, "rtf": 0.7243, "audio_s_per_word": 0.2343, "latency_s_per_word": 0.1697, "ttfa_whole_s": 2.3757, "ttfa_clause_split_s": 2.2858}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.5878, "rtf": 0.7351, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.1443, "ttfa_whole_s": 1.5878, "ttfa_clause_split_s": 1.5132}
