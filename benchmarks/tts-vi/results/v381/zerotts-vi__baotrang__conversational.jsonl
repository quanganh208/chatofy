{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.6625, "rtf": 0.6927, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1663, "ttfa_whole_s": 1.6625, "ttfa_clause_split_s": 0.9957, "stream_ttfa_s": 0.134, "stream_total_s": 1.9731, "stream_chunks": 5, "stream_underrun_margin_s": 0.6383, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.8878, "rtf": 0.694, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1716, "ttfa_whole_s": 1.8878, "ttfa_clause_split_s": 0.59, "stream_ttfa_s": 0.1487, "stream_total_s": 2.1787, "stream_chunks": 6, "stream_underrun_margin_s": 0.6217, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.2456, "rtf": 0.7197, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1604, "ttfa_whole_s": 2.2456, "ttfa_clause_split_s": 0.8328, "stream_ttfa_s": 0.1431, "stream_total_s": 2.5504, "stream_chunks": 6, "stream_underrun_margin_s": 0.6787, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.8373, "rtf": 0.7177, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1413, "ttfa_whole_s": 1.8373, "ttfa_clause_split_s": 1.7529, "stream_ttfa_s": 0.1274, "stream_total_s": 2.1111, "stream_chunks": 6, "stream_underrun_margin_s": 0.686, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.0526, "rtf": 0.7127, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1579, "ttfa_whole_s": 2.0526, "ttfa_clause_split_s": 1.0762, "stream_ttfa_s": 0.1259, "stream_total_s": 2.318, "stream_chunks": 6, "stream_underrun_margin_s": 0.6648, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.9802, "rtf": 0.7072, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1523, "ttfa_whole_s": 1.9802, "ttfa_clause_split_s": 1.9821, "stream_ttfa_s": 0.1428, "stream_total_s": 2.3006, "stream_chunks": 6, "stream_underrun_margin_s": 0.686, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.9555, "rtf": 0.6984, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1397, "ttfa_whole_s": 1.9555, "ttfa_clause_split_s": 1.4104, "stream_ttfa_s": 0.1506, "stream_total_s": 2.2848, "stream_chunks": 6, "stream_underrun_margin_s": 0.6754, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.623, "rtf": 0.6996, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1475, "ttfa_whole_s": 1.623, "ttfa_clause_split_s": 1.6448, "stream_ttfa_s": 0.1276, "stream_total_s": 1.8392, "stream_chunks": 5, "stream_underrun_margin_s": 0.5107, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.9065, "rtf": 0.6809, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1589, "ttfa_whole_s": 1.9065, "ttfa_clause_split_s": 0.885, "stream_ttfa_s": 0.1344, "stream_total_s": 2.3111, "stream_chunks": 6, "stream_underrun_margin_s": 0.7193, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.0445, "rtf": 0.7099, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1573, "ttfa_whole_s": 2.0445, "ttfa_clause_split_s": 0.7294, "stream_ttfa_s": 0.1365, "stream_total_s": 2.2926, "stream_chunks": 6, "stream_underrun_margin_s": 0.6438, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.92, "proc_s": 2.6928, "rtf": 0.6869, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1282, "ttfa_whole_s": 2.6928, "ttfa_clause_split_s": 0.8108, "stream_ttfa_s": 0.1479, "stream_total_s": 3.1068, "stream_chunks": 7, "stream_underrun_margin_s": 0.6533, "stream_audio_s": 3.92}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.4, "proc_s": 3.11, "rtf": 0.7068, "audio_s_per_word": 0.2095, "latency_s_per_word": 0.1481, "ttfa_whole_s": 3.11, "ttfa_clause_split_s": 0.8125, "stream_ttfa_s": 0.1509, "stream_total_s": 3.5034, "stream_chunks": 7, "stream_underrun_margin_s": 0.6694, "stream_audio_s": 4.4}
