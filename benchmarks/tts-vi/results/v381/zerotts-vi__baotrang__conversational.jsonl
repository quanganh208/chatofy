{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.7337, "rtf": 0.6991, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.1445, "ttfa_whole_s": 1.7337, "ttfa_clause_split_s": 1.7598, "stream_ttfa_s": 0.1224, "stream_total_s": 2.0639, "stream_chunks": 5, "stream_underrun_margin_s": 0.7407, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.9382, "rtf": 0.7126, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1615, "ttfa_whole_s": 1.9382, "ttfa_clause_split_s": 0.5886, "stream_ttfa_s": 0.14, "stream_total_s": 2.2555, "stream_chunks": 6, "stream_underrun_margin_s": 0.7142, "stream_audio_s": 2.72}
