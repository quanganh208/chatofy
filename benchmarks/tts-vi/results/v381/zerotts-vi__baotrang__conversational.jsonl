{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.901, "rtf": 0.7201, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1728, "ttfa_whole_s": 1.901, "ttfa_clause_split_s": 0.8298, "stream_ttfa_s": 0.1406, "stream_total_s": 2.1022, "stream_chunks": 6, "stream_underrun_margin_s": 0.6216, "stream_audio_s": 2.64}
