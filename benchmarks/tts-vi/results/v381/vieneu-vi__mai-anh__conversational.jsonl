{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.7251, "rtf": 0.4771, "audio_s_per_word": 0.304, "latency_s_per_word": 0.145, "ttfa_whole_s": 0.7251, "ttfa_clause_split_s": 0.8709, "stream_ttfa_s": 0.197, "stream_total_s": 0.9808, "stream_chunks": 5, "stream_underrun_margin_s": -0.1461, "stream_audio_s": 1.52}
