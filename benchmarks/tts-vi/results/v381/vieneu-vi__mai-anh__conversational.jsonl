{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.1496, "rtf": 0.4635, "audio_s_per_word": 0.2756, "latency_s_per_word": 0.1277, "ttfa_whole_s": 1.1496, "ttfa_clause_split_s": 0.4195, "stream_ttfa_s": 0.2159, "stream_total_s": 1.5383, "stream_chunks": 6, "stream_underrun_margin_s": -0.1068, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 2.0, "proc_s": 1.112, "rtf": 0.556, "audio_s_per_word": 0.25, "latency_s_per_word": 0.139, "ttfa_whole_s": 1.112, "ttfa_clause_split_s": 0.899, "stream_ttfa_s": 0.2145, "stream_total_s": 1.0075, "stream_chunks": 5, "stream_underrun_margin_s": -0.146, "stream_audio_s": 2.0}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.7028, "rtf": 0.4184, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1171, "ttfa_whole_s": 0.7028, "ttfa_clause_split_s": 1.0141, "stream_ttfa_s": 0.2104, "stream_total_s": 0.9551, "stream_chunks": 5, "stream_underrun_margin_s": -0.1289, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.6988, "rtf": 0.4597, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.1165, "ttfa_whole_s": 0.6988, "ttfa_clause_split_s": 0.8459, "stream_ttfa_s": 0.2143, "stream_total_s": 0.8219, "stream_chunks": 4, "stream_underrun_margin_s": -0.1389, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.8865, "rtf": 0.554, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1477, "ttfa_whole_s": 0.8865, "ttfa_clause_split_s": 0.8508, "stream_ttfa_s": 0.1996, "stream_total_s": 0.9105, "stream_chunks": 4, "stream_underrun_margin_s": -0.1046, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.2327, "rtf": 0.5313, "audio_s_per_word": 0.2578, "latency_s_per_word": 0.137, "ttfa_whole_s": 1.2327, "ttfa_clause_split_s": 1.0188, "stream_ttfa_s": 0.2385, "stream_total_s": 1.333, "stream_chunks": 6, "stream_underrun_margin_s": -0.1315, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.96, "proc_s": 1.5671, "rtf": 0.5294, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.1306, "ttfa_whole_s": 1.5671, "ttfa_clause_split_s": 1.3365, "stream_ttfa_s": 0.2093, "stream_total_s": 1.7075, "stream_chunks": 7, "stream_underrun_margin_s": -0.0472, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.3679, "rtf": 0.4621, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.114, "ttfa_whole_s": 1.3679, "ttfa_clause_split_s": 0.2854, "stream_ttfa_s": 0.287, "stream_total_s": 1.8127, "stream_chunks": 6, "stream_underrun_margin_s": -0.1262, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.12, "proc_s": 1.3339, "rtf": 0.4275, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1026, "ttfa_whole_s": 1.3339, "ttfa_clause_split_s": 0.6092, "stream_ttfa_s": 0.2131, "stream_total_s": 1.8166, "stream_chunks": 7, "stream_underrun_margin_s": -0.1237, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.2504, "rtf": 0.4597, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1137, "ttfa_whole_s": 1.2504, "ttfa_clause_split_s": 0.6234, "stream_ttfa_s": 0.2281, "stream_total_s": 1.8727, "stream_chunks": 7, "stream_underrun_margin_s": -0.0063, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.52, "proc_s": 1.7953, "rtf": 0.51, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.1282, "ttfa_whole_s": 1.7953, "ttfa_clause_split_s": 0.87, "stream_ttfa_s": 0.2358, "stream_total_s": 1.8641, "stream_chunks": 7, "stream_underrun_margin_s": -0.1162, "stream_audio_s": 3.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.3028, "rtf": 0.5253, "audio_s_per_word": 0.248, "latency_s_per_word": 0.1303, "ttfa_whole_s": 1.3028, "ttfa_clause_split_s": 0.6942, "stream_ttfa_s": 0.2063, "stream_total_s": 1.3532, "stream_chunks": 6, "stream_underrun_margin_s": -0.1126, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 3.12, "proc_s": 1.7656, "rtf": 0.5659, "audio_s_per_word": 0.2836, "latency_s_per_word": 0.1605, "ttfa_whole_s": 1.7656, "ttfa_clause_split_s": 0.343, "stream_ttfa_s": 0.2322, "stream_total_s": 1.7563, "stream_chunks": 7, "stream_underrun_margin_s": -0.1369, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.6, "proc_s": 1.8834, "rtf": 0.5232, "audio_s_per_word": 0.2571, "latency_s_per_word": 0.1345, "ttfa_whole_s": 1.8834, "ttfa_clause_split_s": 0.8058, "stream_ttfa_s": 0.2312, "stream_total_s": 2.0408, "stream_chunks": 7, "stream_underrun_margin_s": -0.1188, "stream_audio_s": 3.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.4292, "rtf": 0.4701, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1099, "ttfa_whole_s": 1.4292, "ttfa_clause_split_s": 1.3231, "stream_ttfa_s": 0.1959, "stream_total_s": 1.4825, "stream_chunks": 6, "stream_underrun_margin_s": -0.1203, "stream_audio_s": 3.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 2.0834, "rtf": 0.6201, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1603, "ttfa_whole_s": 2.0834, "ttfa_clause_split_s": 1.7351, "stream_ttfa_s": 0.4455, "stream_total_s": 2.1697, "stream_chunks": 7, "stream_underrun_margin_s": -0.123, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.7565, "rtf": 0.5228, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1351, "ttfa_whole_s": 1.7565, "ttfa_clause_split_s": 1.4931, "stream_ttfa_s": 0.2832, "stream_total_s": 2.315, "stream_chunks": 8, "stream_underrun_margin_s": -0.1472, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.68, "proc_s": 1.9278, "rtf": 0.5239, "audio_s_per_word": 0.2629, "latency_s_per_word": 0.1377, "ttfa_whole_s": 1.9278, "ttfa_clause_split_s": 1.0555, "stream_ttfa_s": 0.2, "stream_total_s": 2.3766, "stream_chunks": 8, "stream_underrun_margin_s": -0.1281, "stream_audio_s": 3.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.1931, "rtf": 0.4519, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1085, "ttfa_whole_s": 1.1931, "ttfa_clause_split_s": 1.1849, "stream_ttfa_s": 0.2557, "stream_total_s": 1.9634, "stream_chunks": 7, "stream_underrun_margin_s": 0.0159, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 3.12, "proc_s": 1.6278, "rtf": 0.5217, "audio_s_per_word": 0.26, "latency_s_per_word": 0.1357, "ttfa_whole_s": 1.6278, "ttfa_clause_split_s": 0.743, "stream_ttfa_s": 0.2549, "stream_total_s": 1.7037, "stream_chunks": 6, "stream_underrun_margin_s": -0.1176, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.28, "proc_s": 1.6488, "rtf": 0.5027, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.1268, "ttfa_whole_s": 1.6488, "ttfa_clause_split_s": 0.663, "stream_ttfa_s": 0.2149, "stream_total_s": 2.1886, "stream_chunks": 7, "stream_underrun_margin_s": -0.1209, "stream_audio_s": 3.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.2, "proc_s": 2.4954, "rtf": 0.4799, "audio_s_per_word": 0.2476, "latency_s_per_word": 0.1188, "ttfa_whole_s": 2.4954, "ttfa_clause_split_s": 0.5492, "stream_ttfa_s": 0.2618, "stream_total_s": 3.1836, "stream_chunks": 9, "stream_underrun_margin_s": -0.0967, "stream_audio_s": 5.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.44, "proc_s": 2.6122, "rtf": 0.4802, "audio_s_per_word": 0.259, "latency_s_per_word": 0.1244, "ttfa_whole_s": 2.6122, "ttfa_clause_split_s": 0.7854, "stream_ttfa_s": 0.2297, "stream_total_s": 3.2364, "stream_chunks": 10, "stream_underrun_margin_s": 0.0031, "stream_audio_s": 5.44}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.64, "proc_s": 2.1646, "rtf": 0.4665, "audio_s_per_word": 0.2442, "latency_s_per_word": 0.1139, "ttfa_whole_s": 2.1646, "ttfa_clause_split_s": 1.0726, "stream_ttfa_s": 0.2556, "stream_total_s": 3.0296, "stream_chunks": 9, "stream_underrun_margin_s": -0.1333, "stream_audio_s": 4.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.96, "proc_s": 2.1782, "rtf": 0.4392, "audio_s_per_word": 0.2362, "latency_s_per_word": 0.1037, "ttfa_whole_s": 2.1782, "ttfa_clause_split_s": 0.7913, "stream_ttfa_s": 0.2146, "stream_total_s": 3.2407, "stream_chunks": 9, "stream_underrun_margin_s": -0.0422, "stream_audio_s": 4.96}
