{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.4, "proc_s": 1.6502, "rtf": 0.6876, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1375, "ttfa_whole_s": 1.6502, "ttfa_clause_split_s": 1.7363, "stream_ttfa_s": 0.1256, "stream_total_s": 1.8726, "stream_chunks": 5, "stream_underrun_margin_s": 0.5463, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.6583, "rtf": 0.691, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1382, "ttfa_whole_s": 1.6583, "ttfa_clause_split_s": 0.5203, "stream_ttfa_s": 0.1616, "stream_total_s": 2.0341, "stream_chunks": 5, "stream_underrun_margin_s": 0.6717, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.8228, "rtf": 0.6905, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1402, "ttfa_whole_s": 1.8228, "ttfa_clause_split_s": 0.6661, "stream_ttfa_s": 0.1349, "stream_total_s": 2.1584, "stream_chunks": 6, "stream_underrun_margin_s": 0.6788, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.7194, "rtf": 0.7164, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1563, "ttfa_whole_s": 1.7194, "ttfa_clause_split_s": 0.7492, "stream_ttfa_s": 0.1387, "stream_total_s": 1.9645, "stream_chunks": 5, "stream_underrun_margin_s": 0.6251, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.9323, "rtf": 0.6901, "audio_s_per_word": 0.2, "latency_s_per_word": 0.138, "ttfa_whole_s": 1.9323, "ttfa_clause_split_s": 1.0773, "stream_ttfa_s": 0.1358, "stream_total_s": 2.302, "stream_chunks": 6, "stream_underrun_margin_s": 0.6986, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 1.6006, "rtf": 0.7146, "audio_s_per_word": 0.224, "latency_s_per_word": 0.1601, "ttfa_whole_s": 1.6006, "ttfa_clause_split_s": 0.9289, "stream_ttfa_s": 0.1341, "stream_total_s": 1.8682, "stream_chunks": 5, "stream_underrun_margin_s": 0.5332, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.6405, "rtf": 0.6836, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1491, "ttfa_whole_s": 1.6405, "ttfa_clause_split_s": 0.7225, "stream_ttfa_s": 0.1276, "stream_total_s": 1.9622, "stream_chunks": 5, "stream_underrun_margin_s": 0.6338, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.1272, "rtf": 0.7187, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1519, "ttfa_whole_s": 2.1272, "ttfa_clause_split_s": 0.9102, "stream_ttfa_s": 0.1485, "stream_total_s": 2.4279, "stream_chunks": 6, "stream_underrun_margin_s": 0.6634, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.8897, "rtf": 0.6947, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1454, "ttfa_whole_s": 1.8897, "ttfa_clause_split_s": 1.913, "stream_ttfa_s": 0.1255, "stream_total_s": 2.2033, "stream_chunks": 6, "stream_underrun_margin_s": 0.664, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.8521, "rtf": 0.7016, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1425, "ttfa_whole_s": 1.8521, "ttfa_clause_split_s": 0.9753, "stream_ttfa_s": 0.1432, "stream_total_s": 2.1875, "stream_chunks": 6, "stream_underrun_margin_s": 0.7003, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.9401, "rtf": 0.6929, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1492, "ttfa_whole_s": 1.9401, "ttfa_clause_split_s": 1.984, "stream_ttfa_s": 0.1332, "stream_total_s": 2.2294, "stream_chunks": 6, "stream_underrun_margin_s": 0.6298, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.9682, "rtf": 0.7236, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1406, "ttfa_whole_s": 1.9682, "ttfa_clause_split_s": 1.46, "stream_ttfa_s": 0.1418, "stream_total_s": 2.2202, "stream_chunks": 6, "stream_underrun_margin_s": 0.6653, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.5214, "rtf": 0.7044, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.1383, "ttfa_whole_s": 1.5214, "ttfa_clause_split_s": 1.4729, "stream_ttfa_s": 0.1263, "stream_total_s": 1.7401, "stream_chunks": 5, "stream_underrun_margin_s": 0.413, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.8339, "rtf": 0.6946, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1528, "ttfa_whole_s": 1.8339, "ttfa_clause_split_s": 0.8459, "stream_ttfa_s": 0.1246, "stream_total_s": 2.0947, "stream_chunks": 6, "stream_underrun_margin_s": 0.6339, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.0732, "rtf": 0.7004, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.1595, "ttfa_whole_s": 2.0732, "ttfa_clause_split_s": 0.7227, "stream_ttfa_s": 0.1538, "stream_total_s": 2.3969, "stream_chunks": 6, "stream_underrun_margin_s": 0.6597, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 2.7669, "rtf": 0.7206, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.1318, "ttfa_whole_s": 2.7669, "ttfa_clause_split_s": 0.7903, "stream_ttfa_s": 0.1541, "stream_total_s": 2.9921, "stream_chunks": 7, "stream_underrun_margin_s": 0.6315, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 2.9901, "rtf": 0.7329, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1424, "ttfa_whole_s": 2.9901, "ttfa_clause_split_s": 0.6939, "stream_ttfa_s": 0.1383, "stream_total_s": 3.2512, "stream_chunks": 7, "stream_underrun_margin_s": 0.6164, "stream_audio_s": 4.08}
