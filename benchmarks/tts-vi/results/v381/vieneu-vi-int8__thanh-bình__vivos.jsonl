{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_066", "text": "Kẽm có nhiều trong gan sò thịt đỏ cá óc trứng", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 0.6888, "rtf": 0.2609, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0626, "ttfa_whole_s": 0.6888, "ttfa_clause_split_s": 0.7985}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.28, "proc_s": 1.2349, "rtf": 0.3765, "audio_s_per_word": 0.2343, "latency_s_per_word": 0.0882, "ttfa_whole_s": 1.2349, "ttfa_clause_split_s": 1.2805}
