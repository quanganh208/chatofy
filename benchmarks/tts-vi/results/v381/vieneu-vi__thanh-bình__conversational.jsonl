{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.04, "proc_s": 0.4976, "rtf": 0.4784, "audio_s_per_word": 0.208, "latency_s_per_word": 0.0995, "ttfa_whole_s": 0.4976, "ttfa_clause_split_s": 0.5269, "stream_ttfa_s": 0.1855, "stream_total_s": 0.5277, "stream_chunks": 3, "stream_underrun_margin_s": -0.1188, "stream_audio_s": 1.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.5809, "rtf": 0.4272, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.083, "ttfa_whole_s": 0.5809, "ttfa_clause_split_s": 0.5863, "stream_ttfa_s": 0.1957, "stream_total_s": 0.8124, "stream_chunks": 4, "stream_underrun_margin_s": -0.1315, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 1.1552, "rtf": 0.5348, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1284, "ttfa_whole_s": 1.1552, "ttfa_clause_split_s": 0.2948, "stream_ttfa_s": 0.3369, "stream_total_s": 1.4016, "stream_chunks": 5, "stream_underrun_margin_s": -0.0894, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.7028, "rtf": 0.4392, "audio_s_per_word": 0.2, "latency_s_per_word": 0.0878, "ttfa_whole_s": 0.7028, "ttfa_clause_split_s": 0.6357, "stream_ttfa_s": 0.2009, "stream_total_s": 0.9112, "stream_chunks": 4, "stream_underrun_margin_s": -0.1373, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.28, "proc_s": 0.5938, "rtf": 0.4639, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.099, "ttfa_whole_s": 0.5938, "ttfa_clause_split_s": 0.4937, "stream_ttfa_s": 0.2729, "stream_total_s": 0.7395, "stream_chunks": 4, "stream_underrun_margin_s": -0.1264, "stream_audio_s": 1.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.76, "proc_s": 0.8978, "rtf": 0.5101, "audio_s_per_word": 0.2933, "latency_s_per_word": 0.1496, "ttfa_whole_s": 0.8978, "ttfa_clause_split_s": 0.6746, "stream_ttfa_s": 0.1755, "stream_total_s": 0.8396, "stream_chunks": 4, "stream_underrun_margin_s": -0.131, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.7501, "rtf": 0.4465, "audio_s_per_word": 0.28, "latency_s_per_word": 0.125, "ttfa_whole_s": 0.7501, "ttfa_clause_split_s": 0.6572, "stream_ttfa_s": 0.1884, "stream_total_s": 0.9263, "stream_chunks": 4, "stream_underrun_margin_s": -0.1343, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.6948, "rtf": 0.4136, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.0772, "ttfa_whole_s": 0.6948, "ttfa_clause_split_s": 0.8532, "stream_ttfa_s": 0.2268, "stream_total_s": 0.8781, "stream_chunks": 4, "stream_underrun_margin_s": -0.1121, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.1735, "rtf": 0.4191, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.0978, "ttfa_whole_s": 1.1735, "ttfa_clause_split_s": 1.1153, "stream_ttfa_s": 0.2092, "stream_total_s": 1.6154, "stream_chunks": 6, "stream_underrun_margin_s": -0.1111, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.2105, "rtf": 0.5044, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1009, "ttfa_whole_s": 1.2105, "ttfa_clause_split_s": 0.268, "stream_ttfa_s": 0.23, "stream_total_s": 1.2535, "stream_chunks": 6, "stream_underrun_margin_s": -0.1337, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.04, "proc_s": 1.4572, "rtf": 0.4793, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1121, "ttfa_whole_s": 1.4572, "ttfa_clause_split_s": 0.3123, "stream_ttfa_s": 0.2549, "stream_total_s": 1.9404, "stream_chunks": 7, "stream_underrun_margin_s": 0.0174, "stream_audio_s": 3.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.2931, "rtf": 0.4754, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1176, "ttfa_whole_s": 1.2931, "ttfa_clause_split_s": 0.4383, "stream_ttfa_s": 0.2035, "stream_total_s": 1.3115, "stream_chunks": 6, "stream_underrun_margin_s": -0.133, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.3328, "rtf": 0.5049, "audio_s_per_word": 0.1886, "latency_s_per_word": 0.0952, "ttfa_whole_s": 1.3328, "ttfa_clause_split_s": 0.748, "stream_ttfa_s": 0.2014, "stream_total_s": 1.4652, "stream_chunks": 6, "stream_underrun_margin_s": -0.1357, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.0465, "rtf": 0.436, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1046, "ttfa_whole_s": 1.0465, "ttfa_clause_split_s": 0.5585, "stream_ttfa_s": 0.2001, "stream_total_s": 1.3736, "stream_chunks": 6, "stream_underrun_margin_s": -0.0733, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.1737, "rtf": 0.4315, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1067, "ttfa_whole_s": 1.1737, "ttfa_clause_split_s": 0.3128, "stream_ttfa_s": 0.2227, "stream_total_s": 1.4562, "stream_chunks": 6, "stream_underrun_margin_s": -0.1369, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.2112, "rtf": 0.4453, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0865, "ttfa_whole_s": 1.2112, "ttfa_clause_split_s": 0.7472, "stream_ttfa_s": 0.2475, "stream_total_s": 1.705, "stream_chunks": 6, "stream_underrun_margin_s": -0.1116, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.0645, "rtf": 0.4032, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.0819, "ttfa_whole_s": 1.0645, "ttfa_clause_split_s": 1.0852, "stream_ttfa_s": 0.2624, "stream_total_s": 1.5141, "stream_chunks": 6, "stream_underrun_margin_s": -0.1193, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.3116, "rtf": 0.4684, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1009, "ttfa_whole_s": 1.3116, "ttfa_clause_split_s": 0.8122, "stream_ttfa_s": 0.228, "stream_total_s": 1.5627, "stream_chunks": 6, "stream_underrun_margin_s": -0.1452, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.32, "proc_s": 0.9954, "rtf": 0.429, "audio_s_per_word": 0.1785, "latency_s_per_word": 0.0766, "ttfa_whole_s": 0.9954, "ttfa_clause_split_s": 0.9592, "stream_ttfa_s": 0.2312, "stream_total_s": 1.2579, "stream_chunks": 6, "stream_underrun_margin_s": -0.095, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.4285, "rtf": 0.5102, "audio_s_per_word": 0.2, "latency_s_per_word": 0.102, "ttfa_whole_s": 1.4285, "ttfa_clause_split_s": 0.829, "stream_ttfa_s": 0.1977, "stream_total_s": 1.602, "stream_chunks": 6, "stream_underrun_margin_s": -0.1336, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.0943, "rtf": 0.4275, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.0995, "ttfa_whole_s": 1.0943, "ttfa_clause_split_s": 1.0347, "stream_ttfa_s": 0.2355, "stream_total_s": 1.2676, "stream_chunks": 6, "stream_underrun_margin_s": -0.1279, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.3465, "rtf": 0.4675, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1122, "ttfa_whole_s": 1.3465, "ttfa_clause_split_s": 0.4949, "stream_ttfa_s": 0.2331, "stream_total_s": 1.5117, "stream_chunks": 6, "stream_underrun_margin_s": -0.12, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.0801, "rtf": 0.4219, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.0831, "ttfa_whole_s": 1.0801, "ttfa_clause_split_s": 0.4147, "stream_ttfa_s": 0.2255, "stream_total_s": 1.4753, "stream_chunks": 6, "stream_underrun_margin_s": -0.1238, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.16, "proc_s": 1.8853, "rtf": 0.4532, "audio_s_per_word": 0.1981, "latency_s_per_word": 0.0898, "ttfa_whole_s": 1.8853, "ttfa_clause_split_s": 0.4307, "stream_ttfa_s": 0.2214, "stream_total_s": 2.1297, "stream_chunks": 7, "stream_underrun_margin_s": -0.0488, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.64, "proc_s": 2.1404, "rtf": 0.4613, "audio_s_per_word": 0.221, "latency_s_per_word": 0.1019, "ttfa_whole_s": 2.1404, "ttfa_clause_split_s": 0.3645, "stream_ttfa_s": 0.2137, "stream_total_s": 2.457, "stream_chunks": 8, "stream_underrun_margin_s": -0.1365, "stream_audio_s": 4.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.16, "proc_s": 2.0082, "rtf": 0.4827, "audio_s_per_word": 0.2189, "latency_s_per_word": 0.1057, "ttfa_whole_s": 2.0082, "ttfa_clause_split_s": 0.826, "stream_ttfa_s": 0.2196, "stream_total_s": 2.0492, "stream_chunks": 7, "stream_underrun_margin_s": -0.1516, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.24, "proc_s": 2.1174, "rtf": 0.4994, "audio_s_per_word": 0.2019, "latency_s_per_word": 0.1008, "ttfa_whole_s": 2.1174, "ttfa_clause_split_s": 0.7293, "stream_ttfa_s": 0.2151, "stream_total_s": 2.2889, "stream_chunks": 8, "stream_underrun_margin_s": -0.1116, "stream_audio_s": 4.24}
