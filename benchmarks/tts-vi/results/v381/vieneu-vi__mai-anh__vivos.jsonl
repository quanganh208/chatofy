{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 3.0829, "rtf": 0.8962, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.2202, "ttfa_whole_s": 3.0829, "ttfa_clause_split_s": 2.5935}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.1114, "rtf": 0.4481, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.101, "ttfa_whole_s": 1.1114, "ttfa_clause_split_s": 0.9387}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.5184, "rtf": 0.4519, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1085, "ttfa_whole_s": 1.5184, "ttfa_clause_split_s": 1.3421}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.1556, "rtf": 0.4249, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1051, "ttfa_whole_s": 1.1556, "ttfa_clause_split_s": 1.0657}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.424, "rtf": 0.5086, "audio_s_per_word": 0.2545, "latency_s_per_word": 0.1295, "ttfa_whole_s": 1.424, "ttfa_clause_split_s": 1.2637}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.88, "proc_s": 1.4603, "rtf": 0.507, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1328, "ttfa_whole_s": 1.4603, "ttfa_clause_split_s": 1.4227}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_099", "text": "Chị tìm nhà cho em ở trọ ngay cổng trường chị học", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.3852, "rtf": 0.5093, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1154, "ttfa_whole_s": 1.3852, "ttfa_clause_split_s": 1.1174}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.96, "proc_s": 1.6441, "rtf": 0.5554, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.137, "ttfa_whole_s": 1.6441, "ttfa_clause_split_s": 1.2731}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.68, "proc_s": 2.0596, "rtf": 0.5597, "audio_s_per_word": 0.2629, "latency_s_per_word": 0.1471, "ttfa_whole_s": 2.0596, "ttfa_clause_split_s": 1.669}
