{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 1.339, "rtf": 0.4184, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.0956, "ttfa_whole_s": 1.339, "ttfa_clause_split_s": 1.4164}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.3206, "rtf": 0.4855, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1201, "ttfa_whole_s": 1.3206, "ttfa_clause_split_s": 1.2149}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.0356, "rtf": 0.4176, "audio_s_per_word": 0.1771, "latency_s_per_word": 0.074, "ttfa_whole_s": 1.0356, "ttfa_clause_split_s": 1.1961}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.1751, "rtf": 0.4451, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1068, "ttfa_whole_s": 1.1751, "ttfa_clause_split_s": 1.3765}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.1473, "rtf": 0.5122, "audio_s_per_word": 0.2036, "latency_s_per_word": 0.1043, "ttfa_whole_s": 1.1473, "ttfa_clause_split_s": 0.8886}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.1109, "rtf": 0.4788, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.101, "ttfa_whole_s": 1.1109, "ttfa_clause_split_s": 1.0005}
