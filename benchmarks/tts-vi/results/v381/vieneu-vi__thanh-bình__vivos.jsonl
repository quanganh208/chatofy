{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.2386, "rtf": 0.4838, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.1032, "ttfa_whole_s": 1.2386, "ttfa_clause_split_s": 1.2543}
