{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.9195, "rtf": 0.7057, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1371, "ttfa_whole_s": 1.9195, "ttfa_clause_split_s": 1.9898}
