{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_066", "text": "Kẽm có nhiều trong gan sò thịt đỏ cá óc trứng", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.88, "proc_s": 1.0099, "rtf": 0.3507, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.0918, "ttfa_whole_s": 1.0099, "ttfa_clause_split_s": 0.827}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.68, "proc_s": 0.9969, "rtf": 0.2709, "audio_s_per_word": 0.2629, "latency_s_per_word": 0.0712, "ttfa_whole_s": 0.9969, "ttfa_clause_split_s": 1.2507}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.0557, "rtf": 0.3999, "audio_s_per_word": 0.24, "latency_s_per_word": 0.096, "ttfa_whole_s": 1.0557, "ttfa_clause_split_s": 0.8153}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.0475, "rtf": 0.3117, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0748, "ttfa_whole_s": 1.0475, "ttfa_clause_split_s": 1.1565}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.0057, "rtf": 0.3592, "audio_s_per_word": 0.2545, "latency_s_per_word": 0.0914, "ttfa_whole_s": 1.0057, "ttfa_clause_split_s": 0.9213}
