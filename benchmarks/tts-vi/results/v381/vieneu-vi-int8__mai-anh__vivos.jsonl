{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.96, "proc_s": 0.9099, "rtf": 0.3074, "audio_s_per_word": 0.2467, "latency_s_per_word": 0.0758, "ttfa_whole_s": 0.9099, "ttfa_clause_split_s": 0.8062}
