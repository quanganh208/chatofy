{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 0.7419, "rtf": 0.2898, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.0674, "ttfa_whole_s": 0.7419, "ttfa_clause_split_s": 0.7524}
