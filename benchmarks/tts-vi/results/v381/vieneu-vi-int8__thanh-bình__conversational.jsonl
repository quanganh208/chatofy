{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 0.96, "proc_s": 0.562, "rtf": 0.5854, "audio_s_per_word": 0.192, "latency_s_per_word": 0.1124, "ttfa_whole_s": 0.562, "ttfa_clause_split_s": 0.2912, "stream_ttfa_s": 0.1477, "stream_total_s": 0.4105, "stream_chunks": 3, "stream_underrun_margin_s": -0.1283, "stream_audio_s": 0.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.92, "proc_s": 0.5385, "rtf": 0.2805, "audio_s_per_word": 0.2743, "latency_s_per_word": 0.0769, "ttfa_whole_s": 0.5385, "ttfa_clause_split_s": 0.4962, "stream_ttfa_s": 0.1179, "stream_total_s": 0.6876, "stream_chunks": 4, "stream_underrun_margin_s": -0.1668, "stream_audio_s": 1.92}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 0.6361, "rtf": 0.2945, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0707, "ttfa_whole_s": 0.6361, "ttfa_clause_split_s": 0.2142, "stream_ttfa_s": 0.1541, "stream_total_s": 0.8399, "stream_chunks": 5, "stream_underrun_margin_s": -0.1489, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 2.48, "proc_s": 0.6824, "rtf": 0.2752, "audio_s_per_word": 0.31, "latency_s_per_word": 0.0853, "ttfa_whole_s": 0.6824, "ttfa_clause_split_s": 0.7663, "stream_ttfa_s": 0.1602, "stream_total_s": 1.0145, "stream_chunks": 5, "stream_underrun_margin_s": -0.1324, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.3793, "rtf": 0.2789, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.0632, "ttfa_whole_s": 0.3793, "ttfa_clause_split_s": 0.4676, "stream_ttfa_s": 0.1432, "stream_total_s": 0.5254, "stream_chunks": 4, "stream_underrun_margin_s": -0.138, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.28, "proc_s": 0.3857, "rtf": 0.3013, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.0643, "ttfa_whole_s": 0.3857, "ttfa_clause_split_s": 0.3388, "stream_ttfa_s": 0.136, "stream_total_s": 0.4682, "stream_chunks": 3, "stream_underrun_margin_s": -0.1549, "stream_audio_s": 1.28}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.3874, "rtf": 0.2849, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.0646, "ttfa_whole_s": 0.3874, "ttfa_clause_split_s": 0.4528, "stream_ttfa_s": 0.1421, "stream_total_s": 0.7126, "stream_chunks": 4, "stream_underrun_margin_s": -0.0908, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.5414, "rtf": 0.3384, "audio_s_per_word": 0.1778, "latency_s_per_word": 0.0602, "ttfa_whole_s": 0.5414, "ttfa_clause_split_s": 0.4476, "stream_ttfa_s": 0.1449, "stream_total_s": 0.5853, "stream_chunks": 4, "stream_underrun_margin_s": -0.1484, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 3.2, "proc_s": 0.9798, "rtf": 0.3062, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.0817, "ttfa_whole_s": 0.9798, "ttfa_clause_split_s": 0.9903, "stream_ttfa_s": 0.1499, "stream_total_s": 1.3538, "stream_chunks": 6, "stream_underrun_margin_s": -0.1364, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 0.8378, "rtf": 0.3173, "audio_s_per_word": 0.22, "latency_s_per_word": 0.0698, "ttfa_whole_s": 0.8378, "ttfa_clause_split_s": 0.2125, "stream_ttfa_s": 0.1622, "stream_total_s": 1.0071, "stream_chunks": 5, "stream_underrun_margin_s": -0.1463, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 0.7449, "rtf": 0.266, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.0573, "ttfa_whole_s": 0.7449, "ttfa_clause_split_s": 0.3485, "stream_ttfa_s": 0.1307, "stream_total_s": 1.0285, "stream_chunks": 5, "stream_underrun_margin_s": -0.1515, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.56, "proc_s": 0.8335, "rtf": 0.3256, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.0758, "ttfa_whole_s": 0.8335, "ttfa_clause_split_s": 0.2989, "stream_ttfa_s": 0.1493, "stream_total_s": 0.9488, "stream_chunks": 5, "stream_underrun_margin_s": -0.1432, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 0.8883, "rtf": 0.3266, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0634, "ttfa_whole_s": 0.8883, "ttfa_clause_split_s": 0.4924, "stream_ttfa_s": 0.1723, "stream_total_s": 1.0226, "stream_chunks": 5, "stream_underrun_margin_s": -0.1511, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 0.6004, "rtf": 0.268, "audio_s_per_word": 0.224, "latency_s_per_word": 0.06, "ttfa_whole_s": 0.6004, "ttfa_clause_split_s": 0.4367, "stream_ttfa_s": 0.1422, "stream_total_s": 1.0632, "stream_chunks": 5, "stream_underrun_margin_s": -0.1368, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 0.7167, "rtf": 0.2635, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.0652, "ttfa_whole_s": 0.7167, "ttfa_clause_split_s": 0.5497, "stream_ttfa_s": 0.1384, "stream_total_s": 0.9859, "stream_chunks": 5, "stream_underrun_margin_s": -0.1528, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 0.913, "rtf": 0.3084, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.0652, "ttfa_whole_s": 0.913, "ttfa_clause_split_s": 0.3366, "stream_ttfa_s": 0.16, "stream_total_s": 1.3021, "stream_chunks": 6, "stream_underrun_margin_s": -0.1384, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.68, "proc_s": 1.1164, "rtf": 0.3034, "audio_s_per_word": 0.2831, "latency_s_per_word": 0.0859, "ttfa_whole_s": 1.1164, "ttfa_clause_split_s": 1.0224, "stream_ttfa_s": 0.1378, "stream_total_s": 1.3358, "stream_chunks": 6, "stream_underrun_margin_s": -0.1528, "stream_audio_s": 3.68}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 0.7577, "rtf": 0.256, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.0583, "ttfa_whole_s": 0.7577, "ttfa_clause_split_s": 0.4345, "stream_ttfa_s": 0.2689, "stream_total_s": 1.3433, "stream_chunks": 6, "stream_underrun_margin_s": -0.1121, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.2, "proc_s": 0.8707, "rtf": 0.2721, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.067, "ttfa_whole_s": 0.8707, "ttfa_clause_split_s": 0.9154, "stream_ttfa_s": 0.1401, "stream_total_s": 1.1256, "stream_chunks": 6, "stream_underrun_margin_s": -0.1576, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.0641, "rtf": 0.38, "audio_s_per_word": 0.2, "latency_s_per_word": 0.076, "ttfa_whole_s": 1.0641, "ttfa_clause_split_s": 0.6698, "stream_ttfa_s": 0.1357, "stream_total_s": 1.1701, "stream_chunks": 6, "stream_underrun_margin_s": -0.1588, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 0.7521, "rtf": 0.2938, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.0684, "ttfa_whole_s": 0.7521, "ttfa_clause_split_s": 0.65, "stream_ttfa_s": 0.1266, "stream_total_s": 0.8983, "stream_chunks": 5, "stream_underrun_margin_s": -0.1522, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.0942, "rtf": 0.3799, "audio_s_per_word": 0.24, "latency_s_per_word": 0.0912, "ttfa_whole_s": 1.0942, "ttfa_clause_split_s": 0.5331, "stream_ttfa_s": 0.1443, "stream_total_s": 1.0461, "stream_chunks": 5, "stream_underrun_margin_s": -0.1602, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 0.7325, "rtf": 0.2775, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.0563, "ttfa_whole_s": 0.7325, "ttfa_clause_split_s": 0.252, "stream_ttfa_s": 0.1693, "stream_total_s": 0.9106, "stream_chunks": 5, "stream_underrun_margin_s": -0.1698, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.16, "proc_s": 1.4059, "rtf": 0.338, "audio_s_per_word": 0.1981, "latency_s_per_word": 0.0669, "ttfa_whole_s": 1.4059, "ttfa_clause_split_s": 0.2954, "stream_ttfa_s": 0.2723, "stream_total_s": 1.7402, "stream_chunks": 6, "stream_underrun_margin_s": -0.1017, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.72, "proc_s": 1.2732, "rtf": 0.2697, "audio_s_per_word": 0.2248, "latency_s_per_word": 0.0606, "ttfa_whole_s": 1.2732, "ttfa_clause_split_s": 0.2302, "stream_ttfa_s": 0.1836, "stream_total_s": 1.8208, "stream_chunks": 6, "stream_underrun_margin_s": -0.1324, "stream_audio_s": 4.72}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.08, "proc_s": 1.383, "rtf": 0.339, "audio_s_per_word": 0.2147, "latency_s_per_word": 0.0728, "ttfa_whole_s": 1.383, "ttfa_clause_split_s": 0.6256, "stream_ttfa_s": 0.1398, "stream_total_s": 1.3891, "stream_chunks": 6, "stream_underrun_margin_s": -0.1488, "stream_audio_s": 4.08}
{"type": "sentence", "engine": "vieneu-vi-int8", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.24, "proc_s": 1.3621, "rtf": 0.3212, "audio_s_per_word": 0.2019, "latency_s_per_word": 0.0649, "ttfa_whole_s": 1.3621, "ttfa_clause_split_s": 0.5256, "stream_ttfa_s": 0.2941, "stream_total_s": 1.802, "stream_chunks": 6, "stream_underrun_margin_s": -0.1328, "stream_audio_s": 4.24}
