{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.4094, "rtf": 0.9126, "audio_s_per_word": 0.24, "latency_s_per_word": 0.219, "ttfa_whole_s": 2.4094, "ttfa_clause_split_s": 1.0009, "stream_ttfa_s": 0.1485, "stream_total_s": 2.5769, "stream_chunks": 6, "stream_underrun_margin_s": 1.0591, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.7693, "rtf": 0.8876, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1978, "ttfa_whole_s": 2.7693, "ttfa_clause_split_s": 1.4853, "stream_ttfa_s": 0.145, "stream_total_s": 3.0935, "stream_chunks": 6, "stream_underrun_margin_s": 1.2012, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.0129, "rtf": 0.8387, "audio_s_per_word": 0.24, "latency_s_per_word": 0.2013, "ttfa_whole_s": 2.0129, "ttfa_clause_split_s": 1.3191, "stream_ttfa_s": 0.1566, "stream_total_s": 2.3744, "stream_chunks": 5, "stream_underrun_margin_s": 1.0165, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.2538, "rtf": 0.8286, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.2049, "ttfa_whole_s": 2.2538, "ttfa_clause_split_s": 0.8354, "stream_ttfa_s": 0.1526, "stream_total_s": 2.7373, "stream_chunks": 6, "stream_underrun_margin_s": 1.1214, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 2.6953, "rtf": 0.8639, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.1925, "ttfa_whole_s": 2.6953, "ttfa_clause_split_s": 1.0365, "stream_ttfa_s": 0.1473, "stream_total_s": 2.9606, "stream_chunks": 6, "stream_underrun_margin_s": 0.9919, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 2.3518, "rtf": 0.9187, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1809, "ttfa_whole_s": 2.3518, "ttfa_clause_split_s": 2.0807, "stream_ttfa_s": 0.1221, "stream_total_s": 2.5527, "stream_chunks": 6, "stream_underrun_margin_s": 1.1282, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.63, "rtf": 0.9132, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.2023, "ttfa_whole_s": 2.63, "ttfa_clause_split_s": 1.4799, "stream_ttfa_s": 0.1387, "stream_total_s": 2.7775, "stream_chunks": 6, "stream_underrun_margin_s": 1.0448, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.4778, "rtf": 0.8849, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1906, "ttfa_whole_s": 2.4778, "ttfa_clause_split_s": 2.6089, "stream_ttfa_s": 0.1479, "stream_total_s": 3.0619, "stream_chunks": 6, "stream_underrun_margin_s": 1.3415, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.5894, "rtf": 0.9248, "audio_s_per_word": 0.2, "latency_s_per_word": 0.185, "ttfa_whole_s": 2.5894, "ttfa_clause_split_s": 1.7875, "stream_ttfa_s": 0.1686, "stream_total_s": 3.1901, "stream_chunks": 6, "stream_underrun_margin_s": 1.4673, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 2.2751, "rtf": 0.9806, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.2068, "ttfa_whole_s": 2.2751, "ttfa_clause_split_s": 2.4023, "stream_ttfa_s": 0.1489, "stream_total_s": 2.4305, "stream_chunks": 5, "stream_underrun_margin_s": 1.0808, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.617, "rtf": 0.9346, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.2181, "ttfa_whole_s": 2.617, "ttfa_clause_split_s": 1.1902, "stream_ttfa_s": 0.1606, "stream_total_s": 3.0394, "stream_chunks": 6, "stream_underrun_margin_s": 1.3267, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.791, "rtf": 0.9691, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.2147, "ttfa_whole_s": 2.791, "ttfa_clause_split_s": 0.9698, "stream_ttfa_s": 0.169, "stream_total_s": 3.153, "stream_chunks": 6, "stream_underrun_margin_s": 1.2925, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.92, "proc_s": 3.6804, "rtf": 0.9389, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1753, "ttfa_whole_s": 3.6804, "ttfa_clause_split_s": 1.1057, "stream_ttfa_s": 0.1509, "stream_total_s": 4.0708, "stream_chunks": 7, "stream_underrun_margin_s": 1.2644, "stream_audio_s": 3.92}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.4, "proc_s": 4.5447, "rtf": 1.0329, "audio_s_per_word": 0.2095, "latency_s_per_word": 0.2164, "ttfa_whole_s": 4.5447, "ttfa_clause_split_s": 1.1044, "stream_ttfa_s": 0.1631, "stream_total_s": 4.4874, "stream_chunks": 7, "stream_underrun_margin_s": 1.2095, "stream_audio_s": 4.4}
