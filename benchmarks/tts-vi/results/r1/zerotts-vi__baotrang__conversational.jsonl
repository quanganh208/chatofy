{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 2.1948, "rtf": 0.885, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.1829, "ttfa_whole_s": 2.1948, "ttfa_clause_split_s": 2.221, "stream_ttfa_s": 0.1473, "stream_total_s": 2.4818, "stream_chunks": 5, "stream_underrun_margin_s": 1.1336, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.4203, "rtf": 0.8898, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.2017, "ttfa_whole_s": 2.4203, "ttfa_clause_split_s": 0.8098, "stream_ttfa_s": 0.1743, "stream_total_s": 2.66, "stream_chunks": 6, "stream_underrun_margin_s": 1.0464, "stream_audio_s": 2.72}
