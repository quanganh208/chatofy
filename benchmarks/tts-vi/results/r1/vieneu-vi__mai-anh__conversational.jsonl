{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.8281, "rtf": 0.6089, "audio_s_per_word": 0.272, "latency_s_per_word": 0.1656, "ttfa_whole_s": 0.8281, "ttfa_clause_split_s": 0.8317, "stream_ttfa_s": 0.2168, "stream_total_s": 0.8944, "stream_chunks": 4, "stream_underrun_margin_s": -0.1147, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.76, "proc_s": 1.2323, "rtf": 0.7002, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.176, "ttfa_whole_s": 1.2323, "ttfa_clause_split_s": 1.2703, "stream_ttfa_s": 0.2492, "stream_total_s": 1.2708, "stream_chunks": 5, "stream_underrun_margin_s": -0.1111, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.2301, "rtf": 0.496, "audio_s_per_word": 0.2756, "latency_s_per_word": 0.1367, "ttfa_whole_s": 1.2301, "ttfa_clause_split_s": 0.7361, "stream_ttfa_s": 0.3976, "stream_total_s": 1.6713, "stream_chunks": 6, "stream_underrun_margin_s": -0.1198, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.92, "proc_s": 1.1031, "rtf": 0.5745, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1379, "ttfa_whole_s": 1.1031, "ttfa_clause_split_s": 1.1933, "stream_ttfa_s": 0.2784, "stream_total_s": 2.0202, "stream_chunks": 6, "stream_underrun_margin_s": 0.2189, "stream_audio_s": 1.92}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.6, "proc_s": 1.2595, "rtf": 0.7872, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.2099, "ttfa_whole_s": 1.2595, "ttfa_clause_split_s": 1.2797, "stream_ttfa_s": 0.3471, "stream_total_s": 1.2199, "stream_chunks": 5, "stream_underrun_margin_s": -0.0531, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 1.3636, "rtf": 0.8971, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.2273, "ttfa_whole_s": 1.3636, "ttfa_clause_split_s": 0.8499, "stream_ttfa_s": 0.2263, "stream_total_s": 0.9522, "stream_chunks": 4, "stream_underrun_margin_s": -0.144, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 1.292, "rtf": 0.85, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.2153, "ttfa_whole_s": 1.292, "ttfa_clause_split_s": 1.0307, "stream_ttfa_s": 0.2243, "stream_total_s": 1.2792, "stream_chunks": 5, "stream_underrun_margin_s": -0.015, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.24, "proc_s": 0.9909, "rtf": 0.4423, "audio_s_per_word": 0.2489, "latency_s_per_word": 0.1101, "ttfa_whole_s": 0.9909, "ttfa_clause_split_s": 1.6817, "stream_ttfa_s": 0.2932, "stream_total_s": 1.8247, "stream_chunks": 6, "stream_underrun_margin_s": -0.0107, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.1961, "rtf": 0.8074, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.183, "ttfa_whole_s": 2.1961, "ttfa_clause_split_s": 2.0581, "stream_ttfa_s": 0.2967, "stream_total_s": 2.1551, "stream_chunks": 8, "stream_underrun_margin_s": 0.0682, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.2878, "rtf": 0.8411, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1906, "ttfa_whole_s": 2.2878, "ttfa_clause_split_s": 0.6748, "stream_ttfa_s": 0.3609, "stream_total_s": 2.3773, "stream_chunks": 8, "stream_underrun_margin_s": 0.0099, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 2.7848, "rtf": 0.8288, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.2142, "ttfa_whole_s": 2.7848, "ttfa_clause_split_s": 0.6556, "stream_ttfa_s": 0.2637, "stream_total_s": 2.782, "stream_chunks": 9, "stream_underrun_margin_s": 0.1116, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.8561, "rtf": 0.627, "audio_s_per_word": 0.2691, "latency_s_per_word": 0.1687, "ttfa_whole_s": 1.8561, "ttfa_clause_split_s": 0.9984, "stream_ttfa_s": 0.3543, "stream_total_s": 2.21, "stream_chunks": 7, "stream_underrun_margin_s": 0.0327, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.36, "proc_s": 1.9338, "rtf": 0.5755, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1381, "ttfa_whole_s": 1.9338, "ttfa_clause_split_s": 1.2627, "stream_ttfa_s": 0.2568, "stream_total_s": 2.4446, "stream_chunks": 8, "stream_underrun_margin_s": -0.0654, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.7177, "rtf": 0.671, "audio_s_per_word": 0.256, "latency_s_per_word": 0.1718, "ttfa_whole_s": 1.7177, "ttfa_clause_split_s": 1.3256, "stream_ttfa_s": 0.3519, "stream_total_s": 2.3587, "stream_chunks": 8, "stream_underrun_margin_s": 0.2218, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.2016, "rtf": 0.7644, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.2001, "ttfa_whole_s": 2.2016, "ttfa_clause_split_s": 0.9133, "stream_ttfa_s": 0.3931, "stream_total_s": 3.0412, "stream_chunks": 9, "stream_underrun_margin_s": 0.0838, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.84, "proc_s": 3.348, "rtf": 0.8719, "audio_s_per_word": 0.2743, "latency_s_per_word": 0.2391, "ttfa_whole_s": 3.348, "ttfa_clause_split_s": 1.6643, "stream_ttfa_s": 0.2558, "stream_total_s": 2.8281, "stream_chunks": 9, "stream_underrun_margin_s": -0.0059, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.28, "proc_s": 2.2853, "rtf": 0.6967, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.1758, "ttfa_whole_s": 2.2853, "ttfa_clause_split_s": 2.5893, "stream_ttfa_s": 0.2598, "stream_total_s": 2.0936, "stream_chunks": 7, "stream_underrun_margin_s": -0.133, "stream_audio_s": 3.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 2.6548, "rtf": 0.7901, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.2042, "ttfa_whole_s": 2.6548, "ttfa_clause_split_s": 1.0091, "stream_ttfa_s": 0.2427, "stream_total_s": 2.1092, "stream_chunks": 7, "stream_underrun_margin_s": -0.1239, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.36, "proc_s": 2.5836, "rtf": 0.7689, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1987, "ttfa_whole_s": 2.5836, "ttfa_clause_split_s": 2.1033, "stream_ttfa_s": 0.2143, "stream_total_s": 2.4758, "stream_chunks": 8, "stream_underrun_margin_s": -0.0944, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.7741, "rtf": 0.5544, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1267, "ttfa_whole_s": 1.7741, "ttfa_clause_split_s": 1.4434, "stream_ttfa_s": 0.2734, "stream_total_s": 2.0264, "stream_chunks": 7, "stream_underrun_margin_s": -0.113, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.7835, "rtf": 0.6557, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1621, "ttfa_whole_s": 1.7835, "ttfa_clause_split_s": 1.8389, "stream_ttfa_s": 0.2245, "stream_total_s": 1.8274, "stream_chunks": 7, "stream_underrun_margin_s": -0.0998, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.8056, "rtf": 0.5643, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1505, "ttfa_whole_s": 1.8056, "ttfa_clause_split_s": 0.9907, "stream_ttfa_s": 0.2658, "stream_total_s": 2.3992, "stream_chunks": 8, "stream_underrun_margin_s": -0.0502, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.9712, "rtf": 0.616, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1516, "ttfa_whole_s": 1.9712, "ttfa_clause_split_s": 0.7314, "stream_ttfa_s": 0.2549, "stream_total_s": 1.9029, "stream_chunks": 7, "stream_underrun_margin_s": -0.1381, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.96, "proc_s": 2.6856, "rtf": 0.5415, "audio_s_per_word": 0.2362, "latency_s_per_word": 0.1279, "ttfa_whole_s": 2.6856, "ttfa_clause_split_s": 0.6567, "stream_ttfa_s": 0.2523, "stream_total_s": 3.3595, "stream_chunks": 10, "stream_underrun_margin_s": -0.056, "stream_audio_s": 4.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.36, "proc_s": 3.4178, "rtf": 0.6377, "audio_s_per_word": 0.2552, "latency_s_per_word": 0.1628, "ttfa_whole_s": 3.4178, "ttfa_clause_split_s": 0.8967, "stream_ttfa_s": 0.2585, "stream_total_s": 3.7743, "stream_chunks": 11, "stream_underrun_margin_s": -0.0486, "stream_audio_s": 5.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.72, "proc_s": 2.8639, "rtf": 0.6068, "audio_s_per_word": 0.2484, "latency_s_per_word": 0.1507, "ttfa_whole_s": 2.8639, "ttfa_clause_split_s": 1.3944, "stream_ttfa_s": 0.279, "stream_total_s": 3.4969, "stream_chunks": 11, "stream_underrun_margin_s": 0.0666, "stream_audio_s": 4.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.2, "proc_s": 3.1774, "rtf": 0.611, "audio_s_per_word": 0.2476, "latency_s_per_word": 0.1513, "ttfa_whole_s": 3.1774, "ttfa_clause_split_s": 1.3411, "stream_ttfa_s": 0.3787, "stream_total_s": 4.0755, "stream_chunks": 11, "stream_underrun_margin_s": -0.0848, "stream_audio_s": 5.2}
