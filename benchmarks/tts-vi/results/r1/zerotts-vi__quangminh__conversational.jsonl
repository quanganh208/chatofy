{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 2.1323, "rtf": 1.1589, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.2369, "ttfa_whole_s": 2.1323, "ttfa_clause_split_s": 1.8594, "stream_ttfa_s": 0.1443, "stream_total_s": 2.1762, "stream_chunks": 5, "stream_underrun_margin_s": 0.8308, "stream_audio_s": 1.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.4, "proc_s": 2.0082, "rtf": 0.8368, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1674, "ttfa_whole_s": 2.0082, "ttfa_clause_split_s": 2.2185, "stream_ttfa_s": 0.165, "stream_total_s": 2.7348, "stream_chunks": 5, "stream_underrun_margin_s": 1.3689, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 3.0707, "rtf": 1.2795, "audio_s_per_word": 0.2, "latency_s_per_word": 0.2559, "ttfa_whole_s": 3.0707, "ttfa_clause_split_s": 0.6165, "stream_ttfa_s": 0.1454, "stream_total_s": 2.403, "stream_chunks": 5, "stream_underrun_margin_s": 1.0567, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.5783, "rtf": 0.9766, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1983, "ttfa_whole_s": 2.5783, "ttfa_clause_split_s": 1.4135, "stream_ttfa_s": 0.1437, "stream_total_s": 2.6471, "stream_chunks": 6, "stream_underrun_margin_s": 1.1292, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.1774, "rtf": 0.9073, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1979, "ttfa_whole_s": 2.1774, "ttfa_clause_split_s": 1.0736, "stream_ttfa_s": 0.2392, "stream_total_s": 2.7835, "stream_chunks": 5, "stream_underrun_margin_s": 1.3435, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.9195, "rtf": 1.0427, "audio_s_per_word": 0.2, "latency_s_per_word": 0.2085, "ttfa_whole_s": 2.9195, "ttfa_clause_split_s": 1.6633, "stream_ttfa_s": 0.1552, "stream_total_s": 3.6425, "stream_chunks": 6, "stream_underrun_margin_s": 1.9474, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 2.1956, "rtf": 0.9802, "audio_s_per_word": 0.224, "latency_s_per_word": 0.2196, "ttfa_whole_s": 2.1956, "ttfa_clause_split_s": 1.1405, "stream_ttfa_s": 0.1418, "stream_total_s": 2.2869, "stream_chunks": 5, "stream_underrun_margin_s": 0.9443, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.0112, "rtf": 0.838, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1828, "ttfa_whole_s": 2.0112, "ttfa_clause_split_s": 0.9162, "stream_ttfa_s": 0.1617, "stream_total_s": 2.8415, "stream_chunks": 5, "stream_underrun_margin_s": 1.4787, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.6918, "rtf": 0.9094, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.1923, "ttfa_whole_s": 2.6918, "ttfa_clause_split_s": 1.3568, "stream_ttfa_s": 0.1596, "stream_total_s": 2.7604, "stream_chunks": 6, "stream_underrun_margin_s": 0.9766, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.2395, "rtf": 0.8233, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1723, "ttfa_whole_s": 2.2395, "ttfa_clause_split_s": 2.7157, "stream_ttfa_s": 0.1371, "stream_total_s": 2.6103, "stream_chunks": 6, "stream_underrun_margin_s": 1.0114, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.6858, "rtf": 1.0173, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.2066, "ttfa_whole_s": 2.6858, "ttfa_clause_split_s": 1.1673, "stream_ttfa_s": 0.1468, "stream_total_s": 2.6036, "stream_chunks": 6, "stream_underrun_margin_s": 1.0885, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.3877, "rtf": 0.8527, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1837, "ttfa_whole_s": 2.3877, "ttfa_clause_split_s": 2.4075, "stream_ttfa_s": 0.1308, "stream_total_s": 2.7581, "stream_chunks": 6, "stream_underrun_margin_s": 1.116, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.5247, "rtf": 0.9282, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1803, "ttfa_whole_s": 2.5247, "ttfa_clause_split_s": 1.5679, "stream_ttfa_s": 0.1328, "stream_total_s": 2.7573, "stream_chunks": 6, "stream_underrun_margin_s": 1.1832, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.9004, "rtf": 0.8798, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.1728, "ttfa_whole_s": 1.9004, "ttfa_clause_split_s": 1.8514, "stream_ttfa_s": 0.1487, "stream_total_s": 2.1058, "stream_chunks": 5, "stream_underrun_margin_s": 0.756, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.261, "rtf": 0.8565, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1884, "ttfa_whole_s": 2.261, "ttfa_clause_split_s": 1.0199, "stream_ttfa_s": 0.1388, "stream_total_s": 2.6374, "stream_chunks": 6, "stream_underrun_margin_s": 1.1194, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 3.1659, "rtf": 1.0696, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.2435, "ttfa_whole_s": 3.1659, "ttfa_clause_split_s": 0.9256, "stream_ttfa_s": 0.1878, "stream_total_s": 2.8827, "stream_chunks": 6, "stream_underrun_margin_s": 1.0869, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 3.5052, "rtf": 0.9128, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.1669, "ttfa_whole_s": 3.5052, "ttfa_clause_split_s": 1.1301, "stream_ttfa_s": 0.2131, "stream_total_s": 5.1322, "stream_chunks": 7, "stream_underrun_margin_s": 2.3507, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 4.2769, "rtf": 1.0483, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.2037, "ttfa_whole_s": 4.2769, "ttfa_clause_split_s": 1.0612, "stream_ttfa_s": 0.1748, "stream_total_s": 4.8076, "stream_chunks": 7, "stream_underrun_margin_s": 1.7194, "stream_audio_s": 4.08}
