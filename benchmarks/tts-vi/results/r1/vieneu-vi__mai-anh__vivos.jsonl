{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 2.0001, "rtf": 0.5814, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.1429, "ttfa_whole_s": 2.0001, "ttfa_clause_split_s": 1.9367}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.3309, "rtf": 0.5367, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.121, "ttfa_whole_s": 1.3309, "ttfa_clause_split_s": 2.2844}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 2.0213, "rtf": 0.5876, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.1444, "ttfa_whole_s": 2.0213, "ttfa_clause_split_s": 1.7845}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.7467, "rtf": 0.6823, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1588, "ttfa_whole_s": 1.7467, "ttfa_clause_split_s": 1.8941}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.3654, "rtf": 0.5172, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1241, "ttfa_whole_s": 1.3654, "ttfa_clause_split_s": 1.632}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.2447, "rtf": 0.4862, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1132, "ttfa_whole_s": 1.2447, "ttfa_clause_split_s": 1.3208}
