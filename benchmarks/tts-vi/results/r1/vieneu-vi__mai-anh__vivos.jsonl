{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 3.04, "proc_s": 1.7514, "rtf": 0.5761, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.1459, "ttfa_whole_s": 1.7514, "ttfa_clause_split_s": 1.5894}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.68, "proc_s": 1.9475, "rtf": 0.5292, "audio_s_per_word": 0.2629, "latency_s_per_word": 0.1391, "ttfa_whole_s": 1.9475, "ttfa_clause_split_s": 1.9406}
