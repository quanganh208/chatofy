{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-003", "text": "Nhà vệ sinh ở đâu ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.04, "proc_s": 0.4852, "rtf": 0.4665, "audio_s_per_word": 0.1733, "latency_s_per_word": 0.0809, "ttfa_whole_s": 0.4852, "ttfa_clause_split_s": 0.5316, "stream_ttfa_s": 0.3677, "stream_total_s": 0.8025, "stream_chunks": 3, "stream_underrun_margin_s": -0.118, "stream_audio_s": 1.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.04, "proc_s": 0.5037, "rtf": 0.4843, "audio_s_per_word": 0.208, "latency_s_per_word": 0.1007, "ttfa_whole_s": 0.5037, "ttfa_clause_split_s": 0.4918, "stream_ttfa_s": 0.2291, "stream_total_s": 0.6578, "stream_chunks": 3, "stream_underrun_margin_s": -0.1178, "stream_audio_s": 1.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.676, "rtf": 0.497, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0966, "ttfa_whole_s": 0.676, "ttfa_clause_split_s": 0.7299, "stream_ttfa_s": 0.3095, "stream_total_s": 0.9442, "stream_chunks": 4, "stream_underrun_margin_s": -0.13, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 1.2555, "rtf": 0.5813, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1395, "ttfa_whole_s": 1.2555, "ttfa_clause_split_s": 0.44, "stream_ttfa_s": 0.2788, "stream_total_s": 1.4153, "stream_chunks": 6, "stream_underrun_margin_s": -0.1288, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.8862, "rtf": 0.5539, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1108, "ttfa_whole_s": 0.8862, "ttfa_clause_split_s": 0.7741, "stream_ttfa_s": 0.2143, "stream_total_s": 1.1065, "stream_chunks": 4, "stream_underrun_margin_s": -0.1127, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.28, "proc_s": 0.6921, "rtf": 0.5407, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.1153, "ttfa_whole_s": 0.6921, "ttfa_clause_split_s": 0.8484, "stream_ttfa_s": 0.2455, "stream_total_s": 0.8677, "stream_chunks": 4, "stream_underrun_margin_s": -0.0952, "stream_audio_s": 1.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.76, "proc_s": 1.1122, "rtf": 0.632, "audio_s_per_word": 0.2933, "latency_s_per_word": 0.1854, "ttfa_whole_s": 1.1122, "ttfa_clause_split_s": 0.7569, "stream_ttfa_s": 0.2192, "stream_total_s": 1.3548, "stream_chunks": 5, "stream_underrun_margin_s": -0.1334, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 1.0129, "rtf": 0.6029, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1688, "ttfa_whole_s": 1.0129, "ttfa_clause_split_s": 0.6955, "stream_ttfa_s": 0.215, "stream_total_s": 1.0403, "stream_chunks": 4, "stream_underrun_margin_s": -0.1198, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.9127, "rtf": 0.5433, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1014, "ttfa_whole_s": 0.9127, "ttfa_clause_split_s": 0.8002, "stream_ttfa_s": 0.3252, "stream_total_s": 1.219, "stream_chunks": 5, "stream_underrun_margin_s": -0.1114, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.659, "rtf": 0.5925, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1383, "ttfa_whole_s": 1.659, "ttfa_clause_split_s": 1.2467, "stream_ttfa_s": 0.2168, "stream_total_s": 1.8606, "stream_chunks": 7, "stream_underrun_margin_s": -0.1004, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.215, "rtf": 0.5062, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1012, "ttfa_whole_s": 1.215, "ttfa_clause_split_s": 0.2805, "stream_ttfa_s": 0.2563, "stream_total_s": 1.6292, "stream_chunks": 6, "stream_underrun_margin_s": -0.0961, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.04, "proc_s": 1.6404, "rtf": 0.5396, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1262, "ttfa_whole_s": 1.6404, "ttfa_clause_split_s": 0.5134, "stream_ttfa_s": 0.25, "stream_total_s": 1.8187, "stream_chunks": 7, "stream_underrun_margin_s": -0.1291, "stream_audio_s": 3.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.3548, "rtf": 0.4981, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1232, "ttfa_whole_s": 1.3548, "ttfa_clause_split_s": 0.534, "stream_ttfa_s": 0.2535, "stream_total_s": 2.0283, "stream_chunks": 7, "stream_underrun_margin_s": -0.0435, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.6182, "rtf": 0.613, "audio_s_per_word": 0.1886, "latency_s_per_word": 0.1156, "ttfa_whole_s": 1.6182, "ttfa_clause_split_s": 0.8271, "stream_ttfa_s": 0.2426, "stream_total_s": 1.9972, "stream_chunks": 7, "stream_underrun_margin_s": -0.0094, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.7297, "rtf": 0.7207, "audio_s_per_word": 0.24, "latency_s_per_word": 0.173, "ttfa_whole_s": 1.7297, "ttfa_clause_split_s": 0.8492, "stream_ttfa_s": 0.2524, "stream_total_s": 1.8289, "stream_chunks": 7, "stream_underrun_margin_s": 0.0078, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.6283, "rtf": 0.5987, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.148, "ttfa_whole_s": 1.6283, "ttfa_clause_split_s": 0.4403, "stream_ttfa_s": 0.3449, "stream_total_s": 1.9148, "stream_chunks": 6, "stream_underrun_margin_s": -0.0887, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.2248, "rtf": 0.4503, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0875, "ttfa_whole_s": 1.2248, "ttfa_clause_split_s": 0.9486, "stream_ttfa_s": 0.3029, "stream_total_s": 2.0966, "stream_chunks": 7, "stream_underrun_margin_s": -0.127, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.8402, "rtf": 0.697, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1416, "ttfa_whole_s": 1.8402, "ttfa_clause_split_s": 1.6977, "stream_ttfa_s": 0.2501, "stream_total_s": 1.7382, "stream_chunks": 6, "stream_underrun_margin_s": -0.1158, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.8715, "rtf": 0.6684, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.144, "ttfa_whole_s": 1.8715, "ttfa_clause_split_s": 1.3598, "stream_ttfa_s": 0.2316, "stream_total_s": 2.0071, "stream_chunks": 7, "stream_underrun_margin_s": -0.0995, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.2556, "rtf": 0.5412, "audio_s_per_word": 0.1785, "latency_s_per_word": 0.0966, "ttfa_whole_s": 1.2556, "ttfa_clause_split_s": 1.79, "stream_ttfa_s": 0.3677, "stream_total_s": 1.9891, "stream_chunks": 7, "stream_underrun_margin_s": 0.074, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.5085, "rtf": 0.5387, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1077, "ttfa_whole_s": 1.5085, "ttfa_clause_split_s": 1.4004, "stream_ttfa_s": 0.2486, "stream_total_s": 1.9716, "stream_chunks": 7, "stream_underrun_margin_s": -0.0945, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.559, "rtf": 0.609, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1417, "ttfa_whole_s": 1.559, "ttfa_clause_split_s": 1.5103, "stream_ttfa_s": 0.2623, "stream_total_s": 1.924, "stream_chunks": 7, "stream_underrun_margin_s": -0.1201, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.0051, "rtf": 0.6962, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1671, "ttfa_whole_s": 2.0051, "ttfa_clause_split_s": 0.7623, "stream_ttfa_s": 0.3407, "stream_total_s": 2.713, "stream_chunks": 9, "stream_underrun_margin_s": 0.0204, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.3568, "rtf": 0.53, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1044, "ttfa_whole_s": 1.3568, "ttfa_clause_split_s": 0.531, "stream_ttfa_s": 0.2448, "stream_total_s": 2.2438, "stream_chunks": 8, "stream_underrun_margin_s": -0.0493, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.16, "proc_s": 2.3875, "rtf": 0.5739, "audio_s_per_word": 0.1981, "latency_s_per_word": 0.1137, "ttfa_whole_s": 2.3875, "ttfa_clause_split_s": 0.7295, "stream_ttfa_s": 0.3453, "stream_total_s": 2.9787, "stream_chunks": 9, "stream_underrun_margin_s": -0.0624, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.64, "proc_s": 2.7543, "rtf": 0.5936, "audio_s_per_word": 0.221, "latency_s_per_word": 0.1312, "ttfa_whole_s": 2.7543, "ttfa_clause_split_s": 0.5803, "stream_ttfa_s": 0.2821, "stream_total_s": 3.3512, "stream_chunks": 10, "stream_underrun_margin_s": -0.1019, "stream_audio_s": 4.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.16, "proc_s": 2.716, "rtf": 0.6529, "audio_s_per_word": 0.2189, "latency_s_per_word": 0.1429, "ttfa_whole_s": 2.716, "ttfa_clause_split_s": 1.1911, "stream_ttfa_s": 0.227, "stream_total_s": 2.5131, "stream_chunks": 8, "stream_underrun_margin_s": -0.1046, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.24, "proc_s": 2.9653, "rtf": 0.6994, "audio_s_per_word": 0.2019, "latency_s_per_word": 0.1412, "ttfa_whole_s": 2.9653, "ttfa_clause_split_s": 0.8561, "stream_ttfa_s": 0.3171, "stream_total_s": 3.1555, "stream_chunks": 10, "stream_underrun_margin_s": -0.0963, "stream_audio_s": 4.24}
