{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 2.7896, "rtf": 0.8718, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1993, "ttfa_whole_s": 2.7896, "ttfa_clause_split_s": 1.9557}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.0463, "rtf": 0.7523, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.186, "ttfa_whole_s": 2.0463, "ttfa_clause_split_s": 2.4808}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.9718, "rtf": 0.7951, "audio_s_per_word": 0.1771, "latency_s_per_word": 0.1408, "ttfa_whole_s": 1.9718, "ttfa_clause_split_s": 2.4135}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.9401, "rtf": 0.7349, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1764, "ttfa_whole_s": 1.9401, "ttfa_clause_split_s": 2.6569}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.6245, "rtf": 0.7252, "audio_s_per_word": 0.2036, "latency_s_per_word": 0.1477, "ttfa_whole_s": 1.6245, "ttfa_clause_split_s": 1.4488}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.9802, "rtf": 0.8535, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.18, "ttfa_whole_s": 1.9802, "ttfa_clause_split_s": 1.4115}
