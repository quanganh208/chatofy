{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.28, "proc_s": 2.6745, "rtf": 0.8154, "audio_s_per_word": 0.2343, "latency_s_per_word": 0.191, "ttfa_whole_s": 2.6745, "ttfa_clause_split_s": 2.6573}
