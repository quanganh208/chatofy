{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.04, "proc_s": 0.5272, "rtf": 0.5069, "audio_s_per_word": 0.208, "latency_s_per_word": 0.1054, "ttfa_whole_s": 0.5272, "ttfa_clause_split_s": 0.546, "stream_ttfa_s": 0.204, "stream_total_s": 0.7278, "stream_chunks": 4, "stream_underrun_margin_s": -0.0631, "stream_audio_s": 1.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.6489, "rtf": 0.4771, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0927, "ttfa_whole_s": 0.6489, "ttfa_clause_split_s": 0.7859, "stream_ttfa_s": 0.21, "stream_total_s": 0.7173, "stream_chunks": 4, "stream_underrun_margin_s": -0.111, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.16, "proc_s": 0.9933, "rtf": 0.4599, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1104, "ttfa_whole_s": 0.9933, "ttfa_clause_split_s": 0.2608, "stream_ttfa_s": 0.2568, "stream_total_s": 1.3194, "stream_chunks": 5, "stream_underrun_margin_s": -0.1163, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.8518, "rtf": 0.5324, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1065, "ttfa_whole_s": 0.8518, "ttfa_clause_split_s": 0.7995, "stream_ttfa_s": 0.1965, "stream_total_s": 0.9051, "stream_chunks": 4, "stream_underrun_margin_s": -0.1261, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.28, "proc_s": 0.5948, "rtf": 0.4647, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.0991, "ttfa_whole_s": 0.5948, "ttfa_clause_split_s": 0.7299, "stream_ttfa_s": 0.2188, "stream_total_s": 0.7166, "stream_chunks": 4, "stream_underrun_margin_s": -0.1443, "stream_audio_s": 1.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.76, "proc_s": 1.0646, "rtf": 0.6049, "audio_s_per_word": 0.2933, "latency_s_per_word": 0.1774, "ttfa_whole_s": 1.0646, "ttfa_clause_split_s": 0.7223, "stream_ttfa_s": 0.1897, "stream_total_s": 1.0238, "stream_chunks": 5, "stream_underrun_margin_s": -0.1105, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.8018, "rtf": 0.4773, "audio_s_per_word": 0.28, "latency_s_per_word": 0.1336, "ttfa_whole_s": 0.8018, "ttfa_clause_split_s": 0.7229, "stream_ttfa_s": 0.2312, "stream_total_s": 0.9654, "stream_chunks": 4, "stream_underrun_margin_s": -0.1288, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.68, "proc_s": 0.9579, "rtf": 0.5702, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1064, "ttfa_whole_s": 0.9579, "ttfa_clause_split_s": 0.7855, "stream_ttfa_s": 0.2209, "stream_total_s": 1.0414, "stream_chunks": 5, "stream_underrun_margin_s": -0.1329, "stream_audio_s": 1.68}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.8, "proc_s": 1.3312, "rtf": 0.4754, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1109, "ttfa_whole_s": 1.3312, "ttfa_clause_split_s": 1.604, "stream_ttfa_s": 0.2392, "stream_total_s": 1.6406, "stream_chunks": 6, "stream_underrun_margin_s": -0.0978, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.0037, "rtf": 0.4182, "audio_s_per_word": 0.2, "latency_s_per_word": 0.0836, "ttfa_whole_s": 1.0037, "ttfa_clause_split_s": 0.3389, "stream_ttfa_s": 0.2504, "stream_total_s": 1.5404, "stream_chunks": 6, "stream_underrun_margin_s": -0.0865, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.04, "proc_s": 1.8173, "rtf": 0.5978, "audio_s_per_word": 0.2338, "latency_s_per_word": 0.1398, "ttfa_whole_s": 1.8173, "ttfa_clause_split_s": 0.4068, "stream_ttfa_s": 0.2294, "stream_total_s": 1.7548, "stream_chunks": 7, "stream_underrun_margin_s": -0.1271, "stream_audio_s": 3.04}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.281, "rtf": 0.4709, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1165, "ttfa_whole_s": 1.281, "ttfa_clause_split_s": 0.7809, "stream_ttfa_s": 0.2199, "stream_total_s": 1.4089, "stream_chunks": 6, "stream_underrun_margin_s": -0.1547, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.64, "proc_s": 1.1371, "rtf": 0.4307, "audio_s_per_word": 0.1886, "latency_s_per_word": 0.0812, "ttfa_whole_s": 1.1371, "ttfa_clause_split_s": 0.9141, "stream_ttfa_s": 0.2949, "stream_total_s": 1.6077, "stream_chunks": 6, "stream_underrun_margin_s": -0.1286, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.1309, "rtf": 0.4712, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1131, "ttfa_whole_s": 1.1309, "ttfa_clause_split_s": 0.6702, "stream_ttfa_s": 0.2128, "stream_total_s": 1.29, "stream_chunks": 6, "stream_underrun_margin_s": -0.1308, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.5735, "rtf": 0.5785, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.143, "ttfa_whole_s": 1.5735, "ttfa_clause_split_s": 0.4719, "stream_ttfa_s": 0.25, "stream_total_s": 1.5129, "stream_chunks": 6, "stream_underrun_margin_s": -0.1197, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.2931, "rtf": 0.4754, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.0924, "ttfa_whole_s": 1.2931, "ttfa_clause_split_s": 0.5395, "stream_ttfa_s": 0.2111, "stream_total_s": 1.8474, "stream_chunks": 6, "stream_underrun_margin_s": -0.1084, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.64, "proc_s": 1.5929, "rtf": 0.6034, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1225, "ttfa_whole_s": 1.5929, "ttfa_clause_split_s": 1.5371, "stream_ttfa_s": 0.245, "stream_total_s": 1.5558, "stream_chunks": 6, "stream_underrun_margin_s": -0.1098, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.3864, "rtf": 0.4951, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1066, "ttfa_whole_s": 1.3864, "ttfa_clause_split_s": 0.819, "stream_ttfa_s": 0.2209, "stream_total_s": 1.6118, "stream_chunks": 6, "stream_underrun_margin_s": -0.1107, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.1851, "rtf": 0.5108, "audio_s_per_word": 0.1785, "latency_s_per_word": 0.0912, "ttfa_whole_s": 1.1851, "ttfa_clause_split_s": 1.3745, "stream_ttfa_s": 0.2006, "stream_total_s": 1.3186, "stream_chunks": 6, "stream_underrun_margin_s": -0.1489, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 1.2506, "rtf": 0.4467, "audio_s_per_word": 0.2, "latency_s_per_word": 0.0893, "ttfa_whole_s": 1.2506, "ttfa_clause_split_s": 0.953, "stream_ttfa_s": 0.3209, "stream_total_s": 1.6858, "stream_chunks": 7, "stream_underrun_margin_s": -0.0965, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.2879, "rtf": 0.5031, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.1171, "ttfa_whole_s": 1.2879, "ttfa_clause_split_s": 1.2829, "stream_ttfa_s": 0.2473, "stream_total_s": 1.4267, "stream_chunks": 6, "stream_underrun_margin_s": -0.1404, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.4875, "rtf": 0.5165, "audio_s_per_word": 0.24, "latency_s_per_word": 0.124, "ttfa_whole_s": 1.4875, "ttfa_clause_split_s": 0.6333, "stream_ttfa_s": 0.2451, "stream_total_s": 1.6908, "stream_chunks": 6, "stream_underrun_margin_s": -0.0594, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.4784, "rtf": 0.5775, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1137, "ttfa_whole_s": 1.4784, "ttfa_clause_split_s": 0.4374, "stream_ttfa_s": 0.2136, "stream_total_s": 1.3789, "stream_chunks": 6, "stream_underrun_margin_s": -0.1314, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.16, "proc_s": 2.1498, "rtf": 0.5168, "audio_s_per_word": 0.1981, "latency_s_per_word": 0.1024, "ttfa_whole_s": 2.1498, "ttfa_clause_split_s": 0.5473, "stream_ttfa_s": 0.3334, "stream_total_s": 2.6833, "stream_chunks": 9, "stream_underrun_margin_s": -0.0588, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.64, "proc_s": 2.3928, "rtf": 0.5157, "audio_s_per_word": 0.221, "latency_s_per_word": 0.1139, "ttfa_whole_s": 2.3928, "ttfa_clause_split_s": 0.4984, "stream_ttfa_s": 0.3218, "stream_total_s": 2.6878, "stream_chunks": 8, "stream_underrun_margin_s": -0.1215, "stream_audio_s": 4.64}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.16, "proc_s": 1.8531, "rtf": 0.4455, "audio_s_per_word": 0.2189, "latency_s_per_word": 0.0975, "ttfa_whole_s": 1.8531, "ttfa_clause_split_s": 1.1973, "stream_ttfa_s": 0.2169, "stream_total_s": 2.1286, "stream_chunks": 7, "stream_underrun_margin_s": -0.1129, "stream_audio_s": 4.16}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.24, "proc_s": 2.1919, "rtf": 0.517, "audio_s_per_word": 0.2019, "latency_s_per_word": 0.1044, "ttfa_whole_s": 2.1919, "ttfa_clause_split_s": 1.0584, "stream_ttfa_s": 0.2833, "stream_total_s": 2.3776, "stream_chunks": 8, "stream_underrun_margin_s": -0.1143, "stream_audio_s": 4.24}
