{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 3.04, "proc_s": 3.7722, "rtf": 1.2409, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.3144, "ttfa_whole_s": 3.7722, "ttfa_clause_split_s": 3.7447}
