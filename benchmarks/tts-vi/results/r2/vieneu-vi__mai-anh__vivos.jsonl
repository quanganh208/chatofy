{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 2.5288, "rtf": 0.7351, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.1806, "ttfa_whole_s": 2.5288, "ttfa_clause_split_s": 2.9776}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.8813, "rtf": 0.7586, "audio_s_per_word": 0.2255, "latency_s_per_word": 0.171, "ttfa_whole_s": 1.8813, "ttfa_clause_split_s": 2.0792}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.44, "proc_s": 2.9529, "rtf": 0.8584, "audio_s_per_word": 0.2457, "latency_s_per_word": 0.2109, "ttfa_whole_s": 2.9529, "ttfa_clause_split_s": 6.0163}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.56, "proc_s": 2.8045, "rtf": 1.0955, "audio_s_per_word": 0.2327, "latency_s_per_word": 0.255, "ttfa_whole_s": 2.8045, "ttfa_clause_split_s": 1.4772}
