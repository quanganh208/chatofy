{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.4667, "rtf": 0.9344, "audio_s_per_word": 0.24, "latency_s_per_word": 0.2242, "ttfa_whole_s": 2.4667, "ttfa_clause_split_s": 1.5079, "stream_ttfa_s": 0.1409, "stream_total_s": 2.4214, "stream_chunks": 6, "stream_underrun_margin_s": 0.9205, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 3.0288, "rtf": 0.9708, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.2163, "ttfa_whole_s": 3.0288, "ttfa_clause_split_s": 1.5012, "stream_ttfa_s": 0.1649, "stream_total_s": 3.0093, "stream_chunks": 6, "stream_underrun_margin_s": 1.1003, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.4, "proc_s": 1.9968, "rtf": 0.832, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1997, "ttfa_whole_s": 1.9968, "ttfa_clause_split_s": 1.5873, "stream_ttfa_s": 0.1405, "stream_total_s": 2.1954, "stream_chunks": 5, "stream_underrun_margin_s": 0.854, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.6111, "rtf": 0.9599, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.2374, "ttfa_whole_s": 2.6111, "ttfa_clause_split_s": 1.0091, "stream_ttfa_s": 0.1541, "stream_total_s": 2.5822, "stream_chunks": 6, "stream_underrun_margin_s": 0.98, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.12, "proc_s": 3.5701, "rtf": 1.1443, "audio_s_per_word": 0.2229, "latency_s_per_word": 0.255, "ttfa_whole_s": 3.5701, "ttfa_clause_split_s": 1.011, "stream_ttfa_s": 0.1447, "stream_total_s": 3.0114, "stream_chunks": 6, "stream_underrun_margin_s": 0.971, "stream_audio_s": 3.12}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.56, "proc_s": 2.3911, "rtf": 0.934, "audio_s_per_word": 0.1969, "latency_s_per_word": 0.1839, "ttfa_whole_s": 2.3911, "ttfa_clause_split_s": 2.3215, "stream_ttfa_s": 0.2773, "stream_total_s": 2.6282, "stream_chunks": 6, "stream_underrun_margin_s": 1.0558, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.6948, "rtf": 0.9357, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.2073, "ttfa_whole_s": 2.6948, "ttfa_clause_split_s": 1.7504, "stream_ttfa_s": 0.1317, "stream_total_s": 2.6511, "stream_chunks": 6, "stream_underrun_margin_s": 0.9412, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.5975, "rtf": 0.9277, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1998, "ttfa_whole_s": 2.5975, "ttfa_clause_split_s": 2.3424, "stream_ttfa_s": 0.1297, "stream_total_s": 2.7111, "stream_chunks": 6, "stream_underrun_margin_s": 1.0872, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.2327, "rtf": 0.7974, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1595, "ttfa_whole_s": 2.2327, "ttfa_clause_split_s": 1.8033, "stream_ttfa_s": 0.1291, "stream_total_s": 2.4138, "stream_chunks": 6, "stream_underrun_margin_s": 0.8083, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.8106, "rtf": 0.7804, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1646, "ttfa_whole_s": 1.8106, "ttfa_clause_split_s": 1.9097, "stream_ttfa_s": 0.1372, "stream_total_s": 2.0916, "stream_chunks": 5, "stream_underrun_margin_s": 0.7536, "stream_audio_s": 2.32}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.3709, "rtf": 0.8467, "audio_s_per_word": 0.2333, "latency_s_per_word": 0.1976, "ttfa_whole_s": 2.3709, "ttfa_clause_split_s": 1.0589, "stream_ttfa_s": 0.1531, "stream_total_s": 2.5471, "stream_chunks": 6, "stream_underrun_margin_s": 0.9109, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.88, "proc_s": 2.3072, "rtf": 0.8011, "audio_s_per_word": 0.2215, "latency_s_per_word": 0.1775, "ttfa_whole_s": 2.3072, "ttfa_clause_split_s": 0.798, "stream_ttfa_s": 0.1548, "stream_total_s": 2.4761, "stream_chunks": 6, "stream_underrun_margin_s": 0.7745, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.92, "proc_s": 2.9226, "rtf": 0.7456, "audio_s_per_word": 0.1867, "latency_s_per_word": 0.1392, "ttfa_whole_s": 2.9226, "ttfa_clause_split_s": 0.8373, "stream_ttfa_s": 0.1486, "stream_total_s": 3.5757, "stream_chunks": 7, "stream_underrun_margin_s": 0.9745, "stream_audio_s": 3.92}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.4, "proc_s": 3.8077, "rtf": 0.8654, "audio_s_per_word": 0.2095, "latency_s_per_word": 0.1813, "ttfa_whole_s": 3.8077, "ttfa_clause_split_s": 1.0346, "stream_ttfa_s": 0.1515, "stream_total_s": 3.9058, "stream_chunks": 7, "stream_underrun_margin_s": 0.9572, "stream_audio_s": 4.4}
