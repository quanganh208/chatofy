{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.4648, "rtf": 0.7961, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.1628, "ttfa_whole_s": 1.4648, "ttfa_clause_split_s": 1.3203, "stream_ttfa_s": 0.1286, "stream_total_s": 1.9034, "stream_chunks": 5, "stream_underrun_margin_s": 0.6987, "stream_audio_s": 1.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.48, "proc_s": 2.442, "rtf": 0.9847, "audio_s_per_word": 0.2067, "latency_s_per_word": 0.2035, "ttfa_whole_s": 2.442, "ttfa_clause_split_s": 1.9873, "stream_ttfa_s": 0.1329, "stream_total_s": 2.5811, "stream_chunks": 5, "stream_underrun_margin_s": 1.2447, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "baotrang", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.9694, "rtf": 1.0917, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.2474, "ttfa_whole_s": 2.9694, "ttfa_clause_split_s": 0.6778, "stream_ttfa_s": 0.1509, "stream_total_s": 2.7799, "stream_chunks": 6, "stream_underrun_margin_s": 1.2096, "stream_audio_s": 2.72}
