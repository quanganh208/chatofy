{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_203", "text": "Còn anh trai tôi trong nhật ký của mình cũng linh cảm điều đó", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 3.2246, "rtf": 1.0077, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.2303, "ttfa_whole_s": 3.2246, "ttfa_clause_split_s": 2.2379}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_209", "text": "Họ thích nghi với văn hóa công ty như thế nào", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.557, "rtf": 0.5724, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1415, "ttfa_whole_s": 1.557, "ttfa_clause_split_s": 2.0343}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV15_220", "text": "Đây là tháng có số đăng ký thấp nhất từ đầu năm đến nay", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 2.48, "proc_s": 1.7435, "rtf": 0.703, "audio_s_per_word": 0.1771, "latency_s_per_word": 0.1245, "ttfa_whole_s": 1.7435, "ttfa_clause_split_s": 2.926}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_058", "text": "Đầu tư tiêu dùng và xuất khẩu đều sẽ tăng mạnh", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.64, "proc_s": 3.7675, "rtf": 1.4271, "audio_s_per_word": 0.24, "latency_s_per_word": 0.3425, "ttfa_whole_s": 3.7675, "ttfa_clause_split_s": 2.5492}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV16_064", "text": "Từng là chủ tế hàng trăm lễ an táng mộ gió", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.5876, "rtf": 0.7088, "audio_s_per_word": 0.2036, "latency_s_per_word": 0.1443, "ttfa_whole_s": 1.5876, "ttfa_clause_split_s": 1.37}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_071", "text": "Bản thân tôi cũng tham gia một vai rất nhỏ nữa", "tags": ["vivos"], "n_words": 11, "n_clauses": 1, "audio_s": 2.32, "proc_s": 1.7621, "rtf": 0.7595, "audio_s_per_word": 0.2109, "latency_s_per_word": 0.1602, "ttfa_whole_s": 1.7621, "ttfa_clause_split_s": 2.1038}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_099", "text": "Chị tìm nhà cho em ở trọ ngay cổng trường chị học", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.88, "proc_s": 3.0577, "rtf": 1.0617, "audio_s_per_word": 0.24, "latency_s_per_word": 0.2548, "ttfa_whole_s": 3.0577, "ttfa_clause_split_s": 2.1548}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV17_297", "text": "Trong dòng thác người chỉ nhìn được mắt kính và khẩu trang", "tags": ["vivos"], "n_words": 12, "n_clauses": 1, "audio_s": 2.56, "proc_s": 1.5857, "rtf": 0.6194, "audio_s_per_word": 0.2133, "latency_s_per_word": 0.1321, "ttfa_whole_s": 1.5857, "ttfa_clause_split_s": 2.1551}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "thanh-bình", "sentence_set": "vivos", "sentence_id": "vivos-VIVOSDEV18_126", "text": "Vài lần triển lãm tranh tượng không lời như thế hắn sẽ nhận ra", "tags": ["vivos"], "n_words": 14, "n_clauses": 1, "audio_s": 3.2, "proc_s": 2.0825, "rtf": 0.6508, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1488, "ttfa_whole_s": 2.0825, "ttfa_clause_split_s": 2.2358}
