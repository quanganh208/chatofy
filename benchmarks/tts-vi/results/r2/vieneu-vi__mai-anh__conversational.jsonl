{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-004", "text": "Tính tiền giúp tôi nhé.", "tags": ["short"], "n_words": 5, "n_clauses": 1, "audio_s": 1.36, "proc_s": 0.6151, "rtf": 0.4523, "audio_s_per_word": 0.272, "latency_s_per_word": 0.123, "ttfa_whole_s": 0.6151, "ttfa_clause_split_s": 0.6429, "stream_ttfa_s": 0.207, "stream_total_s": 0.8853, "stream_chunks": 4, "stream_underrun_margin_s": 0.0116, "stream_audio_s": 1.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-005", "text": "Cái này có giảm giá không ạ?", "tags": ["short"], "n_words": 7, "n_clauses": 1, "audio_s": 1.76, "proc_s": 0.8457, "rtf": 0.4805, "audio_s_per_word": 0.2514, "latency_s_per_word": 0.1208, "ttfa_whole_s": 0.8457, "ttfa_clause_split_s": 0.7834, "stream_ttfa_s": 0.1926, "stream_total_s": 1.0792, "stream_chunks": 5, "stream_underrun_margin_s": -0.1223, "stream_audio_s": 1.76}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-006", "text": "Tôi không hiểu, anh nói chậm lại được không?", "tags": ["short"], "n_words": 9, "n_clauses": 2, "audio_s": 2.48, "proc_s": 1.2087, "rtf": 0.4874, "audio_s_per_word": 0.2756, "latency_s_per_word": 0.1343, "ttfa_whole_s": 1.2087, "ttfa_clause_split_s": 0.5036, "stream_ttfa_s": 0.3325, "stream_total_s": 1.5506, "stream_chunks": 6, "stream_underrun_margin_s": -0.1233, "stream_audio_s": 2.48}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-007", "text": "Ở đây có chỗ đậu xe không ạ?", "tags": ["short"], "n_words": 8, "n_clauses": 1, "audio_s": 1.92, "proc_s": 0.8921, "rtf": 0.4646, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1115, "ttfa_whole_s": 0.8921, "ttfa_clause_split_s": 0.935, "stream_ttfa_s": 0.1979, "stream_total_s": 1.0642, "stream_chunks": 5, "stream_underrun_margin_s": -0.116, "stream_audio_s": 1.92}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-008", "text": "Bao giờ thì quán đóng cửa?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.6, "proc_s": 0.9325, "rtf": 0.5828, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.1554, "ttfa_whole_s": 0.9325, "ttfa_clause_split_s": 0.7636, "stream_ttfa_s": 0.1976, "stream_total_s": 0.8841, "stream_chunks": 4, "stream_underrun_margin_s": -0.1166, "stream_audio_s": 1.6}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-009", "text": "Cho tôi thêm một đôi đũa.", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.7128, "rtf": 0.469, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.1188, "ttfa_whole_s": 0.7128, "ttfa_clause_split_s": 0.8383, "stream_ttfa_s": 0.193, "stream_total_s": 0.8471, "stream_chunks": 4, "stream_underrun_margin_s": -0.1245, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-010", "text": "Món này có cay không ạ?", "tags": ["short"], "n_words": 6, "n_clauses": 1, "audio_s": 1.52, "proc_s": 0.7209, "rtf": 0.4743, "audio_s_per_word": 0.2533, "latency_s_per_word": 0.1201, "ttfa_whole_s": 0.7209, "ttfa_clause_split_s": 0.8832, "stream_ttfa_s": 0.2106, "stream_total_s": 0.8148, "stream_chunks": 4, "stream_underrun_margin_s": -0.1353, "stream_audio_s": 1.52}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 2.24, "proc_s": 1.2045, "rtf": 0.5377, "audio_s_per_word": 0.2489, "latency_s_per_word": 0.1338, "ttfa_whole_s": 1.2045, "ttfa_clause_split_s": 1.009, "stream_ttfa_s": 0.2526, "stream_total_s": 1.4486, "stream_chunks": 6, "stream_underrun_margin_s": -0.0722, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.5113, "rtf": 0.5556, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1259, "ttfa_whole_s": 1.5113, "ttfa_clause_split_s": 1.316, "stream_ttfa_s": 0.2381, "stream_total_s": 1.6954, "stream_chunks": 6, "stream_underrun_margin_s": -0.1071, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.72, "proc_s": 1.6787, "rtf": 0.6172, "audio_s_per_word": 0.2267, "latency_s_per_word": 0.1399, "ttfa_whole_s": 1.6787, "ttfa_clause_split_s": 0.38, "stream_ttfa_s": 0.2322, "stream_total_s": 1.6952, "stream_chunks": 6, "stream_underrun_margin_s": -0.1314, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 1.6873, "rtf": 0.5022, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1298, "ttfa_whole_s": 1.6873, "ttfa_clause_split_s": 0.5924, "stream_ttfa_s": 0.2926, "stream_total_s": 2.045, "stream_chunks": 7, "stream_underrun_margin_s": -0.0903, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.96, "proc_s": 1.5354, "rtf": 0.5187, "audio_s_per_word": 0.2691, "latency_s_per_word": 0.1396, "ttfa_whole_s": 1.5354, "ttfa_clause_split_s": 0.6566, "stream_ttfa_s": 0.2489, "stream_total_s": 2.1423, "stream_chunks": 8, "stream_underrun_margin_s": -0.0409, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.36, "proc_s": 2.1624, "rtf": 0.6436, "audio_s_per_word": 0.24, "latency_s_per_word": 0.1545, "ttfa_whole_s": 2.1624, "ttfa_clause_split_s": 0.8179, "stream_ttfa_s": 0.2477, "stream_total_s": 2.2139, "stream_chunks": 7, "stream_underrun_margin_s": -0.1188, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.56, "proc_s": 1.3052, "rtf": 0.5098, "audio_s_per_word": 0.256, "latency_s_per_word": 0.1305, "ttfa_whole_s": 1.3052, "ttfa_clause_split_s": 0.9821, "stream_ttfa_s": 0.1909, "stream_total_s": 1.286, "stream_chunks": 6, "stream_underrun_margin_s": -0.1279, "stream_audio_s": 2.56}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.88, "proc_s": 1.4803, "rtf": 0.514, "audio_s_per_word": 0.2618, "latency_s_per_word": 0.1346, "ttfa_whole_s": 1.4803, "ttfa_clause_split_s": 0.5221, "stream_ttfa_s": 0.2482, "stream_total_s": 1.8139, "stream_chunks": 6, "stream_underrun_margin_s": -0.111, "stream_audio_s": 2.88}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.84, "proc_s": 2.4414, "rtf": 0.6358, "audio_s_per_word": 0.2743, "latency_s_per_word": 0.1744, "ttfa_whole_s": 2.4414, "ttfa_clause_split_s": 0.843, "stream_ttfa_s": 0.2421, "stream_total_s": 2.3102, "stream_chunks": 8, "stream_underrun_margin_s": -0.1119, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.28, "proc_s": 1.5896, "rtf": 0.4846, "audio_s_per_word": 0.2523, "latency_s_per_word": 0.1223, "ttfa_whole_s": 1.5896, "ttfa_clause_split_s": 1.911, "stream_ttfa_s": 0.2583, "stream_total_s": 2.5653, "stream_chunks": 8, "stream_underrun_margin_s": -0.0793, "stream_audio_s": 3.28}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.36, "proc_s": 2.0482, "rtf": 0.6096, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1576, "ttfa_whole_s": 2.0482, "ttfa_clause_split_s": 1.2287, "stream_ttfa_s": 0.3613, "stream_total_s": 2.288, "stream_chunks": 8, "stream_underrun_margin_s": -0.0677, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 3.36, "proc_s": 1.8004, "rtf": 0.5358, "audio_s_per_word": 0.2585, "latency_s_per_word": 0.1385, "ttfa_whole_s": 1.8004, "ttfa_clause_split_s": 2.1003, "stream_ttfa_s": 0.3697, "stream_total_s": 2.327, "stream_chunks": 8, "stream_underrun_margin_s": -0.0289, "stream_audio_s": 3.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 3.2, "proc_s": 2.2833, "rtf": 0.7135, "audio_s_per_word": 0.2286, "latency_s_per_word": 0.1631, "ttfa_whole_s": 2.2833, "ttfa_clause_split_s": 1.4597, "stream_ttfa_s": 0.2692, "stream_total_s": 2.4826, "stream_chunks": 8, "stream_underrun_margin_s": -0.0157, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.72, "proc_s": 1.8524, "rtf": 0.681, "audio_s_per_word": 0.2473, "latency_s_per_word": 0.1684, "ttfa_whole_s": 1.8524, "ttfa_clause_split_s": 1.8921, "stream_ttfa_s": 0.2231, "stream_total_s": 1.8649, "stream_chunks": 7, "stream_underrun_margin_s": -0.1177, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 3.2, "proc_s": 2.958, "rtf": 0.9244, "audio_s_per_word": 0.2667, "latency_s_per_word": 0.2465, "ttfa_whole_s": 2.958, "ttfa_clause_split_s": 0.7327, "stream_ttfa_s": 0.2591, "stream_total_s": 3.0048, "stream_chunks": 10, "stream_underrun_margin_s": 0.1178, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 3.2, "proc_s": 1.8521, "rtf": 0.5788, "audio_s_per_word": 0.2462, "latency_s_per_word": 0.1425, "ttfa_whole_s": 1.8521, "ttfa_clause_split_s": 1.0641, "stream_ttfa_s": 0.3116, "stream_total_s": 1.8923, "stream_chunks": 7, "stream_underrun_margin_s": -0.0781, "stream_audio_s": 3.2}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.96, "proc_s": 3.5948, "rtf": 0.7248, "audio_s_per_word": 0.2362, "latency_s_per_word": 0.1712, "ttfa_whole_s": 3.5948, "ttfa_clause_split_s": 0.7206, "stream_ttfa_s": 0.3404, "stream_total_s": 3.9191, "stream_chunks": 12, "stream_underrun_margin_s": 0.2627, "stream_audio_s": 4.96}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.36, "proc_s": 3.3408, "rtf": 0.6233, "audio_s_per_word": 0.2552, "latency_s_per_word": 0.1591, "ttfa_whole_s": 3.3408, "ttfa_clause_split_s": 0.7146, "stream_ttfa_s": 0.2853, "stream_total_s": 3.6591, "stream_chunks": 12, "stream_underrun_margin_s": 0.0435, "stream_audio_s": 5.36}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-029", "text": "Chuyến bay của tôi bị hoãn đến tận khuya, nên tôi cần gia hạn phòng thêm một đêm nữa.", "tags": ["long"], "n_words": 19, "n_clauses": 2, "audio_s": 4.72, "proc_s": 3.5946, "rtf": 0.7616, "audio_s_per_word": 0.2484, "latency_s_per_word": 0.1892, "ttfa_whole_s": 3.5946, "ttfa_clause_split_s": 0.994, "stream_ttfa_s": 0.2282, "stream_total_s": 3.5304, "stream_chunks": 10, "stream_underrun_margin_s": -0.1215, "stream_audio_s": 4.72}
{"type": "sentence", "engine": "vieneu-vi", "voice_slug": "mai-anh", "sentence_set": "conversational", "sentence_id": "conv-030", "text": "Tôi muốn hỏi về thủ tục hoàn tiền, vì món hàng tôi nhận được không giống với mô tả trên mạng.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 5.2, "proc_s": 3.2764, "rtf": 0.6301, "audio_s_per_word": 0.2476, "latency_s_per_word": 0.156, "ttfa_whole_s": 3.2764, "ttfa_clause_split_s": 1.4141, "stream_ttfa_s": 0.2372, "stream_total_s": 3.3097, "stream_chunks": 9, "stream_underrun_margin_s": -0.1105, "stream_audio_s": 5.2}
