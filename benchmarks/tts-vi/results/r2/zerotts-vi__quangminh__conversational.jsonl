{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-011", "text": "Anh chụp giúp tôi một tấm ảnh được không?", "tags": ["short"], "n_words": 9, "n_clauses": 1, "audio_s": 1.84, "proc_s": 1.5413, "rtf": 0.8376, "audio_s_per_word": 0.2044, "latency_s_per_word": 0.1713, "ttfa_whole_s": 1.5413, "ttfa_clause_split_s": 1.4885, "stream_ttfa_s": 0.1375, "stream_total_s": 1.7674, "stream_chunks": 5, "stream_underrun_margin_s": 0.4289, "stream_audio_s": 1.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-012", "text": "Tôi muốn đặt một bàn hai người lúc bảy giờ tối nay.", "tags": ["medium"], "n_words": 12, "n_clauses": 1, "audio_s": 2.4, "proc_s": 2.0413, "rtf": 0.8506, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1701, "ttfa_whole_s": 2.0413, "ttfa_clause_split_s": 2.8668, "stream_ttfa_s": 0.1737, "stream_total_s": 2.6302, "stream_chunks": 5, "stream_underrun_margin_s": 1.2554, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-013", "text": "Xin lỗi, cho hỏi ga tàu điện gần nhất ở đâu ạ?", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.0025, "rtf": 0.8344, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1669, "ttfa_whole_s": 2.0025, "ttfa_clause_split_s": 0.7017, "stream_ttfa_s": 0.1842, "stream_total_s": 2.6421, "stream_chunks": 5, "stream_underrun_margin_s": 1.2569, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-014", "text": "Tôi bị lạc đường, anh chỉ giúp tôi đường về khách sạn nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.345, "rtf": 0.8883, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1804, "ttfa_whole_s": 2.345, "ttfa_clause_split_s": 0.8615, "stream_ttfa_s": 0.1424, "stream_total_s": 2.7834, "stream_chunks": 6, "stream_underrun_margin_s": 1.2576, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-015", "text": "Cảm ơn chị rất nhiều, chúc chị một ngày tốt lành.", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.1129, "rtf": 0.8804, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1921, "ttfa_whole_s": 2.1129, "ttfa_clause_split_s": 1.1309, "stream_ttfa_s": 0.1599, "stream_total_s": 2.3929, "stream_chunks": 5, "stream_underrun_margin_s": 1.032, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-016", "text": "Phòng này giá bao nhiêu một đêm, đã bao gồm ăn sáng chưa ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.8, "proc_s": 2.7492, "rtf": 0.9818, "audio_s_per_word": 0.2, "latency_s_per_word": 0.1964, "ttfa_whole_s": 2.7492, "ttfa_clause_split_s": 1.3418, "stream_ttfa_s": 0.1412, "stream_total_s": 2.6584, "stream_chunks": 6, "stream_underrun_margin_s": 1.0005, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-017", "text": "Tôi muốn đổi sang phòng khác, phòng này hơi ồn.", "tags": ["medium"], "n_words": 10, "n_clauses": 2, "audio_s": 2.24, "proc_s": 1.8945, "rtf": 0.8458, "audio_s_per_word": 0.224, "latency_s_per_word": 0.1895, "ttfa_whole_s": 1.8945, "ttfa_clause_split_s": 1.1301, "stream_ttfa_s": 0.1343, "stream_total_s": 2.2685, "stream_chunks": 5, "stream_underrun_margin_s": 0.9328, "stream_audio_s": 2.24}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-018", "text": "Cho tôi hỏi, chuyến xe cuối cùng chạy lúc mấy giờ?", "tags": ["medium"], "n_words": 11, "n_clauses": 2, "audio_s": 2.4, "proc_s": 2.0722, "rtf": 0.8634, "audio_s_per_word": 0.2182, "latency_s_per_word": 0.1884, "ttfa_whole_s": 2.0722, "ttfa_clause_split_s": 0.8129, "stream_ttfa_s": 0.148, "stream_total_s": 2.3092, "stream_chunks": 5, "stream_underrun_margin_s": 0.9595, "stream_audio_s": 2.4}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-019", "text": "Tôi dị ứng với hải sản, nhờ anh báo với nhà bếp giúp tôi.", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.4647, "rtf": 0.8327, "audio_s_per_word": 0.2114, "latency_s_per_word": 0.176, "ttfa_whole_s": 2.4647, "ttfa_clause_split_s": 1.0226, "stream_ttfa_s": 0.1497, "stream_total_s": 2.5682, "stream_chunks": 6, "stream_underrun_margin_s": 0.8111, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-020", "text": "Anh có biết gần đây có hiệu thuốc nào còn mở cửa không?", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.72, "proc_s": 2.1768, "rtf": 0.8003, "audio_s_per_word": 0.2092, "latency_s_per_word": 0.1674, "ttfa_whole_s": 2.1768, "ttfa_clause_split_s": 2.2788, "stream_ttfa_s": 0.1461, "stream_total_s": 2.4909, "stream_chunks": 6, "stream_underrun_margin_s": 0.918, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-021", "text": "Tôi để quên điện thoại trong phòng, nhờ anh mở cửa giúp tôi.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.1784, "rtf": 0.8252, "audio_s_per_word": 0.2031, "latency_s_per_word": 0.1676, "ttfa_whole_s": 2.1784, "ttfa_clause_split_s": 1.2225, "stream_ttfa_s": 0.1442, "stream_total_s": 2.6176, "stream_chunks": 6, "stream_underrun_margin_s": 1.1151, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-022", "text": "Nếu trời mưa thì chúng ta hoãn chuyến đi sang ngày mai nhé.", "tags": ["medium"], "n_words": 13, "n_clauses": 1, "audio_s": 2.8, "proc_s": 2.2918, "rtf": 0.8185, "audio_s_per_word": 0.2154, "latency_s_per_word": 0.1763, "ttfa_whole_s": 2.2918, "ttfa_clause_split_s": 2.4216, "stream_ttfa_s": 0.1532, "stream_total_s": 2.6839, "stream_chunks": 6, "stream_underrun_margin_s": 1.0224, "stream_audio_s": 2.8}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-023", "text": "Tôi muốn gửi hành lý ở đây đến chiều nay, có được không ạ?", "tags": ["medium"], "n_words": 14, "n_clauses": 2, "audio_s": 2.72, "proc_s": 2.2091, "rtf": 0.8122, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.1578, "ttfa_whole_s": 2.2091, "ttfa_clause_split_s": 1.7246, "stream_ttfa_s": 0.1449, "stream_total_s": 2.6614, "stream_chunks": 6, "stream_underrun_margin_s": 1.0842, "stream_audio_s": 2.72}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-024", "text": "Cho tôi hai vé người lớn và một vé trẻ em.", "tags": ["medium"], "n_words": 11, "n_clauses": 1, "audio_s": 2.16, "proc_s": 1.6959, "rtf": 0.7851, "audio_s_per_word": 0.1964, "latency_s_per_word": 0.1542, "ttfa_whole_s": 1.6959, "ttfa_clause_split_s": 1.7003, "stream_ttfa_s": 0.1476, "stream_total_s": 2.002, "stream_chunks": 5, "stream_underrun_margin_s": 0.6535, "stream_audio_s": 2.16}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-025", "text": "Tôi đã thanh toán rồi, nhưng vẫn chưa nhận được hóa đơn.", "tags": ["medium"], "n_words": 12, "n_clauses": 2, "audio_s": 2.64, "proc_s": 2.384, "rtf": 0.903, "audio_s_per_word": 0.22, "latency_s_per_word": 0.1987, "ttfa_whole_s": 2.384, "ttfa_clause_split_s": 0.9611, "stream_ttfa_s": 0.1711, "stream_total_s": 2.4657, "stream_chunks": 6, "stream_underrun_margin_s": 0.9234, "stream_audio_s": 2.64}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-026", "text": "Đường này đang tắc, anh đi vòng qua lối kia sẽ nhanh hơn.", "tags": ["medium"], "n_words": 13, "n_clauses": 2, "audio_s": 2.96, "proc_s": 2.5021, "rtf": 0.8453, "audio_s_per_word": 0.2277, "latency_s_per_word": 0.1925, "ttfa_whole_s": 2.5021, "ttfa_clause_split_s": 0.8423, "stream_ttfa_s": 0.143, "stream_total_s": 2.7303, "stream_chunks": 6, "stream_underrun_margin_s": 0.934, "stream_audio_s": 2.96}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-027", "text": "Tôi đến đây lần đầu, nên anh gợi ý giúp tôi vài món ăn đặc trưng của vùng này được không?", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 3.84, "proc_s": 3.6141, "rtf": 0.9412, "audio_s_per_word": 0.1829, "latency_s_per_word": 0.1721, "ttfa_whole_s": 3.6141, "ttfa_clause_split_s": 0.9745, "stream_ttfa_s": 0.1684, "stream_total_s": 3.8764, "stream_chunks": 7, "stream_underrun_margin_s": 1.2057, "stream_audio_s": 3.84}
{"type": "sentence", "engine": "zerotts-vi", "voice_slug": "quangminh", "sentence_set": "conversational", "sentence_id": "conv-028", "text": "Nếu anh không phiền, cho tôi xin số điện thoại của khách sạn để lát nữa tôi gọi lại xác nhận.", "tags": ["long"], "n_words": 21, "n_clauses": 2, "audio_s": 4.08, "proc_s": 4.2331, "rtf": 1.0375, "audio_s_per_word": 0.1943, "latency_s_per_word": 0.2016, "ttfa_whole_s": 4.2331, "ttfa_clause_split_s": 0.8848, "stream_ttfa_s": 0.1715, "stream_total_s": 4.3793, "stream_chunks": 7, "stream_underrun_margin_s": 1.3279, "stream_audio_s": 4.08}
