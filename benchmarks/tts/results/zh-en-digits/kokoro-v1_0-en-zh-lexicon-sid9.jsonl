{"type": "sentence", "engine": "kokoro-v1_0-en-zh-lexicon-sid9", "sentence_id": "s001", "text": "The meeting starts at 10:30 tomorrow morning.", "n_words": 7, "audio_s": 2.488, "n_samples": 59710, "proc_s": 0.5269, "rtf": 0.2118, "samples_sha256": "1982cf6b64338eff7295a6ed889e8b53ac89f5bd0689f4339f9f439bee07e105"}
