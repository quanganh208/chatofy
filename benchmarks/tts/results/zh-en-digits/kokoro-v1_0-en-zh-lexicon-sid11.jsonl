{"type": "sentence", "engine": "kokoro-v1_0-en-zh-lexicon-sid11", "sentence_id": "s001", "text": "The meeting starts at 10:30 tomorrow morning.", "n_words": 7, "audio_s": 2.448, "n_samples": 58762, "proc_s": 0.4851, "rtf": 0.1981, "samples_sha256": "edf0a9085af73ec106fc17e0f2397392d17daa8f41a9814e6a9415c8c6890c1d"}
