{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid11", "sentence_id": "s001", "text": "The meeting starts at 10:30 tomorrow morning.", "n_words": 7, "audio_s": 2.449, "n_samples": 58771, "proc_s": 0.4841, "rtf": 0.1977, "samples_sha256": "5e1be20076f8bdb8998c5ae6612df8e9d00cc9726a368fc3c8178c905c26512b"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid11", "sentence_id": "s002", "text": "Let's move the call to 3:45 in the afternoon.", "n_words": 9, "audio_s": 2.957, "n_samples": 70978, "proc_s": 0.7249, "rtf": 0.2451, "samples_sha256": "26c40218a724775193aca0a5a6412ab6ae96ef93cbae0ab31a4fa1dbd325ff70"}
