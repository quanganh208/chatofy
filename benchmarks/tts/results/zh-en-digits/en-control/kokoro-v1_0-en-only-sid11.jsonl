{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid11", "sentence_id": "s005", "text": "She was born in 1998 and moved here in 2015.", "n_words": 10, "audio_s": 3.982, "n_samples": 95580, "proc_s": 0.9206, "rtf": 0.2312, "samples_sha256": "93a7f09b6a4a16d54e4829eb4b1d1a7270e69da17d72307eb8629c039ede432f"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid11", "sentence_id": "s006", "text": "The company was founded in 1976.", "n_words": 6, "audio_s": 2.932, "n_samples": 70366, "proc_s": 0.6641, "rtf": 0.2265, "samples_sha256": "f5b63ca799919709b365783cda433a05fff0751dae9f95d61ee0c863a5c30fd9"}
