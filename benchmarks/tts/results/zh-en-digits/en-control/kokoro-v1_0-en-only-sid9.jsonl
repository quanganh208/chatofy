{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s001", "text": "The meeting starts at 10:30 tomorrow morning.", "n_words": 7, "audio_s": 2.488, "n_samples": 59710, "proc_s": 0.6054, "rtf": 0.2433, "samples_sha256": "13046fe2a6c7a41c819edcc665f5a65d29ea3a2cc2028eef4d5cee1bc9f8f194"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s002", "text": "Let's move the call to 3:45 in the afternoon.", "n_words": 9, "audio_s": 3.07, "n_samples": 73678, "proc_s": 0.7416, "rtf": 0.2416, "samples_sha256": "98b123a1969376951b627b1866a11af7563ea22dc1c43c011a2654acb74fdeb1"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s003", "text": "The ticket costs $15.99 including tax.", "n_words": 6, "audio_s": 3.527, "n_samples": 84651, "proc_s": 0.7977, "rtf": 0.2262, "samples_sha256": "9f3eac14634d1d8304c1099088fc60ec52fbb81734d0bd79ff6cdedca214b1c9"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s004", "text": "We spent about 2,500 dollars on the trip.", "n_words": 8, "audio_s": 3.174, "n_samples": 76164, "proc_s": 0.979, "rtf": 0.3085, "samples_sha256": "e5387749dbe3290fe4b7bb2a78b94427017439323b5c8fe3b0b831e3d6a6d72b"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s005", "text": "She was born in 1998 and moved here in 2015.", "n_words": 10, "audio_s": 4.088, "n_samples": 98115, "proc_s": 1.2717, "rtf": 0.3111, "samples_sha256": "6d0a463f329c9ad5b772ccfff5d6bd900c3f0bfa9cf882dd7f5d33400359ef7f"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s006", "text": "The company was founded in 1976.", "n_words": 6, "audio_s": 2.972, "n_samples": 71328, "proc_s": 1.2953, "rtf": 0.4358, "samples_sha256": "e5fcd6fb1c09fb27aa63afd611e5c95eab6a79b095535a8d9b098da7df3cb67b"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s007", "text": "Please go to room 402 on the fourth floor.", "n_words": 9, "audio_s": 2.87, "n_samples": 68884, "proc_s": 0.9309, "rtf": 0.3243, "samples_sha256": "e7d19bee516929e139a208397518ff80cdbdfc6fcfd29eedf25b42b8433e8f97"}
