{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s009", "text": "Sales grew by 15% last quarter.", "n_words": 6, "audio_s": 2.501, "n_samples": 60021, "proc_s": 0.8071, "rtf": 0.3227, "samples_sha256": "ebfdc73d48a25ee5ffdc526cd41d9ffb370605d518f433b5c5e41ed1ed911d1d"}
{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid9", "sentence_id": "s010", "text": "Only 3.5 percent of users opted out.", "n_words": 7, "audio_s": 2.88, "n_samples": 69123, "proc_s": 0.7992, "rtf": 0.2775, "samples_sha256": "76bd261c7a376552db47e471fcb835ecf16dde6b1680cbdd6cb57ba1eea3920e"}
