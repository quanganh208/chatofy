{"type": "sentence", "engine": "kokoro-v1_0-en-only-sid11", "sentence_id": "s001", "text": "The meeting starts at 10:30 tomorrow morning.", "n_words": 7, "audio_s": 2.448, "n_samples": 58756, "proc_s": 0.5552, "rtf": 0.2268, "samples_sha256": "8ac0de878bb45fba2652cb201777cd61e21e6392a8b8b3ac81dc501c6468feb7"}
