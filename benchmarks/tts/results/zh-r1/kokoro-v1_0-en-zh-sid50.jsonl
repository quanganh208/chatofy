{"type": "sentence", "engine": "kokoro-v1_0-en-zh-sid50", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 2.614, "n_samples": 62743, "proc_s": 0.7872, "rtf": 0.3011, "samples_sha256": "0a88fe3521c9ffe6c0f43b547650298f296612d842ce248c9bba005d11f62067"}
