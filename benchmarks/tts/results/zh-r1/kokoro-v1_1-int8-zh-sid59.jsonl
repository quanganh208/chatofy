{"type": "header", "engine": "kokoro-v1_1-int8-zh-sid59", "load_s": 1.203, "peak_rss_mb": 499.5, "num_sentences": 30, "decode_params": {"model": "k2-fsa/sherpa-onnx tts-models/kokoro-int8-multi-lang-v1_1.tar.bz2", "model_file": "model.int8.onnx", "lexicons": ["lexicon-us-en.txt", "lexicon-zh.txt"], "rule_fsts": ["date-zh.fst", "phone-zh.fst", "number-zh.fst"], "sid": 59, "speaker": "zm_010", "speed": 1.0, "num_threads": 4}}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s001", "text": "你好，今天的会议改到下午3点半开始。", "n_words": 1, "audio_s": 3.898, "n_samples": 93542, "proc_s": 5.2173, "rtf": 1.3386, "samples_sha256": "f4c9069473e9e437f5acb41cecb1b9535460024f4bd4879524e64ee1b22eef38"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s002", "text": "我刚买了一部新的iPhone，用起来很顺手。", "n_words": 1, "audio_s": 4.33, "n_samples": 103913, "proc_s": 5.8149, "rtf": 1.343, "samples_sha256": "8534f8ccae3c33a2e2478479f27c7421ad71e2572ebda61c95b802d38487ce69"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s003", "text": "这件衣服打折以后只要128元。", "n_words": 1, "audio_s": 3.346, "n_samples": 80298, "proc_s": 4.1143, "rtf": 1.2297, "samples_sha256": "771a96c7c79cda0391864c4a1b9e9079ab4a927850a598327aa3859c7604afce"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s004", "text": "我们约在2026年10月20日见面吧。", "n_words": 1, "audio_s": 3.422, "n_samples": 82138, "proc_s": 4.0385, "rtf": 1.18, "samples_sha256": "1d4d7c037da7d51f2c406b9ab4e1d9c87417a84ef481cc13acedbbae3f5e0b02"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s005", "text": "请把报告在周五之前发给我。", "n_words": 1, "audio_s": 2.89, "n_samples": 69360, "proc_s": 3.4225, "rtf": 1.1843, "samples_sha256": "a0320d3ce068c2c86b1f8c35a884f605c093ea68583fd148b3ecf04d337edfc9"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s006", "text": "现在的AI工具越来越好用了。", "n_words": 1, "audio_s": 3.543, "n_samples": 85039, "proc_s": 4.3365, "rtf": 1.2239, "samples_sha256": "8de8a45ef4d81825966eebf628f2b09729b52ff77ea9f3f798eb49892c38041c"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s007", "text": "你的航班几点起飞？我记得是早上8点20分。", "n_words": 1, "audio_s": 4.64, "n_samples": 111368, "proc_s": 5.9224, "rtf": 1.2763, "samples_sha256": "b6fcd5818fc69992dc69cf24cff1b3ae8db82f76abdc209a7f0f44ef03470058"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s008", "text": "这个月的电费一共是356块钱。", "n_words": 1, "audio_s": 3.402, "n_samples": 81646, "proc_s": 4.2684, "rtf": 1.2547, "samples_sha256": "6e6abfc06c26f72bffa7eb86d8b6c10efc91db96df01252c15b80d2aa4ab5513"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s009", "text": "我住在3楼，电梯就在门口右边。", "n_words": 1, "audio_s": 3.577, "n_samples": 85839, "proc_s": 4.5584, "rtf": 1.2745, "samples_sha256": "952b96ec015a967ee8e66e27cbbe600c9b3b11fb11e3f2ea82b476d8a1423e2c"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s010", "text": "他每天跑步5公里，已经坚持了两年。", "n_words": 1, "audio_s": 3.752, "n_samples": 90041, "proc_s": 4.9147, "rtf": 1.31, "samples_sha256": "05a9218a9e97ca473e11af759d42e152e9cfd12e2ef01e50df514546e43f72f1"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s011", "text": "下周一我们要去上海出差。", "n_words": 1, "audio_s": 2.766, "n_samples": 66393, "proc_s": 3.3838, "rtf": 1.2232, "samples_sha256": "ef136571170cba1a06fb5e1c0c9483b34d1453b8816d398fcee940148f54a2a9"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s012", "text": "你能帮我订一张明天去北京的高铁票吗？", "n_words": 1, "audio_s": 3.8, "n_samples": 91194, "proc_s": 4.2683, "rtf": 1.1233, "samples_sha256": "4fd477d3c1ad23b2b9bf3c482831cb89a162e7770548a9b1c75a4933f724d034"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s013", "text": "这家餐厅的评分是4.8分，值得一试。", "n_words": 1, "audio_s": 3.933, "n_samples": 94396, "proc_s": 5.2173, "rtf": 1.3265, "samples_sha256": "62744e48ada56c4fb729b254e0f6d31e01e35cae19211123e9a4a3bebc6ba07b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s014", "text": "我的手机号是13812345678，有事打给我。", "n_words": 1, "audio_s": 4.903, "n_samples": 117670, "proc_s": 6.4007, "rtf": 1.3055, "samples_sha256": "97751e0ccbe5ae9d01e29c2e82c2ba920ab25361b3bd793e1842adc67f0380cb"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s015", "text": "今年公司的销售额增长了15%。", "n_words": 1, "audio_s": 2.941, "n_samples": 70577, "proc_s": 3.7157, "rtf": 1.2635, "samples_sha256": "c85072a4c3bc0c82a7c7d1a269f475863ed0cf3be644c62c8dad6c451a262844"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s016", "text": "孩子们放学以后在公园里踢足球。", "n_words": 1, "audio_s": 3.12, "n_samples": 74869, "proc_s": 3.9399, "rtf": 1.263, "samples_sha256": "7c41e8d177d319202c4b87f366c327007030d0c86d5c167c0084087153e73c1e"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s017", "text": "我用微信给你转了2000块，记得查收。", "n_words": 1, "audio_s": 3.834, "n_samples": 92009, "proc_s": 5.2101, "rtf": 1.359, "samples_sha256": "63d820488fc50b8998102e4c8298258df0292874808e86b2931a1a654fad39a0"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s018", "text": "天气预报说明天最高气温32度。", "n_words": 1, "audio_s": 3.309, "n_samples": 79418, "proc_s": 4.1403, "rtf": 1.2512, "samples_sha256": "4ab85054a3f5526a731f430b1708a2ff68cf5c4362ee0cca2fc27fe1620b812b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s019", "text": "请问洗手间在哪里？", "n_words": 1, "audio_s": 2.131, "n_samples": 51146, "proc_s": 3.1479, "rtf": 1.4771, "samples_sha256": "e1c25dda42b89d9b25b37afc034bdc7f08c23a285dee07d887e20548148c5c18"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s020", "text": "我们的Zoom会议链接已经发到群里了。", "n_words": 1, "audio_s": 3.765, "n_samples": 90365, "proc_s": 5.3006, "rtf": 1.4078, "samples_sha256": "b65e6fc32e9aa46a07a947379f10460cae7e33dabc458e80295354e3d5d35593"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s021", "text": "这本书我看了一半，故事特别精彩。", "n_words": 1, "audio_s": 3.654, "n_samples": 87701, "proc_s": 4.9103, "rtf": 1.3437, "samples_sha256": "ad1cc25084af6fd1eccc15edb2075afc4515d289b3139b76b2e89328e2724d8a"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s022", "text": "他的生日是5月4日，我们准备给他一个惊喜。", "n_words": 1, "audio_s": 4.522, "n_samples": 108531, "proc_s": 5.7254, "rtf": 1.2661, "samples_sha256": "0242af770334dae8318adf64a9df917efbf3440759e9cd76c86cac6c41d3f27e"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s023", "text": "从这里打车到机场大概需要40分钟。", "n_words": 1, "audio_s": 3.517, "n_samples": 84416, "proc_s": 4.3159, "rtf": 1.227, "samples_sha256": "d650a73679c9382dcc4811acff8d0b88747d9aa49f42cec713e3f7fda5366942"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s024", "text": "我刚下载了ChatGPT的新版本。", "n_words": 1, "audio_s": 3.802, "n_samples": 91252, "proc_s": 5.5519, "rtf": 1.4602, "samples_sha256": "144d634ebd6f38ab1531d8f1f3464ef3a33e994b3cb9e5015626c3dbd1920796"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s025", "text": "房租每个月涨了500元，真让人头疼。", "n_words": 1, "audio_s": 3.825, "n_samples": 91810, "proc_s": 5.1416, "rtf": 1.344, "samples_sha256": "1020b8fa06e146866ee2816e8b3b0d1422757307f465d6e2f415b60b76157172"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 2.96, "n_samples": 71040, "proc_s": 3.9885, "rtf": 1.3475, "samples_sha256": "d74a2d607a05caeb66a66057bcd6cb85ba7c769b8cf772e8ced254650b88b912"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s027", "text": "这台笔记本电脑的价格是6999元。", "n_words": 1, "audio_s": 4.148, "n_samples": 99558, "proc_s": 5.0943, "rtf": 1.2281, "samples_sha256": "751b690c19249875ef757bf65ea52ab9d36cb18f30e079c7a7b60e70ecdbd28b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s028", "text": "医生建议我每天喝8杯水。", "n_words": 1, "audio_s": 2.638, "n_samples": 63323, "proc_s": 3.4686, "rtf": 1.3146, "samples_sha256": "06c31dd2228f2e4b46eb334d285ccffd0b84b6b02ad5e8bdfe0ad13b443d822d"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s029", "text": "我们团队一共有12个人，分成3个小组。", "n_words": 1, "audio_s": 4.158, "n_samples": 99782, "proc_s": 5.4151, "rtf": 1.3025, "samples_sha256": "236f714c5d65b475e1485a32d5b724b4a6b258266a877f1c94de69d17e72dbad"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid59", "sentence_id": "s030", "text": "谢谢你的帮忙，下次我请你喝咖啡。", "n_words": 1, "audio_s": 3.574, "n_samples": 85778, "proc_s": 4.9109, "rtf": 1.374, "samples_sha256": "de7a350f6d8f5074a40170dbc8c780b34bc72f17a77faf3cc96c843ea83a09f2"}
