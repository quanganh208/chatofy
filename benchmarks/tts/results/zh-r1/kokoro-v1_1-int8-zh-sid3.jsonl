{"type": "header", "engine": "kokoro-v1_1-int8-zh-sid3", "load_s": 1.116, "peak_rss_mb": 499.3, "num_sentences": 30, "decode_params": {"model": "k2-fsa/sherpa-onnx tts-models/kokoro-int8-multi-lang-v1_1.tar.bz2", "model_file": "model.int8.onnx", "lexicons": ["lexicon-us-en.txt", "lexicon-zh.txt"], "rule_fsts": ["date-zh.fst", "phone-zh.fst", "number-zh.fst"], "sid": 3, "speaker": "zf_001", "speed": 1.0, "num_threads": 4}}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s001", "text": "你好，今天的会议改到下午3点半开始。", "n_words": 1, "audio_s": 3.842, "n_samples": 92197, "proc_s": 4.5505, "rtf": 1.1846, "samples_sha256": "9921e548ae88631d9ea8a644751b007fe7b3b09f3209756806be119d8ddfdc19"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s002", "text": "我刚买了一部新的iPhone，用起来很顺手。", "n_words": 1, "audio_s": 4.205, "n_samples": 100927, "proc_s": 5.5264, "rtf": 1.3142, "samples_sha256": "bcb4b5987663cb755996e697c5338d50497f5f403b06e3a4774486053c6801a5"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s003", "text": "这件衣服打折以后只要128元。", "n_words": 1, "audio_s": 3.334, "n_samples": 80006, "proc_s": 3.9726, "rtf": 1.1917, "samples_sha256": "753042a3b149ca175d3797446981276c27e7f13fc20e6ddcaec08c212b435b81"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s004", "text": "我们约在2026年10月20日见面吧。", "n_words": 1, "audio_s": 3.498, "n_samples": 83958, "proc_s": 3.9358, "rtf": 1.1251, "samples_sha256": "a06dbeed9a0d77d57b0561d6ce485e197b1a4f82bc9e3fdadd87ca2623d2426b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s005", "text": "请把报告在周五之前发给我。", "n_words": 1, "audio_s": 2.925, "n_samples": 70190, "proc_s": 3.3725, "rtf": 1.1531, "samples_sha256": "c6e65b6de645231fb0c609fd37f81a9e1ce31d69968c464212a6afc6f19ca10a"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s006", "text": "现在的AI工具越来越好用了。", "n_words": 1, "audio_s": 3.356, "n_samples": 80549, "proc_s": 4.3463, "rtf": 1.295, "samples_sha256": "12843597ebc1ff13d1ba33e339c5891569e11472f0d345dc606c3d91a56ecf90"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s007", "text": "你的航班几点起飞？我记得是早上8点20分。", "n_words": 1, "audio_s": 4.493, "n_samples": 107839, "proc_s": 5.6869, "rtf": 1.2656, "samples_sha256": "3bb595c84ef057be560e3d1b09d74773bcb26e9c577f0d0b73596f7b691e449f"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s008", "text": "这个月的电费一共是356块钱。", "n_words": 1, "audio_s": 3.412, "n_samples": 81878, "proc_s": 4.0756, "rtf": 1.1946, "samples_sha256": "592bdc01356c17aecc1c6047301e144d4599e722dd10055bd7fa1f52ade2f124"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s009", "text": "我住在3楼，电梯就在门口右边。", "n_words": 1, "audio_s": 3.372, "n_samples": 80927, "proc_s": 4.4399, "rtf": 1.3167, "samples_sha256": "430343ba98f79341d3c1d6e30caa7ab0ad5dc493db0d7a2ce7605ab9466a70af"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s010", "text": "他每天跑步5公里，已经坚持了两年。", "n_words": 1, "audio_s": 3.601, "n_samples": 86422, "proc_s": 4.5863, "rtf": 1.2736, "samples_sha256": "0dd506259987dda30a8298ccc8c0f7dad23a363d9ce2779fedd3e0a7be9b0bb8"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s011", "text": "下周一我们要去上海出差。", "n_words": 1, "audio_s": 2.613, "n_samples": 62720, "proc_s": 3.1437, "rtf": 1.203, "samples_sha256": "92757ee3628a04f2ab3be007200b4e4c96a2a2c5abc3e90df129da9791d43f0d"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s012", "text": "你能帮我订一张明天去北京的高铁票吗？", "n_words": 1, "audio_s": 3.602, "n_samples": 86452, "proc_s": 4.0144, "rtf": 1.1144, "samples_sha256": "3c8f6392ea249c773a87e7844a4f0a09a509225e64fd8aa8fc73fc297f91960b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s013", "text": "这家餐厅的评分是4.8分，值得一试。", "n_words": 1, "audio_s": 3.958, "n_samples": 94994, "proc_s": 5.0164, "rtf": 1.2674, "samples_sha256": "8aec89e32b551eef02178258dccf303ad5f24aaffd02a4b70575fb5e3ea1a926"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s014", "text": "我的手机号是13812345678，有事打给我。", "n_words": 1, "audio_s": 4.836, "n_samples": 116058, "proc_s": 6.0893, "rtf": 1.2592, "samples_sha256": "4c452bb03b38081404e51bb2823f4f4b05f48d54fd4d3da2729fc88eec35b802"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s015", "text": "今年公司的销售额增长了15%。", "n_words": 1, "audio_s": 2.991, "n_samples": 71790, "proc_s": 3.6618, "rtf": 1.2242, "samples_sha256": "7e54ea564620a8716006559cde8bc4fb9147629b64805fa02ea3c028166f1d9b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s016", "text": "孩子们放学以后在公园里踢足球。", "n_words": 1, "audio_s": 3.132, "n_samples": 75168, "proc_s": 3.7964, "rtf": 1.2121, "samples_sha256": "53ed7cf9f22cfe7b838a3c5caa8ea8731e1b3c97f508454658065b06ae5b5714"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s017", "text": "我用微信给你转了2000块，记得查收。", "n_words": 1, "audio_s": 3.617, "n_samples": 86807, "proc_s": 4.726, "rtf": 1.3066, "samples_sha256": "8c0fd27f9a703e650c67fb287f21c6ed02751f6fb71ecea8af85dacafaa17a2e"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s018", "text": "天气预报说明天最高气温32度。", "n_words": 1, "audio_s": 3.224, "n_samples": 77365, "proc_s": 3.9383, "rtf": 1.2217, "samples_sha256": "18e385acf7277c98a5cbc8e7853dc9eb6185830034d175f245d52855a9d30a1b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s019", "text": "请问洗手间在哪里？", "n_words": 1, "audio_s": 2.04, "n_samples": 48970, "proc_s": 2.5246, "rtf": 1.2373, "samples_sha256": "342d6b9504b3fb0abb0f3856c40bc6803e117980ab46175f33f4a01503143cc6"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s020", "text": "我们的Zoom会议链接已经发到群里了。", "n_words": 1, "audio_s": 3.416, "n_samples": 81990, "proc_s": 4.4075, "rtf": 1.2902, "samples_sha256": "010f4bedd1535969d3d17ec0dd277eef23b637664e4fb4ccefcd107f42be8bd0"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s021", "text": "这本书我看了一半，故事特别精彩。", "n_words": 1, "audio_s": 3.558, "n_samples": 85394, "proc_s": 4.6375, "rtf": 1.3034, "samples_sha256": "c0e330532a715a2c989d194b9155ee7dbaff7f3d26030f7745255daf1d3fc693"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s022", "text": "他的生日是5月4日，我们准备给他一个惊喜。", "n_words": 1, "audio_s": 4.275, "n_samples": 102596, "proc_s": 5.285, "rtf": 1.2363, "samples_sha256": "bbbd7a49ff326ea6367616d1d53ad1e034795ae60ff0de8946137a458fb872d5"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s023", "text": "从这里打车到机场大概需要40分钟。", "n_words": 1, "audio_s": 3.467, "n_samples": 83210, "proc_s": 4.1583, "rtf": 1.1994, "samples_sha256": "5b27b818998032885c49a2dc6e8a6d1353053d1d59c9962a7eed3ebbf178d3a7"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s024", "text": "我刚下载了ChatGPT的新版本。", "n_words": 1, "audio_s": 3.743, "n_samples": 89831, "proc_s": 5.3416, "rtf": 1.4271, "samples_sha256": "0273f035bc870e950783925151f272a40657713353ae8f4691cfcd4640d84728"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s025", "text": "房租每个月涨了500元，真让人头疼。", "n_words": 1, "audio_s": 3.709, "n_samples": 89006, "proc_s": 4.8002, "rtf": 1.2944, "samples_sha256": "90ec8c06965a10041524f595805594fa9047d3869b2a4c3eb071824213b8c55a"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 2.898, "n_samples": 69562, "proc_s": 3.7314, "rtf": 1.2874, "samples_sha256": "51b3258817d2c547416f960614d449af50e1891459625fcf2cda279a8e882280"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s027", "text": "这台笔记本电脑的价格是6999元。", "n_words": 1, "audio_s": 4.131, "n_samples": 99154, "proc_s": 5.075, "rtf": 1.2284, "samples_sha256": "babe4d15d55f17c4abec4d8a8da929708c52763e3b938957f727456573339923"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s028", "text": "医生建议我每天喝8杯水。", "n_words": 1, "audio_s": 2.627, "n_samples": 63044, "proc_s": 3.3294, "rtf": 1.2675, "samples_sha256": "1bb4198ef247a8c4b7850a6562bdf2dde60a14375c1e29d02ab3bbceb289bce7"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s029", "text": "我们团队一共有12个人，分成3个小组。", "n_words": 1, "audio_s": 4.024, "n_samples": 96579, "proc_s": 5.332, "rtf": 1.325, "samples_sha256": "8f9627e2c7f5f82deb869abb99ff2244c0a0026c14a6cba52ffbe816ec1ec519"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid3", "sentence_id": "s030", "text": "谢谢你的帮忙，下次我请你喝咖啡。", "n_words": 1, "audio_s": 3.59, "n_samples": 86160, "proc_s": 4.8068, "rtf": 1.3389, "samples_sha256": "6108acfbc6c6340efe6b2d12d88366c263d94b0cea7fddacfe551a7ad2c21bc8"}
