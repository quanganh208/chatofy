{"type": "header", "engine": "kokoro-v1_1-int8-zh-sid61", "load_s": 1.047, "peak_rss_mb": 504.6, "num_sentences": 30, "decode_params": {"model": "k2-fsa/sherpa-onnx tts-models/kokoro-int8-multi-lang-v1_1.tar.bz2", "model_file": "model.int8.onnx", "lexicons": ["lexicon-us-en.txt", "lexicon-zh.txt"], "rule_fsts": ["date-zh.fst", "phone-zh.fst", "number-zh.fst"], "sid": 61, "speaker": "zm_012", "speed": 1.0, "num_threads": 4}}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s001", "text": "你好，今天的会议改到下午3点半开始。", "n_words": 1, "audio_s": 3.9, "n_samples": 93591, "proc_s": 4.8485, "rtf": 1.2433, "samples_sha256": "fdf986334e0bb78592cfa0929269cede5002a0033df5f7408fee29cfe4267c9f"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s002", "text": "我刚买了一部新的iPhone，用起来很顺手。", "n_words": 1, "audio_s": 4.488, "n_samples": 107717, "proc_s": 5.5913, "rtf": 1.2458, "samples_sha256": "785c6d6c4bd32e80dcdba51ba78ed9b85695f72727dbdf37cdd3a8d0a7eedeb5"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s003", "text": "这件衣服打折以后只要128元。", "n_words": 1, "audio_s": 3.404, "n_samples": 81694, "proc_s": 3.8841, "rtf": 1.1411, "samples_sha256": "aaa676f48713dbe5ee1bd05e5ecbadf241dead76aec6fe598885cdcc01cbf5fd"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s004", "text": "我们约在2026年10月20日见面吧。", "n_words": 1, "audio_s": 3.51, "n_samples": 84251, "proc_s": 3.7843, "rtf": 1.078, "samples_sha256": "5fa22b9d3e10ad68bd2ad5e8bf3ddc446c18f3152d7989adcaf49e4560466686"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s005", "text": "请把报告在周五之前发给我。", "n_words": 1, "audio_s": 2.942, "n_samples": 70615, "proc_s": 3.6128, "rtf": 1.2279, "samples_sha256": "f2bc749e9f1c1cfcd1df0fe014479cc4e1232d0288a2f1b1740a2b12665fd8bd"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s006", "text": "现在的AI工具越来越好用了。", "n_words": 1, "audio_s": 3.632, "n_samples": 87178, "proc_s": 4.6464, "rtf": 1.2791, "samples_sha256": "20bd6a7c985a186497b4f3a2f97765f9ff0cd7f630667b06842a0c26c1a7ba8a"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s007", "text": "你的航班几点起飞？我记得是早上8点20分。", "n_words": 1, "audio_s": 4.668, "n_samples": 112022, "proc_s": 5.6373, "rtf": 1.2078, "samples_sha256": "0cae814c5de808e05bfdfd77d8bce4eaafbdcf3620ec140e2dbca74778caa12d"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s008", "text": "这个月的电费一共是356块钱。", "n_words": 1, "audio_s": 3.435, "n_samples": 82439, "proc_s": 4.0241, "rtf": 1.1715, "samples_sha256": "06ad7e5344e851d5b889f130f0f59446e90338408ff3826796b5edd4cc56c4f4"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s009", "text": "我住在3楼，电梯就在门口右边。", "n_words": 1, "audio_s": 3.714, "n_samples": 89136, "proc_s": 4.9162, "rtf": 1.3237, "samples_sha256": "b297b37784e5fe44c0d94c08a12f996402799a1c84ca774f1a05b31e4c58f37d"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s010", "text": "他每天跑步5公里，已经坚持了两年。", "n_words": 1, "audio_s": 3.855, "n_samples": 92522, "proc_s": 4.8627, "rtf": 1.2614, "samples_sha256": "0f978bf64346e3e5026821bcbf5ef5d0593cf603b03ccb948ca4977c554f5d86"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s011", "text": "下周一我们要去上海出差。", "n_words": 1, "audio_s": 2.838, "n_samples": 68104, "proc_s": 3.668, "rtf": 1.2926, "samples_sha256": "c3bf2f8d5f0386e459088fddaf6a3df7536c1c69118f7750508095c120b77268"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s012", "text": "你能帮我订一张明天去北京的高铁票吗？", "n_words": 1, "audio_s": 3.873, "n_samples": 92949, "proc_s": 4.315, "rtf": 1.1142, "samples_sha256": "ed5c170236cf56adcab052d3ac6bdfc15dea6c5623042cb6c75ee2578ccf4ec1"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s013", "text": "这家餐厅的评分是4.8分，值得一试。", "n_words": 1, "audio_s": 4.155, "n_samples": 99710, "proc_s": 5.454, "rtf": 1.3128, "samples_sha256": "d39046ec5997e871637dcac32163c1e85c600b8290fc4981a647baf50d9535f2"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s014", "text": "我的手机号是13812345678，有事打给我。", "n_words": 1, "audio_s": 4.983, "n_samples": 119597, "proc_s": 6.176, "rtf": 1.2394, "samples_sha256": "f9ac48a0d37edc61419dbe5826b9d2176e8f84e3c9b21a6743df4f678d33feb8"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s015", "text": "今年公司的销售额增长了15%。", "n_words": 1, "audio_s": 3.038, "n_samples": 72923, "proc_s": 3.667, "rtf": 1.2069, "samples_sha256": "ead536c0f01efceaf5d436f46fd742a896f9b8937e7873b47aa45c30cc7f2342"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s016", "text": "孩子们放学以后在公园里踢足球。", "n_words": 1, "audio_s": 3.224, "n_samples": 77368, "proc_s": 3.8734, "rtf": 1.2016, "samples_sha256": "0d8a3d8f363bfdf10a784b26e1e23bc24724ac14a50992c76bcdcc341a0bd1b9"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s017", "text": "我用微信给你转了2000块，记得查收。", "n_words": 1, "audio_s": 3.922, "n_samples": 94124, "proc_s": 4.7802, "rtf": 1.2189, "samples_sha256": "90252373d6b2068a90e54d4c1210a20fee5cf9cb27a13e4a988beb458ba4df32"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s018", "text": "天气预报说明天最高气温32度。", "n_words": 1, "audio_s": 3.352, "n_samples": 80440, "proc_s": 3.953, "rtf": 1.1794, "samples_sha256": "8d8e0176fbb7c6deda6fa16a3a0919e551ccfaa7d3d70f88d63296acef637899"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s019", "text": "请问洗手间在哪里？", "n_words": 1, "audio_s": 2.13, "n_samples": 51114, "proc_s": 2.7687, "rtf": 1.3, "samples_sha256": "fb0206e4570b074b9efa349de261264d1acefe5922fa7e223c1938ef98759edf"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s020", "text": "我们的Zoom会议链接已经发到群里了。", "n_words": 1, "audio_s": 3.881, "n_samples": 93132, "proc_s": 4.928, "rtf": 1.2699, "samples_sha256": "bab4ea14b093fc1660ce0cb72b400c49a88eb861b0812fc0e2b25eca4488276b"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s021", "text": "这本书我看了一半，故事特别精彩。", "n_words": 1, "audio_s": 3.787, "n_samples": 90880, "proc_s": 5.1881, "rtf": 1.3701, "samples_sha256": "8da5c64e8e53b5b77047a6302c5eb19680a37fa7852a6310eb867af1a0d58891"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s022", "text": "他的生日是5月4日，我们准备给他一个惊喜。", "n_words": 1, "audio_s": 4.872, "n_samples": 116923, "proc_s": 8.1226, "rtf": 1.6673, "samples_sha256": "f45d3cd7e82202e37dac12ff034df9eeefed2a21c96b1862209ad5d0b946f0eb"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s023", "text": "从这里打车到机场大概需要40分钟。", "n_words": 1, "audio_s": 3.682, "n_samples": 88361, "proc_s": 4.0882, "rtf": 1.1104, "samples_sha256": "b7a01797ea25436fb9d77fa411c4fd2175fedc56702d0f0e441a1ce9be990863"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s024", "text": "我刚下载了ChatGPT的新版本。", "n_words": 1, "audio_s": 3.895, "n_samples": 93483, "proc_s": 5.2545, "rtf": 1.349, "samples_sha256": "987e58e9d346bff8144d04521dee7f1cb865e65b75d9b572783459724d3eeb85"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s025", "text": "房租每个月涨了500元，真让人头疼。", "n_words": 1, "audio_s": 4.003, "n_samples": 96064, "proc_s": 4.9843, "rtf": 1.2453, "samples_sha256": "c46b20dd2c9aae6b9391912fbd7bad0b293dba89e6646f9f3dbe466a7a88ad5d"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 3.165, "n_samples": 75953, "proc_s": 3.6993, "rtf": 1.1689, "samples_sha256": "615134157a3abd25bd8c69074cbca8c48d51dfb47590b53c1338626b870e2c21"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s027", "text": "这台笔记本电脑的价格是6999元。", "n_words": 1, "audio_s": 4.412, "n_samples": 105896, "proc_s": 4.8833, "rtf": 1.1067, "samples_sha256": "35daed0f475f54d626898292ca87a531509de2002d9496ada1660aac6b4becef"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s028", "text": "医生建议我每天喝8杯水。", "n_words": 1, "audio_s": 2.818, "n_samples": 67640, "proc_s": 3.2204, "rtf": 1.1427, "samples_sha256": "752ad42b6fbec9e2b909dccaf07db80fcf576a426270ef9ecb35267644cb4781"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s029", "text": "我们团队一共有12个人，分成3个小组。", "n_words": 1, "audio_s": 4.343, "n_samples": 104227, "proc_s": 5.1836, "rtf": 1.1936, "samples_sha256": "4b95f8072d855d7a8c911f03900e91b172f81524cf2ae2aae9faa220806b23ea"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid61", "sentence_id": "s030", "text": "谢谢你的帮忙，下次我请你喝咖啡。", "n_words": 1, "audio_s": 3.723, "n_samples": 89354, "proc_s": 4.5552, "rtf": 1.2235, "samples_sha256": "0d8a24b0ebd11b4be67bc72589463800029dd5ef4e7b5831604939f9a60fc5b7"}
