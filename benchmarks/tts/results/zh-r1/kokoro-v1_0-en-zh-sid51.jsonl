{"type": "sentence", "engine": "kokoro-v1_0-en-zh-sid51", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 2.825, "n_samples": 67792, "proc_s": 0.8783, "rtf": 0.3109, "samples_sha256": "1fee3e92654d803d5af638fc5dcfe55dc471d1d65d7efe10f565a3f65da835ca"}
