{"type": "header", "engine": "kokoro-v1_1-int8-zh-sid58", "load_s": 1.18, "peak_rss_mb": 497.9, "num_sentences": 30, "decode_params": {"model": "k2-fsa/sherpa-onnx tts-models/kokoro-int8-multi-lang-v1_1.tar.bz2", "model_file": "model.int8.onnx", "lexicons": ["lexicon-us-en.txt", "lexicon-zh.txt"], "rule_fsts": ["date-zh.fst", "phone-zh.fst", "number-zh.fst"], "sid": 58, "speaker": "zm_009", "speed": 1.0, "num_threads": 4}}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s001", "text": "你好，今天的会议改到下午3点半开始。", "n_words": 1, "audio_s": 3.806, "n_samples": 91344, "proc_s": 4.717, "rtf": 1.2394, "samples_sha256": "61d3dbb22d7724071c76e8950b840414c36d740a33da1390a1e6a08aa242fb24"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s002", "text": "我刚买了一部新的iPhone，用起来很顺手。", "n_words": 1, "audio_s": 4.282, "n_samples": 102760, "proc_s": 5.9058, "rtf": 1.3793, "samples_sha256": "101ad59edfaa386c7bf6b21d5b3072b607d3835643289a3c81e0f678f0e7f41e"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s003", "text": "这件衣服打折以后只要128元。", "n_words": 1, "audio_s": 3.299, "n_samples": 79164, "proc_s": 4.1141, "rtf": 1.2473, "samples_sha256": "c9bde4baa1bdf8fb34b88f71a0e5b7329b2070222d97dcdc6550465176a419a4"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s004", "text": "我们约在2026年10月20日见面吧。", "n_words": 1, "audio_s": 3.361, "n_samples": 80670, "proc_s": 4.5018, "rtf": 1.3393, "samples_sha256": "cdd90f4f291ec4a83d94f82b408a48eed9d75b300de8f8480dd938d20ca63060"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s005", "text": "请把报告在周五之前发给我。", "n_words": 1, "audio_s": 2.756, "n_samples": 66132, "proc_s": 3.7544, "rtf": 1.3625, "samples_sha256": "473422655045856abab5bc6c38ce982f5f8e09937e5cb66a09f6b1a8f9603bef"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s006", "text": "现在的AI工具越来越好用了。", "n_words": 1, "audio_s": 3.568, "n_samples": 85636, "proc_s": 5.1387, "rtf": 1.4401, "samples_sha256": "4efe44b432957886c6eef604e8603fdf8c70658d0212fdb94996efe14c63c620"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s007", "text": "你的航班几点起飞？我记得是早上8点20分。", "n_words": 1, "audio_s": 4.72, "n_samples": 113288, "proc_s": 6.2323, "rtf": 1.3203, "samples_sha256": "3bbed22ae420a3c257f8e5ecb314b87fe0748564ff672c45ce13feae66ee71c5"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s008", "text": "这个月的电费一共是356块钱。", "n_words": 1, "audio_s": 3.382, "n_samples": 81176, "proc_s": 4.3317, "rtf": 1.2807, "samples_sha256": "a8ebd705e31bf3c6d5e2de6c708244f0048b31311a268684bb3e60deb31d54fb"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s009", "text": "我住在3楼，电梯就在门口右边。", "n_words": 1, "audio_s": 3.478, "n_samples": 83469, "proc_s": 5.0032, "rtf": 1.4386, "samples_sha256": "f3fa4b4551081e7ff181bf5d094360f49dbf70c458d5193991b8017f715bd280"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s010", "text": "他每天跑步5公里，已经坚持了两年。", "n_words": 1, "audio_s": 3.674, "n_samples": 88167, "proc_s": 5.117, "rtf": 1.3929, "samples_sha256": "2dfc680c10f59d341899659e3fba0898f0a3c625ef928c3a95c773bf48f5c7fa"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s011", "text": "下周一我们要去上海出差。", "n_words": 1, "audio_s": 2.675, "n_samples": 64201, "proc_s": 3.306, "rtf": 1.2359, "samples_sha256": "2b8ac1fe5ad2cca5aecffdfe5e70c12ef539b436b21940c75b742f87ebe473ac"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s012", "text": "你能帮我订一张明天去北京的高铁票吗？", "n_words": 1, "audio_s": 3.576, "n_samples": 85824, "proc_s": 4.5787, "rtf": 1.2804, "samples_sha256": "d3daa5e76bc85f43e281482ddc4f2067c2658fd039f82b76dad273c1029e7c49"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s013", "text": "这家餐厅的评分是4.8分，值得一试。", "n_words": 1, "audio_s": 3.885, "n_samples": 93248, "proc_s": 5.5299, "rtf": 1.4233, "samples_sha256": "5eda676297ee9ed6811d0a1d157df8854787fa523f0180d1f09751eb0efd3ae7"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s014", "text": "我的手机号是13812345678，有事打给我。", "n_words": 1, "audio_s": 4.831, "n_samples": 115935, "proc_s": 6.5636, "rtf": 1.3587, "samples_sha256": "ce8f1ae32966dc20519a4b559a0d25fa2d561836b4688468f4948e8146bc1e85"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s015", "text": "今年公司的销售额增长了15%。", "n_words": 1, "audio_s": 2.959, "n_samples": 71027, "proc_s": 4.0507, "rtf": 1.3687, "samples_sha256": "14f22a5cccdde2e4abe84a8a7ed2f324fcc384175cfe319a044a08ded7253eae"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s016", "text": "孩子们放学以后在公园里踢足球。", "n_words": 1, "audio_s": 3.038, "n_samples": 72912, "proc_s": 4.2014, "rtf": 1.3829, "samples_sha256": "8dad77ac935bb6dc9fc6a3699a67af36d3e9189148e938db5ccdd855c2b005d3"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s017", "text": "我用微信给你转了2000块，记得查收。", "n_words": 1, "audio_s": 3.591, "n_samples": 86180, "proc_s": 5.1782, "rtf": 1.4421, "samples_sha256": "ac86b4da1ae7c0475c8887ca00863b8a79545584ea943607917161e53a83cb28"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s018", "text": "天气预报说明天最高气温32度。", "n_words": 1, "audio_s": 3.192, "n_samples": 76600, "proc_s": 4.3389, "rtf": 1.3595, "samples_sha256": "f7c8c9ef9d25aaa2ff8e1dcf64f70bfad773e88388a3404dcc6a9e80eb1b12e6"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s019", "text": "请问洗手间在哪里？", "n_words": 1, "audio_s": 2.012, "n_samples": 48296, "proc_s": 2.7898, "rtf": 1.3863, "samples_sha256": "54c10a3a486dad74e72ef06e360b729e8123a501f6318be127326f5cd5312e75"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s020", "text": "我们的Zoom会议链接已经发到群里了。", "n_words": 1, "audio_s": 3.653, "n_samples": 87670, "proc_s": 5.4024, "rtf": 1.4789, "samples_sha256": "5ac818f48a0cfa4c30b126a25b78cff0afedbd74efc982225da6f26bb98e51c2"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s021", "text": "这本书我看了一半，故事特别精彩。", "n_words": 1, "audio_s": 3.583, "n_samples": 85987, "proc_s": 5.1073, "rtf": 1.4255, "samples_sha256": "429ba3cdc194ce2de79f2b8a3c1df09add55f0bab6bbc3ed504193b7985025e9"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s022", "text": "他的生日是5月4日，我们准备给他一个惊喜。", "n_words": 1, "audio_s": 4.408, "n_samples": 105781, "proc_s": 6.0249, "rtf": 1.367, "samples_sha256": "19468f5f317d9c8cf07bebe1bab6199356605a0328e9ac0c99068f643b823490"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s023", "text": "从这里打车到机场大概需要40分钟。", "n_words": 1, "audio_s": 3.545, "n_samples": 85086, "proc_s": 4.6589, "rtf": 1.3141, "samples_sha256": "ff6f78aac86a490a334bc8144ff6236d31a84e00f74f8c9737af32420c59675a"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s024", "text": "我刚下载了ChatGPT的新版本。", "n_words": 1, "audio_s": 3.779, "n_samples": 90684, "proc_s": 5.7374, "rtf": 1.5184, "samples_sha256": "ce901f30c878c48f464d7a007b2acc513e81d8c427c3d1e6c550af857f0015ec"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s025", "text": "房租每个月涨了500元，真让人头疼。", "n_words": 1, "audio_s": 3.723, "n_samples": 89353, "proc_s": 5.2692, "rtf": 1.4153, "samples_sha256": "49a35a66cb68c2a075c98954a33a1e6b8f0052f2911aab67ad039a76c19d5df3"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s026", "text": "周末你想去看电影还是去爬山？", "n_words": 1, "audio_s": 3.065, "n_samples": 73558, "proc_s": 4.1334, "rtf": 1.3486, "samples_sha256": "0557c973bd328f310d928a405ed3393389dcf388b5a1eb88273de03f28021afb"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s027", "text": "这台笔记本电脑的价格是6999元。", "n_words": 1, "audio_s": 4.278, "n_samples": 102678, "proc_s": 5.2706, "rtf": 1.232, "samples_sha256": "aa2a529c31e0c9ffd4d2105bcaceced443ecac8431f07c854258154e93d99258"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s028", "text": "医生建议我每天喝8杯水。", "n_words": 1, "audio_s": 2.678, "n_samples": 64260, "proc_s": 3.4931, "rtf": 1.3046, "samples_sha256": "7e9f9492327f617eec914781cf19eae61d739a5265bc1db8157fab93d9e2b107"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s029", "text": "我们团队一共有12个人，分成3个小组。", "n_words": 1, "audio_s": 4.058, "n_samples": 97382, "proc_s": 5.5651, "rtf": 1.3715, "samples_sha256": "2a9d6e31adb9f01901a1ef74d5d6e651d2aaaa9b77277a54094a1c273e43cbe6"}
{"type": "sentence", "engine": "kokoro-v1_1-int8-zh-sid58", "sentence_id": "s030", "text": "谢谢你的帮忙，下次我请你喝咖啡。", "n_words": 1, "audio_s": 3.477, "n_samples": 83455, "proc_s": 4.8286, "rtf": 1.3886, "samples_sha256": "61c53d78145c47110713c2f756abbe61f12c779ba3acf3eaeba1511778b204ca"}
