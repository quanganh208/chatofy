{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Chatofy mobile app (Expo): video meetings in development builds",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@chatofy/api-client": "workspace:*",
    "@chatofy/i18n": "workspace:*",
    "@chatofy/realtime-client": "workspace:*",
    "@chatofy/types": "workspace:*",
    "@chatofy/ui": "workspace:*",
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "155.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
