# The API the app signs in to and calls (port 3000, not web's).
# Android emulator: http://10.0.2.2:3000. A real device: this machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# The web app "Manage credits" opens: credits are bought on the web's account page,
# never in the app. Same rules as the API origin (port 3001 is web's dev server).
# Set it for every release build: unset, the app falls back to the emulator URL.
EXPO_PUBLIC_WEB_BASE_URL=http://10.0.2.2:3001

# Google sign-in. Leave a platform's id unset to hide "Continue with Google" there.
# Create OAuth clients in Google Cloud Console (iOS: bundle id dev.quanganh208.chatofy;
# Android: package dev.quanganh208.chatofy plus the keystore SHA-1) and list the same ids
# in the api's AUTH_GOOGLE_MOBILE_IDS. Inlined at build time: rebuild the dev client after a change.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
