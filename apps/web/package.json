{
  "name": "web",
  "version": "0.1.0",
  "description": "Chatofy web app: translator, video meetings, history",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-worklets.mjs",
    "dev": "next dev -p ${WEB_PORT:-3001}",
    "prebuild": "node scripts/copy-worklets.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "@chatofy/api-client": "workspace:*",
    "@chatofy/config": "workspace:*",
    "@chatofy/i18n": "workspace:*",
    "@chatofy/realtime-client": "workspace:*",
    "@chatofy/types": "workspace:*",
    "@chatofy/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
