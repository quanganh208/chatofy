NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# Whether this build may keep the microphone open while the translation plays.
#
# Granted by the acoustic measurement in docs/development-journey.md section 10,
# item 1 — not by the build channel, and not by a developer's judgement. Leave it
# false until that measurement has been taken on the machine this build runs on:
# the failure mode is the loudspeaker feeding the microphone so the app
# translates its own voice, in front of whoever is watching.
#
# Set explicitly rather than left blank. The safety property holds either way,
# but only a present value is guaranteed to be inlined and folded out of the
# client bundle.
NEXT_PUBLIC_FULL_DUPLEX_CLEARED=false
