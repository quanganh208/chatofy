# Chatofy web environment. Copy to .env.local and fill in the REQUIRED section.
#
# Two line forms carry meaning, the same convention the api template uses:
#
#   KEY=              unset. The feature behind it stays off.
#   # KEY=value       the default that already lives in src/config/env.ts.
#                     Uncomment ONLY to override.
#
# src/config/env.ts and src/config/server-env.ts are the authority for what is
# required and what it may hold; src/config/env-example.spec.ts keeps this file
# and those two schemas together.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# ── Server-only. Never NEXT_PUBLIC_ ──────────────────────────────────────────
# Read through src/config/server-env.ts, which is guarded by `import
# 'server-only'`. They are deliberately NOT in src/config/env.ts: that module
# parses at import time and is imported by 'use client' hooks, so a required key
# there throws in the browser and white-screens the translate page.

# Signs the session cookie.
#   openssl rand -base64 32
AUTH_SECRET=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Google sign-in on the web. Both halves or neither — the button is offered only
# when both are set, which is what Auth.js's own GET /api/auth/providers reports.
# The API needs the SAME client id in its GOOGLE_CLIENT_IDS allowlist, or it will
# reject the id_token's audience.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The public origin avatars are served from — the R2 bucket's custom domain.
#
# The API's OWN variable, shared rather than mirrored under a second name: the
# api mints avatar URLs from it and this app's CSP `img-src` authorises them, so
# two names would only be two things to keep in sync. No NEXT_PUBLIC_ prefix
# because no client code reads it — `next.config.ts` runs in Node at build time.
#
# Still BUILD-time: `headers()` is baked into the routes manifest, so changing
# this is a REBUILD, not a restart. Unset is supported — no avatar loads and
# every surface shows initials.
R2_PUBLIC_BASE_URL=

# ── Defaults (uncomment to override) ─────────────────────────────────────────

# Where this app looks for the API. Inlined at BUILD time because of the
# NEXT_PUBLIC_ prefix, so changing it in a deployment is a rebuild rather than a
# restart; docker-compose.prod.yml passes it as a build arg for that reason.
# The default keeps `next build` and local dev hermetic.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
