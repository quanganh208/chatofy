{
  // Extends WXT's generated config, which supplies the `chrome` globals, the
  // auto-imported `defineBackground` / `defineContentScript`, and the DOM libs.
  // Generated by `wxt prepare`, which runs from this package's `postinstall`.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Named for the reason given in packages/config/tsconfig/library.json,
    // which this config does not extend. `chrome` is what matters here: drop it
    // and every `chrome.*` in the background worker reads as undefined. Only
    // GLOBAL types are affected — everything else is imported and still resolves.
    "types": ["chrome", "node"],
    // Declared before any `.tsx` exists, deliberately. A file outside `include`
    // is not merely unchecked — it is invisible, so `turbo typecheck` stays
    // green over it and reports success. The popup rewrite lands hundreds of
    // lines here; the gate has to be able to see them before they arrive.
    "jsx": "react-jsx"
  },
  "include": [
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "wxt.config.ts",
    ".wxt/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".output"]
}
