{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-worklets.mjs",
    "dev": "wxt",
    "prebuild": "node scripts/copy-worklets.mjs",
    "build": "wxt build",
    "prezip": "node scripts/require-api-base-url.mjs",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"entrypoints/**/*.{ts,tsx}\" --fix",
    "clean": "rm -rf .output .wxt",
    "test:e2e": "node e2e/run.mjs",
    "verify:build": "node scripts/verify-content-script-css.mjs && node scripts/verify-mv3-csp.mjs"
  },
  "dependencies": {
    "@chatofy/realtime-client": "workspace:*",
    "@chatofy/types": "workspace:*",
    "@chatofy/ui": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.0.11",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  }
}
