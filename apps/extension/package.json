{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-worklets.mjs",
    "dev": "wxt",
    "prebuild": "node scripts/copy-worklets.mjs",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"entrypoints/**/*.ts\" --fix",
    "clean": "rm -rf .output .wxt",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@chatofy/realtime-client": "workspace:*",
    "@chatofy/types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.2",
    "playwright": "^1.62.1"
  }
}
