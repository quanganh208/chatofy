{
  "name": "extension",
  "version": "0.1.0",
  "description": "Chatofy browser extension: two-way translation inside Google Meet, Zoom web and Facebook calls",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-worklets.mjs",
    "dev": "wxt",
    "prebuild": "node scripts/copy-worklets.mjs",
    "build": "wxt build",
    "prezip": "node scripts/require-api-base-url.mjs",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"entrypoints/**/*.{ts,tsx}\" --fix",
    "clean": "rm -rf .output .wxt",
    "test:e2e": "node e2e/run.mjs",
    "verify:build": "node scripts/verify-content-script-css.mjs && node scripts/verify-mv3-csp.mjs"
  },
  "dependencies": {
    "@chatofy/realtime-client": "workspace:*",
    "@chatofy/types": "workspace:*",
    "@chatofy/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
