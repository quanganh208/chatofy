{
  // Relative extends (not "@chatofy/config/...") on purpose: knip resolves the
  // package specifier through the node_modules symlink without realpathing, so
  // base.json's "../../../tsconfig.base.json" escapes the repo. Same trick as
  // packages/api-client/tsconfig.json (vitest has the identical limitation).
  "extends": "../../packages/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Only `node` now. The specs used to rely on jest's ambient globals, which
    // had to be named here because automatic @types discovery walks
    // `node_modules/@types` from disk and pnpm fills it with symlinks — `tsc`
    // followed them, the editor's language server did not, and every `describe`
    // in a spec read as undefined while the CLI stayed green. Vitest publishes
    // no ambient globals and the specs import `describe`/`expect`/`vi` from
    // 'vitest' directly, so that whole discrepancy has nothing left to bite.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
