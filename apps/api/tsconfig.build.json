{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The base config roots at the package so `test/**` is checkable. Emit must
    // stay rooted at `src`, or `dist/main.js` becomes `dist/src/main.js` and
    // `start:prod` (`node dist/main`) plus the Docker image break silently.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "**/*.harness.ts"]
}
