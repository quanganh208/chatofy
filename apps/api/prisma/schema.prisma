// Prisma schema for the Chatofy voice translator.
//
// ONE model. `ConversationSession` and `TranscriptSegment` used to live here as
// placeholders and were dropped: nothing ever read or wrote them — no
// `prisma.conversationSession` call existed anywhere, and there is no sessions
// controller — so they were empty tables describing a persistence design the
// product does not have. Transcripts are streamed over the socket and held by
// the client; if they ever need storing, that is a schema decision to make then,
// against real requirements, rather than a table kept warm on speculation.
//
// Note the NAMES survive elsewhere and mean different things: `ConversationSession`
// is a client-side class in @chatofy/realtime-client, and `TranscriptSegment` is a
// zod contract in @chatofy/types used by the live WebSocket events. Neither was
// backed by these tables.
//
// Run `prisma migrate dev` to apply, `prisma generate` to regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  // Null for a Google-first account that never chose a password. Its presence is
  // what the Google linking policy reads to refuse a silent takeover.
  passwordHash      String?
  // Google's stable subject claim. Unique so one Google identity cannot be
  // attached to two rows.
  googleSub         String?   @unique
  // When the password behind this row last changed, stamped from the app clock
  // and ceiled to the next whole second. Every access token whose `iat` falls
  // strictly before it is refused — on HTTP, at the WebSocket upgrade, and on
  // sockets already open. Null means the password has never been reset, which is
  // every row until one is.
  //
  // Deliberately not `@updatedAt`: that flips on any write, so editing a display
  // name would sign the user out everywhere.
  passwordChangedAt DateTime?
  // The language this account's MAIL is written in.
  //
  // `User.preferredLanguage` was dropped in c9c8e6a because nothing read it and
  // nothing could write it — with the note that adding it back when a settings
  // screen exists is a migration. This is that migration, under the name the rest
  // of the system already uses.
  //
  // It is not a display setting. Which language the web UI renders in lives in a
  // cookie and needs no row; this column exists because mail is composed when no
  // browser is present to ask. The switcher writes both, so they do not drift.
  //
  // `String` with a default rather than an enum: the api validates against
  // `LOCALES` at the boundary, and an enum migration for two values that may grow
  // is more ceremony than it earns. The default is what makes this additive —
  // every existing row is valid without a backfill query.
  locale            String    @default("en")
  // The R2 object key for this account's avatar, or null for none.
  //
  // A KEY, not a URL. The public origin is configuration — moving the bucket
  // behind a different domain must not be a data migration — so the key is what
  // is durable and `toUserContract` composes the URL from it at the boundary.
  avatarKey         String?
  // When this row's avatar last changed by ANY means: the account holder set one,
  // removed one, or a Google picture was imported on first sign-in.
  //
  // Null is the only state that permits an import. A null `avatarKey` cannot carry
  // that meaning on its own — removing an avatar produces the same null as never
  // having had one, and re-importing over a deliberate removal would leave a Google
  // user no way to have no picture.
  //
  // Deliberately not `@updatedAt`, for the reason `passwordChangedAt` gives: that
  // flips on any write, so renaming an account would re-open the import.
  avatarChangedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Generated meeting minutes for one (owner, session) pair.
//
// Unlike the two speculative tables that were dropped above, this one is read
// and written: `PrismaMinutesStore` upserts it and `GET /sessions/:id/minutes`
// reads it. A row exists only once a user has run a summarization pass, and a
// regeneration overwrites it — the minutes are a view of the conversation, not a
// log of attempts.
//
// `ownerId` is a plain column, not a `User` relation: minutes are scoped by the
// authenticated caller for the IDOR guard, and the store never joins to the
// user row. Keeping it unlinked also lets the minutes table be pruned or
// migrated without touching the identity schema.
model MeetingMinutes {
  id          String              @id @default(cuid())
  // The authenticated caller who generated these minutes. Half of the unique
  // key, so a guessed sessionId under another user resolves to nothing.
  ownerId     String
  sessionId   String
  // 'pending' | 'generating' | 'ready' | 'failed' — validated as MinutesStatus
  // at the application boundary; stored as text so a new state is not a column
  // migration.
  status      String
  summary     String
  // Ordered arrays; Postgres preserves element order, which is why key points
  // and decisions need no position column the way action items do.
  keyPoints   String[]
  decisions   String[]
  actionItems MinutesActionItem[]
  // When the READY artifact was produced; null for a pending/failed row.
  generatedAt DateTime?
  // The model that produced it; null for a pending/failed row.
  model       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([ownerId, sessionId])
}

// One action item within a minutes artifact.
//
// A child table rather than a JSON column because each item carries a stable id
// the client addresses, and `position` preserves the order the model produced —
// the same reason `keyPoints`/`decisions` do not need one but a keyed relation
// does. Cascade-deleted with its parent so a regenerate (delete-then-recreate)
// leaves no orphans.
model MinutesActionItem {
  // The id the application minted for this item, stored as given (no default) so
  // it survives a round-trip to the client.
  id          String         @id
  minutesId   String
  minutes     MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  description String
  owner       String?
  dueDate     String?
  // Preserves the model's ordering across the round-trip.
  position    Int

  @@index([minutesId])
}

// One glossary term for one user: a language-symmetric pair applied to every
// translation on that user's authenticated session so domain vocabulary renders
// consistently.
//
// `ownerId` is a plain column, not a `User` relation — the same choice
// `MeetingMinutes` makes and for the same reasons: the glossary is scoped by the
// authenticated caller for the IDOR guard, the store never joins to the user
// row, and keeping it unlinked lets the glossary be pruned or migrated without
// touching the identity schema.
//
// `keepVerbatim` marks a proper noun kept unchanged rather than translated; for
// those rows `vi` and `en` are normally the same string. The (ownerId, vi, en)
// uniqueness makes re-adding the same pair a no-op rather than a silent
// duplicate that would spend two slots of the per-turn injection budget.
model GlossaryTerm {
  id           String   @id @default(cuid())
  ownerId      String
  vi           String
  en           String
  keepVerbatim Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, vi, en])
  @@index([ownerId])
}
