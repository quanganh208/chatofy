// Prisma schema — placeholder models for Chatofy voice translator
// Run `prisma migrate dev` to apply, `prisma generate` to regenerate client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  displayName       String?
  preferredLanguage String              @default("vi")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          ConversationSession[]
}

model ConversationSession {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  status    String             @default("idle")
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id          String              @id @default(cuid())
  sessionId   String
  session     ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerRole String
  direction   String
  sourceText  String
  targetText  String
  audioUrl    String?
  createdAt   DateTime            @default(now())
}
