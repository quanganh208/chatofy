# Application
NODE_ENV=development
PORT=3000

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/chatofy

# Redis (optional — used by RedisSessionStore when wired)
REDIS_URL=redis://localhost:6379

# Auth provider: none | supabase | betterauth
AUTH_PROVIDER=none

# AI realtime provider: none | openai | google
AI_REALTIME_PROVIDER=none

# ── Turn-based translate pipeline (vi↔en) ───────────────────────────────────
# Provider selection for the REST POST /translate flow.
# Speech runs locally by default — no API key, no cloud call. Switch either to
# `elevenlabs` (and set ELEVENLABS_API_KEY) to compare against the cloud path.
AI_STT_PROVIDER=local
AI_TTS_PROVIDER=local
AI_TRANSLATION_PROVIDER=gemini

# Provider API keys.
# GEMINI_API_KEY is required — translation is still cloud, so the local speech
# stack alone does not make POST /translate work offline.
# ELEVENLABS_API_KEY is only needed when a provider above is set to elevenlabs.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Default English TTS voice (ElevenLabs "Rachel").
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Local speech sidecars — start them with `pnpm dev:all` (see their READMEs for
# one-time `uv sync` + model download). Each serves both languages.
#   services/local-stt  — Zipformer (vi) + Moonshine (en) speech-to-text
#   services/local-tts  — Kokoro-82M (en) + VieNeu (vi) speech synthesis
# Default voices live in the sidecars, since a voice means a speaker id for the
# English engine and a preset name for the Vietnamese one.
LOCAL_STT_URL=http://localhost:8002
LOCAL_TTS_URL=http://localhost:8003

# CORS — comma-separated origins, or * for wildcard
CORS_ORIGIN=http://localhost:3001
