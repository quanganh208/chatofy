# Application
NODE_ENV=development
PORT=3000

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/chatofy

# Redis (optional — used by RedisSessionStore when wired)
REDIS_URL=redis://localhost:6379

# Auth provider: none | supabase | betterauth
AUTH_PROVIDER=none

# AI realtime provider: none | openai | google
AI_REALTIME_PROVIDER=none

# ── Turn-based translate pipeline (vi→en) ───────────────────────────────────
# Provider selection for the REST POST /translate flow.
AI_STT_PROVIDER=elevenlabs
AI_TTS_PROVIDER=elevenlabs
AI_TRANSLATION_PROVIDER=gemini

# Provider API keys (required to actually call POST /translate).
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Default English TTS voice (ElevenLabs "Rachel").
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Vietnamese TTS via the local VieNeu sidecar (services/vieneu-tts) for en→vi.
# Run the sidecar (see services/vieneu-tts/README.md), then point this at it.
VIENEU_TTS_URL=http://localhost:8001
VIENEU_TTS_VOICE=Phạm Tuyên

# CORS — comma-separated origins, or * for wildcard
CORS_ORIGIN=http://localhost:3001
