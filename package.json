{
  "name": "chatofy",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "docker compose up -d --wait postgres && turbo run dev",
    "dev:all": "docker compose up -d --wait && turbo run dev",
    "dev:stop": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
