 #pragma once
 #include <cmath>
+#include <vector>
 namespace pk {
+// Token ids the greedy decoder is not allowed to emit. Empty by default, so
+// decoding is bit-identical to upstream unless a caller opts in. Used to keep
+// the multilingual language-tag pieces (`<vi-VN>`, ...) out of the output: the
+// model does predict them at abrupt acoustic boundaries, and once one is fed
+// back into the prediction network the greedy loop can settle into blank for
+// every remaining frame and emit nothing more.
+inline std::vector<int>& decode_suppressed_ids() {
+    static std::vector<int> ids;
+    return ids;
+}
 // argmax over a[0..n): first index of the max (matches torch.max tie-break).
 inline int decode_argmax(const float* a, int n) {
-    int best = 0; float bv = a[0];
-    for (int i = 1; i < n; ++i) if (a[i] > bv) { bv = a[i]; best = i; }
-    return best;
+    int best = -1; float bv = 0.0f;
+    const std::vector<int>& sup = decode_suppressed_ids();
+    for (int i = 0; i < n; ++i) {
+        bool skip = false;
+        for (int s : sup) if (s == i) { skip = true; break; }
+        if (skip) continue;
+        if (best < 0 || a[i] > bv) { bv = a[i]; best = i; }
+    }
+    return best < 0 ? 0 : best;
 }
 // NeMo rescaled max_prob confidence over a[0..n) at index k:
 //   conf = (N*p_max - 1)/(N - 1), p_max = softmax(a)[k]. Stable softmax.
