@@ -71,6 +71,15 @@ Result<NoneType, std::string> AndroidAudioRecorder::openAudioStream() {
   oboe::AudioStreamBuilder builder;
   builder.setSharingMode(oboe::SharingMode::Exclusive)
       ->setDirection(oboe::Direction::Input)
+      // Chatofy: capture through the VOICE_COMMUNICATION source so the platform's
+      // echo canceller and noise suppressor run on this stream. Oboe's default
+      // preset is VoiceRecognition, which applies no effects, so a meeting peer's
+      // voice played on the loudspeaker was transcribed as the phone user's speech.
+      ->setInputPreset(oboe::InputPreset::VoiceCommunication)
+      // A session id keeps AAudio off its MMAP path, which runs no effects at all:
+      // with the preset alone the stream opened as MMAP and the canceller never
+      // attached.
+      ->setSessionId(oboe::SessionId::Allocate)
       ->setFormat(oboe::AudioFormat::Float)
       ->setFormatConversionAllowed(true)
       ->setPerformanceMode(oboe::PerformanceMode::LowLatency)
