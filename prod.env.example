# Production environment for the Docker prod stack — TEMPLATE ONLY.
# The real file lives OUTSIDE the repo at ~/.config/chatofy/prod.env (chmod 600),
# never in GitHub secrets, and every compose call passes it explicitly:
#   docker compose -f docker-compose.prod.yml --env-file ~/.config/chatofy/prod.env ...
# Deploy refuses to run while its key set differs from this file
# (scripts/check-prod-env.mjs). Sections follow .env.example, in its order.
#
#   KEY=          set it (blank means fill it in).
#   # KEY=value   optional, shown with the value it takes when unset.
#
# Compose pins PORT, DATABASE_URL, REDIS_URL, LOCAL_*_URL, TRUST_PROXY_HOPS,
# AUTH_URL and the postgres user/database per service; NODE_ENV comes from the
# images. Why each key exists: docs/environment-variables.md.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Generate fresh, never reuse the dev value.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Speech sidecars: threads per engine and concurrent STT decodes (prod shares
# cores with dev). Model dirs and this file's path default under $HOME in
# compose; override them only with ABSOLUTE paths via CHATOFY_ENV_FILE,
# STT_MODELS_DIR, TTS_MODELS_DIR.
# PROD_LOCAL_STT_THREADS=4
# PROD_LOCAL_TTS_THREADS=4
# PROD_LOCAL_STT_CONCURRENCY=4

# ── API: required ────────────────────────────────────────────────────────────
# Signs every access token; the api refuses to boot without it. Generate fresh.
#   openssl rand -base64 32
AUTH_JWT_SECRET=

# Video meetings (Cloudflare dashboard > Realtime > Serverless SFU). Meetings
# always load, so the api refuses to boot without both.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# ── API: deployment-specific ─────────────────────────────────────────────────
# The web's public origin: mailed links, og:image, CORS, and AUTH_URL via compose.
# The api refuses to boot in production while it is still the localhost default.
WEB_BASE_URL=https://chatofy.quanganh208.dev

# ── Translation and speech ───────────────────────────────────────────────────
# Translation host: commandcode needs BOTH keys below (Command Code first, the
# DeepSeek row behind it).
# AI_TRANSLATION_PROVIDER=commandcode
COMMAND_CODE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Gemini: live mode and the minutes fallback.
GEMINI_API_KEY=

# Minutes host; unset follows translation, so the default is commandcode too.
# AI_SUMMARIZATION_PROVIDER=commandcode

# Cost knobs at their defaults; `on`, `on`, 1 restore the pre-replay turn.
# TRANSLATE_SPECULATION_OVERLAP=off
# TRANSLATE_SPECULATION_HOMOPHONES=off
# TRANSLATE_LIVE_COMMIT_SCALE=3

# ── Auth (web + api) ─────────────────────────────────────────────────────────
# Signs the web's session cookie. Generate fresh.
#   openssl rand -base64 32
AUTH_SECRET=

# Google sign-in: both or neither. Register
# https://chatofy.quanganh208.dev/api/auth/callback/google on the client, and
# set both before the web image is built.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The mobile app's Google client ids (iOS and Android), comma-separated; the api
# accepts id_tokens issued to any of them as well as the web's. See docs/environment-variables.md.
# AUTH_GOOGLE_MOBILE_IDS=

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the web dials the api. BUILD time: changing it is a web rebuild.
NEXT_PUBLIC_API_BASE_URL=https://chatofy-api.quanganh208.dev

# ── Mail (Gmail SMTP) ────────────────────────────────────────────────────────
# Required: production refuses to boot without both. SMTP_PASS is a Gmail app
# password; host and port default to smtp.gmail.com:465.
SMTP_USER=
SMTP_PASS=

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# All five or none. One public-read bucket shared with dev; use a token scoped
# to it. R2_PUBLIC_BASE_URL is also baked into the web's CSP: a web rebuild.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chatofy
R2_PUBLIC_BASE_URL=https://chatofy-cdn.quanganh208.dev

# ── Video: TURN relay (optional) ─────────────────────────────────────────────
# Cloudflare dashboard > Realtime > TURN Server. On only when both are set;
# needed by UDP-blocked networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# ── Billing (optional) ───────────────────────────────────────────────────────
# Checkout is open only to these emails (comma-separated); unset means no one.
# A rail with any of its secrets missing reports itself unavailable.
# BILLING_CHECKOUT_ALLOWLIST=
# Polar: sandbox or live. Token scopes: checkouts:write, customer_sessions:write.
# Webhook: https://chatofy-api.quanganh208.dev/billing/webhooks/polar
# POLAR_MODE=sandbox
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# Plan code to product id, comma-separated, e.g. pro_monthly=<id>,topup_250=<id>
# POLAR_PRODUCT_IDS=
# SePay: sandbox is Test mode. Bank is SePay's short name (e.g. MBBank).
# Webhook (HMAC-SHA256): https://chatofy-api.quanganh208.dev/billing/webhooks/sepay
# SEPAY_MODE=sandbox
# SEPAY_WEBHOOK_SECRET=
# SEPAY_BANK_ACCOUNT=
# SEPAY_BANK=
# Must equal the payment-code prefix configured in SePay.
# SEPAY_ORDER_PREFIX=CHF
