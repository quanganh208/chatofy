# Production environment for the Docker prod stack — TEMPLATE ONLY.
#
# The real file lives OUTSIDE the repo at ~/.config/chatofy/prod.env (chmod 600),
# never in GitHub secrets, and every compose call passes it explicitly:
#   docker compose -f docker-compose.prod.yml --env-file ~/.config/chatofy/prod.env ...
# Deploy refuses to run while its key set differs from this file
# (scripts/check-prod-env.mjs). Same line forms as .env.example:
#   KEY=          set it (blank means fill it in).
#   # KEY=value   optional, shown with the value it takes when unset.
# Compose pins PORT, DATABASE_URL, REDIS_URL, LOCAL_*_URL, TRUST_PROXY_HOPS,
# AUTH_URL and the postgres user/database per service; NODE_ENV comes from the
# images. Why each key exists: docs/environment-variables.md.

# ── Origins ──────────────────────────────────────────────────────────────────
# The web's public origin: mailed links, og:image, CORS, and AUTH_URL via compose.
# The api refuses to boot in production while it is still the localhost default.
WEB_BASE_URL=https://chatofy.quanganh208.dev
# Where the web dials the api. BUILD time: changing it is a web rebuild.
NEXT_PUBLIC_API_BASE_URL=https://chatofy-api.quanganh208.dev

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# All five or none. One public-read bucket shared with dev; use a token scoped
# to it. R2_PUBLIC_BASE_URL is also baked into the web's CSP: a web rebuild.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chatofy
R2_PUBLIC_BASE_URL=https://chatofy-cdn.quanganh208.dev

# ── Secrets — generate fresh, never reuse dev values ─────────────────────────
#   openssl rand -base64 32
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
AUTH_SECRET=

# ── Mail (Gmail SMTP) ────────────────────────────────────────────────────────
# Required: production refuses to boot without both. SMTP_PASS is a Gmail app
# password; host and port default to smtp.gmail.com:465.
SMTP_USER=
SMTP_PASS=

# ── Google sign-in ───────────────────────────────────────────────────────────
# Both or neither. Register https://chatofy.quanganh208.dev/api/auth/callback/google
# on the client. Set before the web image is built.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The mobile app's Google client ids (iOS and Android), comma-separated; the api accepts
# id_tokens issued to any of them as well as the web's. See docs/environment-variables.md.
# AUTH_GOOGLE_MOBILE_IDS=

# ── AI providers ─────────────────────────────────────────────────────────────
# Translation defaults to commandcode: Command Code first, the DeepSeek row
# (OPENAI_COMPATIBLE_API_KEY) as its fallback. Both keys are required.
COMMAND_CODE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# AI_TRANSLATION_PROVIDER=commandcode

# Gemini: live mode and the minutes fallback.
GEMINI_API_KEY=

# Minutes host; unset follows translation, so the default is commandcode too.
# AI_SUMMARIZATION_PROVIDER=commandcode

# Cost knobs at their defaults; `on`, `on`, 1 restore the pre-replay turn.
# TRANSLATE_SPECULATION_OVERLAP=off
# TRANSLATE_SPECULATION_HOMOPHONES=off
# TRANSLATE_LIVE_COMMIT_SCALE=3

# ── Speech sidecars ──────────────────────────────────────────────────────────
# Threads per engine and concurrent STT decodes (prod shares cores with dev).
# Model dirs and this file's path default under $HOME in compose; override them
# only with ABSOLUTE paths via CHATOFY_ENV_FILE, STT_MODELS_DIR, TTS_MODELS_DIR.
# PROD_LOCAL_STT_THREADS=4
# PROD_LOCAL_TTS_THREADS=4
# PROD_LOCAL_STT_CONCURRENCY=4

# ── Video meetings (Cloudflare Realtime) ─────────────────────────────────────
# Required: the api refuses to boot without the SFU app id and secret.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
# TURN relay for UDP-blocked networks. On only when both are set.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
