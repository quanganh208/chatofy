# Production environment for the Docker prod stack — TEMPLATE ONLY.
#
# The real file lives OUTSIDE this repository, at:
#   ~/.config/chatofy/prod.env   (chmod 600)
#
# It is deliberately not in the repo and deliberately not in GitHub Actions
# secrets. The deploy target is the same machine that runs the workflow, so
# routing these values through GitHub would add exposure (workflow logs, GitHub
# itself) and buy nothing. This template exists so the KEY LIST stays reviewable
# in version control even though the values never are.
#
# Every compose invocation must pass it explicitly:
#   docker compose -f docker-compose.prod.yml --env-file ~/.config/chatofy/prod.env ...
#
# Note on this filename: .gitignore's `.env.*` rule matches `.env.prod` but NOT
# `prod.env` or `prod.env.example` — patterns only match basenames beginning
# `.env`. That cuts both ways. This template is committable with no negation
# needed, and a file named `prod.env` holding REAL credentials would sit in the
# tree fully stageable. Keep real values out of the repo entirely.

# ── Forced values ────────────────────────────────────────────────────────────
# Not preferences. Each one is required to be exactly this, for a reason.

# The env schema is a strict enum of development|production|test — there is no
# `staging`. Anything but `production` here also flips the web CSP onto its
# dev branch, which permits 'unsafe-eval'.
NODE_ENV=production

# The API refuses to boot in production while this is still the default
# (http://localhost:3001). Every verification and password-reset link is built
# from it, and a plausible-looking wrong origin is worse than an obviously
# broken one.
WEB_BASE_URL=https://chatofy.quanganh208.dev

# The exact origin, never `*`. main.ts enables credentials mode only when this
# is not the wildcard.
CORS_ORIGIN=https://chatofy.quanganh208.dev

# Read at BUILD time by the web image, not at run time — Next inlines it and
# next.config.ts derives the CSP connect-src from it, including the wss://
# origin. Changing it is a rebuild, never a restart. Sibling hostname rather
# than api.chatofy.*: Cloudflare Universal SSL covers the apex plus one label
# only, so a two-label name has no certificate on the free plan.
NEXT_PUBLIC_API_BASE_URL=https://chatofy-api.quanganh208.dev
NEXT_PUBLIC_ENV=production

# How many proxies sit in front of the API. PROVISIONAL until Phase 3 measures
# it through the tunnel by comparing what Express resolves as the client address
# against the CF-Connecting-IP header. Getting this wrong fails SILENTLY: every
# request appears to come from one address, so the per-IP auth rate limit
# becomes a single shared bucket one attacker can exhaust for everybody.
TRUST_PROXY_HOPS=1

# ── Secrets — generate fresh, never reuse the dev values ─────────────────────
#   openssl rand -base64 32
# Postgres reads POSTGRES_* only when initialising an EMPTY data directory.
# Changing the password against an existing volume silently does nothing and the
# healthcheck then fails; run `down -v` first.
POSTGRES_USER=chatofy
POSTGRES_PASSWORD=
POSTGRES_DB=chatofy
AUTH_JWT_SECRET=
AUTH_SECRET=

# The canonical public origin Auth.js builds OAuth callbacks from.
#
# REQUIRED, and `trustHost: true` does NOT remove the need for it. The web
# container sets HOSTNAME=0.0.0.0 and PORT=3001 so the standalone server binds
# every interface, and Auth.js derived its callback from those — sending Google
# `redirect_uri=https://0.0.0.0:3001/api/auth/callback/google`.
#
# Google rejects that as an OAuth policy violation (400 invalid_request), NOT as
# a redirect_uri mismatch, which is what makes it confusing: the Cloud Console
# shows the correct URIs and sign-in still fails.
#
# Runtime value, not build-time: changing it needs a web restart, not a rebuild.
AUTH_URL=https://chatofy.quanganh208.dev

# ── Mail — LEAVE COMMENTED until you have real values ───────────────────────
# In dev, mail works precisely BECAUSE SMTP is unset: the console sender prints
# verify/reset links to stdout whenever NODE_ENV is development or test. In
# production the app wants real SMTP instead.
#
# Blank and missing are now the SAME thing, and both refuse to boot.
#
# That was not always true. Measured against a real deployment: keys present but
# EMPTY used to start the app cleanly, log no warning, and bind a real SMTP
# sender holding blank credentials — so every mail failed at Gmail and the first
# person to notice was a user whose link never arrived. Fixed in
# apps/api/src/modules/mail/mail.module.ts (`configured`), with regression tests.
#
# Leaving them commented is still the tidier default, but it is no longer what
# protects you. Uncomment all four together, once filled.
# SMTP_USER wants a Gmail APP password (requires 2FA on that account; ordinary
# passwords are rejected). MAIL_FROM is optional — Gmail rewrites the From
# header to the authenticated address regardless.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# ── Google sign-in ───────────────────────────────────────────────────────────
# The DEV client is reused here on purpose. A separate production client is not
# required by anything: one Google client carries several authorised redirect
# URIs, and GOOGLE_CLIENT_IDS below is a comma-separated ALLOWLIST, so moving to
# a dedicated prod client later means adding a second id, not a migration.
#
# The one hard requirement is the redirect URI. Google matches it exactly and
# Auth.js does not override basePath, so this must be registered on the client
# or sign-in fails with redirect_uri_mismatch:
#
#   https://chatofy.quanganh208.dev/api/auth/callback/google
#
# Both web halves or neither — the button is offered only when both are set. The
# SAME client id must also appear in GOOGLE_CLIENT_IDS, or the API rejects the
# id_token's audience.
#
# Set these BEFORE the web image is built if you want Google login: the config
# module evaluates at load time, so enabling it afterwards likely needs a
# rebuild rather than a restart.
#
# The trade-off accepted by reusing: a leaked dev client secret is also a leaked
# prod one. Judged acceptable for a private, single-developer project; revisit if
# that changes.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_IDS=

# ── AI providers ─────────────────────────────────────────────────────────────
# Speech runs locally in the sidecars; translation is still cloud Gemini.
# Reusing the dev key is fine, but note Gemini meters quota per PROJECT — a key
# from the same project shares one bucket with dev.
GEMINI_API_KEY=
AI_STT_PROVIDER=local
AI_TTS_PROVIDER=local
AI_TRANSLATION_PROVIDER=gemini

# ── Paths — must be ABSOLUTE ────────────────────────────────────────────────
# services/local-*/models is gitignored with zero tracked files, so a RELATIVE
# path resolves against whatever directory compose runs in. Under the CD
# runner's own checkout that is an empty directory, and the sidecars would come
# up with no weights at all. Compose does not expand `~` in an env_file
# attribute either, so spell the home directory out.
CHATOFY_ENV_FILE=/home/youruser/.config/chatofy/prod.env
STT_MODELS_DIR=/home/youruser/chatofy/models/stt
TTS_MODELS_DIR=/home/youruser/chatofy/models/tts

# Optional: CPU threads per speech engine in the PROD sidecars. Defaults to 4,
# half of dev's 8, because both stacks share the same 16 cores.
# PROD_LOCAL_STT_THREADS=4
# PROD_LOCAL_TTS_THREADS=4
