# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next
out
dist
bin

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager (lockfiles from other PMs — keep pnpm-lock.yaml tracked)
package-lock.json
yarn.lock

# semantic-release
.nyc_output

# env files (commit only .env.example)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter (legacy — project uses RN)
.dart_tool
GoogleService-Info.plist

repomix-output.xml
.serena/cache
screenshots/*
docs/screenshots/*
logs.txt
__pycache__

# Agent meta commands
prompt.md

# Local-only state inside tracked agent-kit source
.claude/agent-memory/
.claude/hooks/.logs/
.claude/session-state/
.claude/settings.bak.json
.agentkit/.lock

# Gemini CLI settings
.gemini/settings.json

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# Generated OpenCode backup
.opencode.backup/

# Turborepo
.turbo

# pnpm store
.pnpm-store

# Expo
.expo
.expo-shared

# Local env overrides
.env.local
.env.*.local

# Realtime harness artifacts — regenerate with benchmarks/realtime/generate-fixtures.mjs
# Globbed, not anchored: the api writes its metrics sink relative to its own cwd,
# so a run started from apps/ lands the turns log outside the harness directory.
**/benchmarks/realtime/fixtures/
**/benchmarks/realtime/*.jsonl

# Live-translate harness artifacts — regenerate with build-fixtures.mjs / run-arms.mjs.
# The corpora are not ours to redistribute: VIVOS is CC BY-NC-SA 4.0, measurement
# use only. `results/` also holds every translated clip both arms produced.
**/benchmarks/live-translate/data/
**/benchmarks/live-translate/results/
**/benchmarks/live-translate/.venv/
