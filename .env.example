# Monorepo-level environment variables
# Per-app environment variables are defined in each app's directory (apps/<name>/.env.example)
#
# Copy this file to .env.local and fill in values as needed.

# Example: shared secrets or feature flags that span multiple apps
# SOME_SHARED_VAR=

# AI provider API keys for the translate pipeline live in apps/api/.env
# (see apps/api/.env.example): ELEVENLABS_API_KEY, GEMINI_API_KEY.

# ── Docker Compose overrides ──────────────────────────────────────────────────
# The only variables read by docker-compose.yml. Override them in a root-level
# .env file (not committed to git). Every one of them has a working default, so
# `docker compose up -d` needs no root .env at all.
#
# Postgres reads user and database name only when it initialises an empty data
# directory, so changing them against an existing volume silently does nothing
# and the healthcheck then fails. Run `docker compose down -v` first.
POSTGRES_USER=chatofy
POSTGRES_PASSWORD=chatofy
POSTGRES_DB=chatofy

# The API's own connection strings are NOT read here — compose does not use
# them. Set DATABASE_URL in apps/api/.env (see apps/api/.env.example), and keep
# it in sync with the three values above.

# Host ports the dev stack binds on 127.0.0.1. The defaults are what every doc
# and .env.example assumes, so leave them alone for a normal checkout.
#
# Change them when a SECOND checkout has to run at the same time — a git
# worktree. Compose scopes containers and volumes by project name, which
# defaults to the directory name, so a worktree is already isolated there; the
# host ports are the one resource both stacks would fight over. Give the
# worktree its own values here and mirror them in that worktree's
# apps/api/.env (DATABASE_URL, LOCAL_STT_URL, LOCAL_TTS_URL), or the API will
# talk to the other stack.
POSTGRES_PORT=5432
LOCAL_STT_PORT=8002
LOCAL_TTS_PORT=8003

# CPU threads per speech engine in the sidecar containers. 8 (the physical core
# count on the machine these were measured on) beat 16 hyperthreads; lower it on
# a smaller host.
LOCAL_STT_THREADS=8
LOCAL_TTS_THREADS=8
