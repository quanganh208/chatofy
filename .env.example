# Chatofy dev environment — the ONE env file for local development.
# Copy to `.env` here at the repo root. Read by Docker Compose, the api, the web,
# prisma and the benchmarks; apps/mobile and apps/extension keep their own .env.
# Never create apps/api/.env or apps/web/.env*: nothing reads the first, and the
# second makes Next reload env from apps/web and drop every key below.
#
#   KEY=          unset (fill it in, or leave the feature off).
#   # KEY=value   the default already applied; uncomment only to override.
#
# Why each key exists and how it can bite: docs/environment-variables.md.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Postgres reads these only when it creates an EMPTY volume: change them only
# after `docker compose down -v`, and keep DATABASE_URL below in step.
# POSTGRES_USER=chatofy
# POSTGRES_PASSWORD=chatofy
# POSTGRES_DB=chatofy

# Host ports. Change them only for a second checkout (a git worktree) running
# its own stack, and mirror them in DATABASE_URL, REDIS_URL and LOCAL_*_URL.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# LOCAL_STT_PORT=8002
# LOCAL_TTS_PORT=8003

# Speech sidecars: CPU threads per engine, STT decodes at once, and language
# identification (off skips a ~280 MB download and refuses `candidates`).
# LOCAL_STT_THREADS=8
# LOCAL_TTS_THREADS=8
# LOCAL_STT_CONCURRENCY=4
# LOCAL_STT_LID=on

# ── API: required ────────────────────────────────────────────────────────────
# Matches the Compose defaults above, so it works with no edit.
DATABASE_URL=postgresql://chatofy:chatofy@localhost:5432/chatofy

# Signs every access token; the api refuses to boot without it.
#   openssl rand -base64 32
AUTH_JWT_SECRET=

# Video meetings (Cloudflare dashboard > Realtime > Serverless SFU). Meetings
# always load, so the api refuses to boot without both.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# ── API: deployment-specific ─────────────────────────────────────────────────
# The web's public origin: mailed links, og:image and Auth.js. Read by api and web.
# WEB_BASE_URL=http://localhost:3001

# Extra CORS origins (comma-separated, or *). Unset allows WEB_BASE_URL only.
# CORS_ORIGIN=

# Reverse proxies in front of the api. A count, never `true`; see the docs.
# TRUST_PROXY_HOPS=0

# Refresh-token families. The api boots without Redis; sign-in answers 503.
# REDIS_URL=redis://localhost:6379

# ── Translation and speech ───────────────────────────────────────────────────
# Translation host: commandcode needs BOTH keys below (Command Code first, the
# DeepSeek row behind it). Holding only OPENAI_COMPATIBLE_API_KEY? Set deepseek.
# AI_TRANSLATION_PROVIDER=commandcode
COMMAND_CODE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Gemini: live mode and the minutes fallback. Several keys, comma-separated,
# only help when each comes from a different Google Cloud project.
GEMINI_API_KEY=

# Minutes host; unset follows translation, so the default is commandcode too.
# AI_SUMMARIZATION_PROVIDER=commandcode

# Speech always runs in the self-hosted sidecars (`pnpm dev:all`).
# LOCAL_STT_URL=http://localhost:8002
# LOCAL_TTS_URL=http://localhost:8003

# Benchmarks only: the ElevenLabs Scribe reference used to grade conversation
# quality. The api never reads it.
ELEVENLABS_API_KEY=

# Cost knobs at their defaults; `on`, `on`, 1 restore the pre-replay turn.
# TRANSLATE_SPECULATION_OVERLAP=off
# TRANSLATE_SPECULATION_HOMOPHONES=off
# TRANSLATE_LIVE_COMMIT_SCALE=3

# ── Auth (web + api) ─────────────────────────────────────────────────────────
# Signs the web's session cookie.
#   openssl rand -base64 32
AUTH_SECRET=

# Google sign-in: both or neither. The api accepts id_tokens for this client id.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The mobile app's Google client ids (iOS and Android), comma-separated; the api
# accepts id_tokens issued to any of them as well as the web's. See docs/environment-variables.md.
# AUTH_GOOGLE_MOBILE_IDS=

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the web dials the api. Inlined at build time.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Mail (Gmail SMTP) ────────────────────────────────────────────────────────
# Ignored in development and test, where links print to the api console.
# SMTP_PASS is a Gmail app password. From falls back to SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# All five or none: a partial set answers 409 on avatar upload. The bucket is
# public-read; R2_PUBLIC_BASE_URL is its custom domain, also the web's CSP img-src.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Video: TURN relay (optional) ─────────────────────────────────────────────
# Cloudflare dashboard > Realtime > TURN Server. On only when both are set.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# ── Runtime shape ────────────────────────────────────────────────────────────
# Set by the images and compose files; a dev copy has no reason to change them.
# NODE_ENV=development
# PORT=3000

# ── Tooling (not read by the apps) ───────────────────────────────────────────
# A SEPARATE, disposable database for `prisma migrate diff`, which wipes it.
#   docker compose exec postgres psql -U chatofy -d postgres -c 'CREATE DATABASE chatofy_shadow'
SHADOW_DATABASE_URL=

# Hugging Face token for gated model and corpus downloads.
HF_TOKEN=

# The translation judge (benchmarks/translation-judge).
ANTHROPIC_API_KEY=
