{
  // TypeScript — use workspace install, not VS Code's bundled version.
  // "tsdk" only names the path; VS Code keeps running its own TypeScript until
  // someone picks "Use Workspace Version", so the prompt is what actually makes
  // the choice happen. Without it the editor silently type-checks against a
  // different compiler than `pnpm typecheck` does.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Formatting
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,

  // ESLint — fix on save; each app/package has its own config
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [{ "pattern": "apps/*" }, { "pattern": "packages/*" }],

  // Imports
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // Hide build/cache artifacts from the file explorer
  "files.exclude": {
    "**/.turbo": true,
    "**/dist": true,
    "**/.next": true,
    "**/.expo": true
  }
}
